<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.AssemblyWriteOffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сборка / списание из ячейки"
        Height="720" Width="1120"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FD"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#17213A" />
    </Window.Resources>

    <DockPanel Margin="14" LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Сборка / списание из ячейки"
                           Foreground="{StaticResource HeadingBrush}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="Выберите ячейку и позицию, укажите количество, основание и причину. Проведение атомарно списывает товар и создаёт WMS-документ."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11.5"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0" />
                <Button Grid.Column="1"
                        Content="Закрыть"
                        Height="34"
                        Padding="18,0"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="OnCloseClicked" />
                <Button x:Name="WriteOffButton"
                        Grid.Column="2"
                        Content="✓ Списать по сборке"
                        Height="34"
                        Padding="20,0"
                        Margin="10,0,0,0"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="OnWriteOffClicked" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,8,0">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Ячейка:"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Border Grid.Column="1"
                                Height="36"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="#FAFBFD"
                                Padding="10,0">
                            <TextBlock x:Name="SelectedCellText"
                                       Text="— не выбрана —"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Button x:Name="PickCellButton"
                                Grid.Column="2"
                                Content="Выбрать"
                                Height="36"
                                Padding="14,0"
                                Margin="8,0,0,0"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="OnPickCellClicked" />
                    </Grid>

                    <DataGrid x:Name="CellContentGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource LineBrush}"
                              BorderBrush="{StaticResource LineBrush}"
                              BorderThickness="1"
                              RowHeight="28"
                              ColumnHeaderHeight="32"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              EnableRowVirtualization="True"
                              SelectionChanged="OnSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код" Binding="{Binding ItemCode}" Width="120" />
                            <DataGridTextColumn Header="Товар" Binding="{Binding ItemName}" Width="*" />
                            <DataGridTextColumn Header="Доступно" Binding="{Binding AvailableQuantity, StringFormat=N3}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Проведение"
                               Foreground="{StaticResource HeadingBrush}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedItemText"
                               Text="Выберите позицию слева."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,16" />

                    <TextBlock Text="Количество"
                               Foreground="{StaticResource MutedBrush}" />
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuantityBox"
                                 Grid.Column="0"
                                 Height="36"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnFormChanged" />
                        <Button Grid.Column="1"
                                Content="Всё"
                                Height="36"
                                Padding="12,0"
                                Margin="8,0,0,0"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                Click="OnAllClicked" />
                    </Grid>

                    <TextBlock Text="Основание"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBox x:Name="RelatedDocumentBox"
                             Height="36"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Margin="0,4,0,12"
                             TextChanged="OnFormChanged"
                             ToolTip="Номер заказа на перемещение, закупки или документа перемещения" />

                    <TextBlock Text="Причина"
                               Foreground="{StaticResource MutedBrush}" />
                    <ComboBox x:Name="ReasonBox"
                              Height="36"
                              Margin="0,4,0,12"
                              SelectionChanged="OnReasonChanged">
                        <ComboBoxItem Content="Сборка по заказу на перемещение" />
                        <ComboBoxItem Content="Сборка по закупке / комплектации" />
                        <ComboBoxItem Content="Сборка по перемещению" />
                        <ComboBoxItem Content="Списание после ревизии" />
                        <ComboBoxItem Content="Иная подтверждённая причина" />
                    </ComboBox>

                    <TextBlock Text="Комментарий"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBox x:Name="CommentBox"
                             MinHeight="74"
                             Padding="8"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
