<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.ReceiptDraftsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F7F9FD"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
    </UserControl.Resources>

    <DockPanel LastChildFill="True" Margin="16">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="12"
                Padding="14,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🤖 Черновики AI-приёмок"
                           FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="Распознанные накладные ждут разноски в ячейки склада. Двойной клик — открыть и принять."
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           FontSize="12" />
                <Button x:Name="RefreshButton"
                        Content="↻ Обновить"
                        Height="30" Padding="14,0"
                        Margin="20,0,0,0"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnRefreshClicked" />
                <Button x:Name="RecognizeButton"
                        Content="🤖 Распознать новую накладную"
                        Height="30" Padding="14,0"
                        Margin="10,0,0,0"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Click="OnRecognizeClicked" />
                <Button x:Name="RefreshEmbeddingsButton"
                        Content="🧠 Обновить AI каталог"
                        Height="30" Padding="14,0"
                        Margin="10,0,0,0"
                        Background="#FFFFFF"
                        BorderBrush="#C8D1FF"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Пересчитать embeddings для номенклатуры (нужно для семантического матчинга AI)"
                        Click="OnRefreshEmbeddingsClicked" />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="10"
                Padding="14,8" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12" />
        </Border>

        <!-- Grid -->
        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="12">
            <DataGrid x:Name="DraftsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource LineBrush}"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="28" ColumnHeaderHeight="32"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      FontSize="12.5"
                      MouseDoubleClick="OnDraftDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Создан"
                                        Binding="{Binding CreatedAtUtc, StringFormat='dd.MM.yyyy HH:mm'}"
                                        Width="130" />
                    <DataGridTextColumn Header="Номер" Binding="{Binding InvoiceNumber}" Width="130" />
                    <DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierName}" Width="*" />
                    <DataGridTextColumn Header="Строк"
                                        Binding="{Binding LinesCount}"
                                        Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Кол-во"
                                        Binding="{Binding TotalQuantity, StringFormat=N3}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Сумма"
                                        Binding="{Binding TotalAmount, StringFormat=N2}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Источник" Binding="{Binding SourceLabel}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
