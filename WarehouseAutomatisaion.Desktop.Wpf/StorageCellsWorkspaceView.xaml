<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.StorageCellsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F7F9FD"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#F7F9FD" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#17213A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E76F51" />
    </UserControl.Resources>

    <DockPanel LastChildFill="True" Margin="16">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Склад:" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="WarehouseFilterCombo"
                          MinWidth="220" Height="30"
                          SelectionChanged="OnFilterChanged" />

                <Button x:Name="NewCellButton"
                        Content="+ Новая ячейка"
                        Height="30" Padding="14,0" Margin="20,0,0,0"
                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold"
                        Click="OnNewCellClicked" />

                <Button x:Name="EditCellButton"
                        Content="✎ Редактировать"
                        Height="30" Padding="14,0" Margin="8,0,0,0"
                        Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Cursor="Hand"
                        IsEnabled="False"
                        Click="OnEditCellClicked" />

                <Button x:Name="DeleteCellButton"
                        Content="🗑 Удалить"
                        Height="30" Padding="14,0" Margin="8,0,0,0"
                        Background="#FFFFFF" BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1" Foreground="{StaticResource DangerBrush}"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="OnDeleteCellClicked" />

                <Button x:Name="RefreshButton"
                        Content="↻ Обновить"
                        Height="30" Padding="14,0" Margin="20,0,0,0"
                        Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Cursor="Hand"
                        Click="OnRefreshClicked" />
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,8"
                Margin="0,10,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12" />
        </Border>

        <!-- Cells DataGrid -->
        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <DataGrid x:Name="CellsDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource LineBrush}"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="28"
                      ColumnHeaderHeight="32"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      FontSize="12.5"
                      SelectionChanged="OnCellSelectionChanged"
                      MouseDoubleClick="OnCellDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="130" />
                    <DataGridTextColumn Header="Склад" Binding="{Binding WarehouseName}" Width="200" />
                    <DataGridTextColumn Header="Зона" Binding="{Binding ZoneLabel}" Width="140" />
                    <DataGridTextColumn Header="Адрес" Binding="{Binding AddressLabel}" Width="120" />
                    <DataGridTextColumn Header="Тип" Binding="{Binding CellType}" Width="100" />
                    <DataGridTextColumn Header="Capacity"
                                        Binding="{Binding Capacity, StringFormat=N2}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="100" />
                    <DataGridTextColumn Header="Комментарий" Binding="{Binding CommentText}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter Property="FontSize" Value="11.5" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
