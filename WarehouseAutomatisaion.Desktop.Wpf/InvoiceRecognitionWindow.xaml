<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.InvoiceRecognitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Распознать накладную (AI)"
        Height="780" Width="1280"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FD"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#17213A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2A9D8F" />
        <SolidColorBrush x:Key="WarnBrush" Color="#E76F51" />
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="12">

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Файл:" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />

                <TextBox x:Name="FilePathTextBox" Grid.Column="1"
                         Height="32" VerticalContentAlignment="Center" Padding="8,0"
                         BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                         IsReadOnly="True" />

                <Button x:Name="PickFileButton" Grid.Column="2"
                        Content="Выбрать..." Height="32" Padding="14,0" Margin="8,0,0,0"
                        Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Cursor="Hand"
                        Click="OnPickFileClicked" />

                <Button x:Name="RecognizeButton" Grid.Column="3"
                        Content="🤖 Распознать" Height="32" Padding="18,0" Margin="8,0,0,0"
                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold"
                        IsEnabled="False"
                        Click="OnRecognizeClicked" />
            </Grid>
        </Border>

        <!-- Bottom status + save -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />

                <Button x:Name="SaveDraftButton" Grid.Column="1"
                        Content="💾 Сохранить черновик приёмки"
                        Height="34" Padding="18,0" Margin="12,0,0,0"
                        Background="{StaticResource SuccessBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold"
                        IsEnabled="False"
                        Click="OnSaveDraftClicked" />
            </Grid>
        </Border>

        <!-- Main: image preview | results -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left: image preview -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10">
                <Grid>
                    <TextBlock x:Name="PreviewPlaceholder"
                               Text="Выберите файл накладной (JPEG / PNG)..."
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontStyle="Italic" />
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           Visibility="Collapsed"
                           StretchDirection="DownOnly" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                          HorizontalAlignment="Center" />

            <!-- Right: results -->
            <DockPanel Grid.Column="2" LastChildFill="True" Margin="0">

                <!-- Header fields -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Поставщик:"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock x:Name="SupplierNameText" Grid.Row="0" Grid.Column="1"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="ИНН:"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="12,4,0,4" />
                        <TextBlock x:Name="SupplierTaxIdText" Grid.Row="0" Grid.Column="3"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" Margin="0,4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Номер:"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock x:Name="InvoiceNumberText" Grid.Row="1" Grid.Column="1"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Дата:"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="12,4,0,4" />
                        <TextBlock x:Name="InvoiceDateText" Grid.Row="1" Grid.Column="3"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" Margin="0,4" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Итого:"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock x:Name="TotalAmountText" Grid.Row="2" Grid.Column="1"
                                   Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="НДС:"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="12,4,0,4" />
                        <TextBlock x:Name="TotalVatText" Grid.Row="2" Grid.Column="3"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" Margin="0,4" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Провайдер:"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock x:Name="ProviderInfoText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5" VerticalAlignment="Center" Margin="0,4" />
                    </Grid>
                </Border>

                <!-- Lines DataGrid -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <DataGrid x:Name="LinesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource LineBrush}"
                              BorderThickness="0"
                              Background="Transparent"
                              RowHeight="32"
                              ColumnHeaderHeight="34"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              EnableRowVirtualization="True"
                              FontSize="12.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding LineNumber}"
                                                Width="40" IsReadOnly="True" />
                            <DataGridTextColumn Header="Распознано" Binding="{Binding RecognizedName}"
                                                Width="2*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Артикул"
                                                Binding="{Binding RecognizedSku}"
                                                Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        <Setter Property="FontSize" Value="11.5" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Совпадение в каталоге"
                                                Binding="{Binding MatchSummary}"
                                                Width="2*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Кол-во"
                                                Binding="{Binding Quantity, StringFormat=N3}"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Padding" Value="0,0,8,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ед" Binding="{Binding Unit}"
                                                Width="50" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Цена"
                                                Binding="{Binding UnitPrice, StringFormat=N2}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Padding" Value="0,0,8,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Сумма"
                                                Binding="{Binding Total, StringFormat=N2}"
                                                Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Padding" Value="0,0,8,0" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </Grid>

    </DockPanel>
</Window>
