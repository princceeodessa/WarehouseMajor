<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="760"
        Height="720"
        MinWidth="720"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogFieldLabelStyle}" />
        <Style x:Key="InputStyle" TargetType="Control" BasedOn="{StaticResource DialogInputStyle}" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="HeaderTitleText"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Базовая карточка товара. Финальный дизайн редактора можно заменить позже без изменения логики."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource DialogCardStyle}"
                Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Артикул / код" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="CodeTextBox" Style="{StaticResource InputStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Наименование" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="NameTextBox" Style="{StaticResource InputStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Категория" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="CategoryTextBox" Style="{StaticResource InputStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Поставщик" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="SupplierTextBox" Style="{StaticResource InputStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Склад по умолчанию" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="WarehouseComboBox" Style="{StaticResource InputStyle}" IsEditable="True" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Статус" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="StatusComboBox" Style="{StaticResource InputStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Ед. изм." Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="UnitTextBox" Style="{StaticResource InputStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Валюта" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="CurrencyComboBox" Style="{StaticResource InputStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Text="Цена" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PriceTextBox" Style="{StaticResource InputStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Text="Штрихкод" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="BarcodeTextBox" Style="{StaticResource InputStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Комментарий" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="NotesTextBox"
                                 Style="{StaticResource DialogMultilineTextBoxStyle}"
                                 Height="82"
                                 VerticalScrollBarVisibility="Hidden" />
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
                        <TextBlock Text="Ячейки хранения" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock x:Name="CellBalancesHintText"
                                   Margin="0,0,0,8"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <DataGrid x:Name="CellBalancesGrid"
                                  Height="130"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ячейка" Binding="{Binding Cell}" Width="130" />
                                <DataGridTextColumn Header="Склад" Binding="{Binding Warehouse}" Width="150" />
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="100" />
                                <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="ValidationText"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Width="120"
                        Margin="0,0,10,0"
                        Click="HandleCancelClick" />
                <Button Content="Сохранить"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Width="150"
                        Click="HandleSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
