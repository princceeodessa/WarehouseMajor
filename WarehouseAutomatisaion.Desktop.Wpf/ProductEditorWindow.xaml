<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1400"
        Height="900"
        MinWidth="1240"
        MinHeight="780"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FC">
    <!--
        Карточка номенклатуры в стиле 1С УНФ, но в нашей синей палитре (#4F5BFF).
        Структура повторяет layout 1С: верхняя строка навигации → таб-строка → панель
        быстрых действий → двухколоночный body (форма + правая колонка с фото и ценами)
        → нижние блоки аналитики (Продажи / Динамика цен / Остатки / аккордеоны).
    -->
    <Window.Resources>
        <!-- ===== Локальные цвета карточки (наследуют общую палитру из App.xaml) ===== -->
        <SolidColorBrush x:Key="CardSurface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardOutline" Color="#E4EAF5" />
        <SolidColorBrush x:Key="CardSoftOutline" Color="#EEF2FA" />
        <SolidColorBrush x:Key="PrimaryAccent" Color="#4F5BFF" />
        <SolidColorBrush x:Key="PrimaryAccentSoft" Color="#EEF1FF" />
        <SolidColorBrush x:Key="LabelText" Color="#5C6A8A" />
        <SolidColorBrush x:Key="StrongText" Color="#17213A" />
        <SolidColorBrush x:Key="MutedText" Color="#7A86A5" />
        <SolidColorBrush x:Key="HintText" Color="#97A2BB" />
        <SolidColorBrush x:Key="PageBg" Color="#F4F7FC" />
        <SolidColorBrush x:Key="LinkText" Color="#3C49F2" />
        <SolidColorBrush x:Key="DividerSoft" Color="#EAEEF7" />
        <SolidColorBrush x:Key="FocusedFieldBorder" Color="#4F5BFF" />

        <!-- Лейблы полей слева от инпута, как в 1С: серый, выровнен по центру строки. -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource LabelText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- Инпут текста под лейблом: 28px high, тонкая рамка как в 1С. -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource StrongText}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C7D2E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FocusedFieldBorder}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource StrongText}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C7D2E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="FormMultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <!-- Маленькая кнопка с "+" справа от комбобокса (открытие справочника в 1С). -->
        <Style x:Key="FieldPickerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#F2F5FC" />
            <Setter Property="BorderBrush" Value="#C7D2E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource LabelText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E7ECFA" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#B4C2E2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-вопросик "?" в углу поля — подсказка как в 1С. -->
        <Style x:Key="FieldHelpButtonStyle" TargetType="Button" BasedOn="{StaticResource FieldPickerButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource LinkText}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Чекбокс с компактным расположением — 1С использует тонкий, как в инспекторе. -->
        <Style x:Key="CompactCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource StrongText}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0,0,0" />
        </Style>

        <!-- Карточка-контейнер: белый, чуть скруглённый, тонкая рамка. -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardOutline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>

        <!-- Текстовая ссылка-кнопка (имитирует "+ Новая цена", "+ Свой реквизит" в 1С). -->
        <Style x:Key="InlineLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource LinkText}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextDecorations="Underline" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-таб в верхней панели карточки. Имитирует 1С-style вкладки:
             текст с тонким бордером снизу. Активная — синий бордер 2px. -->
        <Style x:Key="HeaderTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource LinkText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryAccent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource HintText}" />
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Opacity" Value="0.85" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderTabActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderTabButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource StrongText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccent}" />
        </Style>

        <!-- Узкая кнопка верхнего тулбара (Save and close, Save, Продать, Купить...) -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource OneCToolbarButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OneCPrimaryToolbarButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource OneCToolbarIconButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="36" />
        </Style>

        <!-- Стиль для аккордеона (Expander) в нижней части карточки. -->
        <Style x:Key="CardExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource StrongText}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerSoft}" />
            <Setter Property="Padding" Value="0,10,0,10" />
            <Setter Property="IsExpanded" Value="False" />
        </Style>

        <!-- Заголовок секции справа от формы — "Цены", "Остатки". Зелёный, как в 1С. -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#3F9B4A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Верхняя серая полоса навигации (← → ⭐ Заголовок ✕) -->
            <RowDefinition Height="Auto" />
            <!-- Полоса табов карточки (Main, Комплектации, ...) -->
            <RowDefinition Height="Auto" />
            <!-- Тулбар (Save and close, Продать, Купить, Print, Настройка...) -->
            <RowDefinition Height="Auto" />
            <!-- Основной скроллируемый body -->
            <RowDefinition Height="*" />
            <!-- Нижний футер (Отмена / Сохранить / ошибки) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== ROW 0: верхняя строка навигации ===== -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="{StaticResource CardOutline}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Стрелки навигации по карточкам списка. Декоративные —
                     ProductsWorkspaceView не передаёт нам контекст списка,
                     поэтому сейчас disabled с tooltip-подсказкой. -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            IsEnabled="False"
                            ToolTip="Переход к предыдущей карточке (появится после привязки к списку)">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76B;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            Margin="6,0,0,0"
                            IsEnabled="False"
                            ToolTip="Переход к следующей карточке">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76C;" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- Звезда (избранное) — тоже декоративная пока что. -->
                <Button Grid.Column="1"
                        Style="{StaticResource ToolbarIconButtonStyle}"
                        Margin="12,0,0,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand"
                        ToolTip="Добавить в избранное">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE735;" FontSize="14" Foreground="#FFB400" />
                </Button>

                <!-- Длинный заголовок карточки. Берём из HeaderTitleText в code-behind. -->
                <TextBlock x:Name="HeaderTitleText"
                           Grid.Column="2"
                           Margin="14,0,14,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource StrongText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Иконки справа: ссылка (поделиться), троеточие, крестик (визуально). -->
                <StackPanel Orientation="Horizontal" Grid.Column="3">
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            Background="Transparent" BorderBrush="Transparent"
                            IsEnabled="False"
                            ToolTip="Скопировать ссылку на карточку (появится позже)">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71B;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            Background="Transparent" BorderBrush="Transparent"
                            Margin="4,0,0,0"
                            IsEnabled="False"
                            ToolTip="Дополнительные действия (появится позже)">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE712;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== ROW 1: полоса табов (Main, Комплектации, Спецификации, ...) ===== -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="{StaticResource CardOutline}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- В нашей реализации активен только Main; остальные табы — визуальные
                     заглушки 1С-layout. Когда соответствующие разделы появятся
                     (Цены, Штрихкоды, Файлы и т.д.), снять IsEnabled=False. -->
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Main" Style="{StaticResource HeaderTabActiveButtonStyle}" />
                        <Button Content="Комплектации"
                                Style="{StaticResource HeaderTabButtonStyle}"
                                IsEnabled="False"
                                ToolTip="Раздел появится в следующих релизах" />
                        <Button Content="Спецификации"
                                Style="{StaticResource HeaderTabButtonStyle}"
                                IsEnabled="False"
                                ToolTip="Раздел появится в следующих релизах" />
                        <Button Content="Штрихкоды"
                                Style="{StaticResource HeaderTabButtonStyle}"
                                IsEnabled="False"
                                ToolTip="Штрихкод доступен в основной карточке (поле «Код штрихкода»)" />
                        <Button Content="Цены"
                                Style="{StaticResource HeaderTabButtonStyle}"
                                IsEnabled="False"
                                ToolTip="Цены товара показаны на основной странице справа" />
                        <Button Content="Документы"
                                Style="{StaticResource HeaderTabButtonStyle}"
                                IsEnabled="False"
                                ToolTip="Раздел появится в следующих релизах" />
                        <Button Content="Файлы"
                                Style="{StaticResource HeaderTabButtonStyle}"
                                IsEnabled="False"
                                ToolTip="Раздел появится в следующих релизах" />
                        <Button Content="Отчёты"
                                Style="{StaticResource HeaderTabButtonStyle}"
                                IsEnabled="False"
                                ToolTip="Раздел появится в следующих релизах" />
                        <Button Content="Помощник закупок: ABC-классификация"
                                Style="{StaticResource HeaderTabButtonStyle}"
                                IsEnabled="False"
                                ToolTip="Раздел появится в следующих релизах" />
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Column="1"
                        Content="More actions ▼"
                        Style="{StaticResource HeaderTabButtonStyle}"
                        IsEnabled="False"
                        ToolTip="Дополнительные действия карточки (появятся позже)" />
            </Grid>
        </Border>

        <!-- ===== ROW 2: тулбар быстрых действий ===== -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="{StaticResource CardOutline}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Главный CTA — синий, как все наши primary-кнопки. В 1С здесь жёлтый. -->
                    <Button x:Name="SaveAndCloseButton"
                            Style="{StaticResource ToolbarPrimaryButtonStyle}"
                            Click="HandleSaveAndCloseClick"
                            ToolTip="Сохранить изменения и закрыть карточку">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74E;" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="Save and close" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="8,0,0,0"
                            Click="HandleSaveClick"
                            ToolTip="Сохранить изменения без закрытия карточки">
                        <TextBlock Text="Save" />
                    </Button>

                    <Border Width="1" Background="{StaticResource DividerSoft}" Margin="14,4" />

                    <!-- Действия «Продать» / «Купить» — заглушки с тултипами, чтобы было видно,
                         что в этом месте 1С обычно открывает мастер документа. -->
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            IsEnabled="False"
                            ToolTip="Создать документ продажи на основе товара (появится позже)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Продать" VerticalAlignment="Center" />
                            <TextBlock Text="▼" Margin="8,0,0,0" FontSize="9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Margin="8,0,0,0"
                            IsEnabled="False"
                            ToolTip="Создать документ закупки на основе товара (появится позже)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Купить" VerticalAlignment="Center" />
                            <TextBlock Text="▼" Margin="8,0,0,0" FontSize="9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            Margin="8,0,0,0"
                            IsEnabled="False"
                            ToolTip="Печать карточки (появится позже)">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE749;" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Margin="8,0,0,0"
                            IsEnabled="False"
                            ToolTip="Настройки карточки (появится позже)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="Настройка" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            IsEnabled="False"
                            ToolTip="Дополнительные действия (появятся позже)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="More actions" VerticalAlignment="Center" />
                            <TextBlock Text="▼" Margin="8,0,0,0" FontSize="9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            Margin="8,0,0,0"
                            IsEnabled="False"
                            ToolTip="Справка по карточке (появится позже)">
                        <TextBlock Text="?" FontSize="14" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== ROW 3: основное содержимое карточки ===== -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <!-- Верхняя часть: форма + правая колонка (фото + цены) -->
                    <RowDefinition Height="Auto" />
                    <!-- Нижняя аналитика: продажи / динамика цен / остатки -->
                    <RowDefinition Height="Auto" />
                    <!-- Аккордеоны -->
                    <RowDefinition Height="Auto" />
                    <!-- Чекбокс «Недействительна» -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- === Главный двухколоночный блок === -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <!-- Левая колонка — поля карточки -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <!-- Правая колонка — фото + цены -->
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- === Левая колонка: форма === -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Колонка лейблов фиксированная — поля выровнены вертикально, как в 1С. -->
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <!-- Категория -->
                                <RowDefinition Height="Auto" />
                                <!-- Тип -->
                                <RowDefinition Height="Auto" />
                                <!-- Наименование -->
                                <RowDefinition Height="Auto" />
                                <!-- Наименование для печати -->
                                <RowDefinition Height="Auto" />
                                <!-- Описание (короткое, "Любая доп информация") -->
                                <RowDefinition Height="Auto" />
                                <!-- Артикул + Код -->
                                <RowDefinition Height="Auto" />
                                <!-- В группе -->
                                <RowDefinition Height="Auto" />
                                <!-- Ед. изм. хранения -->
                                <RowDefinition Height="Auto" />
                                <!-- Габариты -->
                                <RowDefinition Height="Auto" />
                                <!-- Вес -->
                                <RowDefinition Height="Auto" />
                                <!-- Весовой -->
                                <RowDefinition Height="Auto" />
                                <!-- Запрет дробного -->
                                <RowDefinition Height="Auto" />
                                <!-- Бренд -->
                                <RowDefinition Height="Auto" />
                                <!-- Мин. продаваемое кол-во -->
                                <RowDefinition Height="Auto" />
                                <!-- Кол-во в упаковке -->
                                <RowDefinition Height="Auto" />
                                <!-- Цвет -->
                                <RowDefinition Height="Auto" />
                                <!-- Статус выгрузки -->
                                <RowDefinition Height="Auto" />
                                <!-- Длинное описание -->
                                <RowDefinition Height="Auto" />
                                <!-- + Свой реквизит -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Категория -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Категория:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CategoryComboBox"
                                          Grid.Column="0"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          IsEditable="True" />
                                <Button Grid.Column="1" Style="{StaticResource FieldPickerButtonStyle}" Content="+"
                                        IsEnabled="False"
                                        ToolTip="Выбрать категорию из справочника (появится позже)" />
                                <Button Grid.Column="2" Style="{StaticResource FieldHelpButtonStyle}" Content="?"
                                        Margin="4,0,0,0"
                                        IsEnabled="False"
                                        ToolTip="Категория используется для группировки в магазине и отчётах" />
                            </Grid>

                            <!-- Тип (Запас/Услуга/...) -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ItemTypeComboBox"
                                          Grid.Column="0"
                                          Style="{StaticResource FormComboBoxStyle}" />
                                <Button Grid.Column="1" Style="{StaticResource FieldHelpButtonStyle}" Content="?"
                                        Margin="6,0,0,0"
                                        IsEnabled="False"
                                        ToolTip="Тип номенклатуры (Запас, Услуга, Работа, Набор)" />
                            </Grid>

                            <!-- Наименование -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Наименование:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- В 1С это поле выделено жёлтой рамкой (обязательное).
                                     У нас — синяя primary-рамка вокруг при фокусе (уже в стиле). -->
                                <TextBox x:Name="NameTextBox" Style="{StaticResource FormTextBoxStyle}" />
                            </Grid>

                            <!-- Наименование для печати -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Наименование для печати:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <TextBox x:Name="NameForPrintTextBox" Grid.Row="3" Grid.Column="1"
                                     Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,10" />

                            <!-- Короткое описание -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Описание:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Border Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"
                                    BorderBrush="#C7D2E5" BorderThickness="1" Background="#FFFFFF" CornerRadius="2">
                                <TextBox x:Name="NotesTextBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="8,6"
                                         FontSize="12.5"
                                         Foreground="{StaticResource StrongText}"
                                         MinHeight="60"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>

                            <!-- Артикул + Код в одной строке -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Артикул:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ArticleTextBox" Grid.Column="0" Style="{StaticResource FormTextBoxStyle}" />
                                <TextBlock Grid.Column="2" Text="Код:" Style="{StaticResource FormLabelStyle}" />
                                <TextBox x:Name="CodeTextBox" Grid.Column="3" Style="{StaticResource FormTextBoxStyle}" />
                            </Grid>

                            <!-- В группе -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="В группе:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ParentGroupComboBox"
                                          Grid.Column="0"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          IsEditable="True" />
                                <Button Grid.Column="1" Style="{StaticResource FieldPickerButtonStyle}" Content="+"
                                        IsEnabled="False"
                                        ToolTip="Выбрать родительскую группу из иерархии (появится позже)" />
                            </Grid>

                            <!-- Ед. изм. хранения -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Ед. изм. хранения:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="7" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="UnitTextBox" Grid.Column="0" Style="{StaticResource FormTextBoxStyle}" />
                                <Button Grid.Column="1" Style="{StaticResource FieldPickerButtonStyle}"
                                        Margin="2,0,0,0"
                                        IsEnabled="False"
                                        ToolTip="История изменений единицы измерения (появится позже)">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE823;" FontSize="11" />
                                </Button>
                            </Grid>

                            <!-- Габариты ДхШхВ (см) = м³ -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Габариты ДхШхВ (см):" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="8" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WidthTextBox" Grid.Column="0" Style="{StaticResource FormTextBoxStyle}" HorizontalContentAlignment="Right" />
                                <TextBlock Grid.Column="1" Text="x" Foreground="{StaticResource MutedText}" Margin="8,0" VerticalAlignment="Center" />
                                <TextBox x:Name="HeightTextBox" Grid.Column="2" Style="{StaticResource FormTextBoxStyle}" HorizontalContentAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="x" Foreground="{StaticResource MutedText}" Margin="8,0" VerticalAlignment="Center" />
                                <TextBox x:Name="DepthTextBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" HorizontalContentAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="=" Foreground="{StaticResource MutedText}" Margin="10,0" VerticalAlignment="Center" />
                                <TextBox x:Name="VolumeTextBox" Grid.Column="6" Style="{StaticResource FormTextBoxStyle}" HorizontalContentAlignment="Right" IsReadOnly="True" Background="#F4F7FC" />
                                <TextBlock Grid.Column="7" Text="м³" Foreground="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Вес (кг) -->
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Вес (кг):" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="9" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WeightTextBox" Grid.Column="0"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         HorizontalContentAlignment="Right" />
                            </Grid>

                            <!-- Весовой -->
                            <CheckBox x:Name="IsWeightCheckBox" Grid.Row="10" Grid.Column="1"
                                      Content="Весовой" Style="{StaticResource CompactCheckBoxStyle}"
                                      Margin="0,0,0,8" />

                            <!-- Запрет дробного количества -->
                            <Grid Grid.Row="11" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ForbidFractionalCheckBox"
                                          Grid.Column="0"
                                          Content="Запрет дробного количества при подборе"
                                          Style="{StaticResource CompactCheckBoxStyle}" />
                                <Button Grid.Column="1" Style="{StaticResource FieldHelpButtonStyle}" Content="?"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        ToolTip="При подборе товара нельзя будет ввести 0.5, 1.25 и т. п." />
                            </Grid>

                            <!-- Бренд -->
                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Бренд:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="12" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="BrandComboBox"
                                          Grid.Column="0"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          IsEditable="True" />
                                <Button Grid.Column="1" Style="{StaticResource FieldPickerButtonStyle}" Content="+"
                                        IsEnabled="False"
                                        ToolTip="Добавить новый бренд (появится позже)" />
                            </Grid>

                            <!-- Минимальное продаваемое количество -->
                            <TextBlock Grid.Row="13" Grid.Column="0" Text="Минимальное продаваемое кол-во:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="13" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MinSaleQuantityTextBox" Grid.Column="0"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         HorizontalContentAlignment="Right" />
                            </Grid>

                            <!-- Количество в упаковке -->
                            <TextBlock Grid.Row="14" Grid.Column="0" Text="Количество в упаковке:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="14" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PackQuantityTextBox" Grid.Column="0"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         HorizontalContentAlignment="Right" />
                            </Grid>

                            <!-- Цвет -->
                            <TextBlock Grid.Row="15" Grid.Column="0" Text="Цвет:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="15" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ColorComboBox" Grid.Column="0"
                                          Style="{StaticResource FormComboBoxStyle}" IsEditable="True" />
                                <Button Grid.Column="1" Style="{StaticResource FieldPickerButtonStyle}" Content="+"
                                        IsEnabled="False"
                                        ToolTip="Добавить новый цвет (появится позже)" />
                            </Grid>

                            <!-- Статус выгрузки на сайт -->
                            <TextBlock Grid.Row="16" Grid.Column="0" Text="Статус выгрузки на сайт:" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,10" />
                            <Grid Grid.Row="16" Grid.Column="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SiteUploadStatusComboBox" Grid.Column="0"
                                          Style="{StaticResource FormComboBoxStyle}" />
                                <Button Grid.Column="1" Style="{StaticResource FieldPickerButtonStyle}" Content="+"
                                        IsEnabled="False"
                                        ToolTip="Добавить вариант статуса выгрузки (появится позже)" />
                            </Grid>

                            <!-- Длинное описание (для сайта/печати) -->
                            <TextBlock Grid.Row="17" Grid.Column="0" Text="Описание:" Style="{StaticResource FormLabelStyle}"
                                       Margin="0,8,12,10" VerticalAlignment="Top" />
                            <TextBox x:Name="DescriptionTextBox" Grid.Row="17" Grid.Column="1"
                                     Style="{StaticResource FormMultilineTextBoxStyle}"
                                     MinHeight="90"
                                     Margin="0,0,0,10" />

                            <!-- Свой реквизит — заглушка для расширения карточки -->
                            <Button Grid.Row="18" Grid.Column="1" Content="+ Свой реквизит"
                                    Style="{StaticResource InlineLinkButtonStyle}"
                                    IsEnabled="False"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Right"
                                    ToolTip="Добавить пользовательский реквизит к карточке (появится позже)" />
                        </Grid>
                    </Border>

                    <!-- === Правая колонка: фото + Цены === -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <!-- Фото -->
                            <RowDefinition Height="Auto" />
                            <!-- Цены -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Плейсхолдер фотографии -->
                        <Border Grid.Row="0"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="0,0,0,14"
                                Padding="0">
                            <Border Width="260" Height="260"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xEB9F;"
                                               FontSize="42"
                                               Foreground="{StaticResource HintText}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Добавить изображение"
                                               Margin="0,12,0,0"
                                               FontSize="12.5"
                                               Foreground="{StaticResource HintText}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Блок цен -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                            <StackPanel>
                                <!-- Заголовок секции «Цены» с вопросиком -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Цены" Style="{StaticResource SectionTitleStyle}" />
                                    <Button Grid.Column="1" Style="{StaticResource FieldHelpButtonStyle}" Content="?"
                                            Margin="6,0,0,0"
                                            IsEnabled="False"
                                            ToolTip="Цены товара по различным видам цен (РРЦ, Дилер, Оптовая и т. д.)" />
                                </Grid>

                                <!-- Динамически заполняемый список цен. Каждая строка — точка-цвет,
                                     название вида цен и редактируемое значение справа.
                                     Заполнение в code-behind: LoadPricesPanel(). -->
                                <StackPanel x:Name="ItemPricesPanel" />

                                <!-- + Новая цена -->
                                <Button Content="+ Новая цена"
                                        Style="{StaticResource InlineLinkButtonStyle}"
                                        Margin="0,10,0,12"
                                        IsEnabled="False"
                                        ToolTip="Создать новый вид цен (доступно в разделе «Виды цен»)" />

                                <!-- Автоматическое изменение розничной цены -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="AutoChangeRetailCheckBox"
                                              Grid.Column="0"
                                              Content="Автоматическое изменение розничной цены"
                                              Style="{StaticResource CompactCheckBoxStyle}"
                                              IsEnabled="False"
                                              ToolTip="Автопересчёт розничной цены по правилам (появится позже)" />
                                    <TextBox x:Name="AutoChangeRetailTextBox"
                                             Grid.Column="1"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             HorizontalContentAlignment="Right"
                                             IsEnabled="False" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- === Нижняя аналитика === -->
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Продажи (плейсхолдер графика) -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,14" Height="240">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Продажи" Style="{StaticResource SectionTitleStyle}" />
                                <Button Grid.Column="1" Content="за квартал"
                                        Style="{StaticResource InlineLinkButtonStyle}"
                                        Margin="10,0,0,0"
                                        IsEnabled="False"
                                        ToolTip="Сменить период (появится позже)" />
                                <Button Grid.Column="3" Style="{StaticResource ToolbarIconButtonStyle}"
                                        Background="Transparent" BorderBrush="Transparent"
                                        IsEnabled="False"
                                        ToolTip="Настройка графика (появится позже)">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="13" />
                                </Button>
                            </Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE9D2;"
                                           FontSize="36"
                                           Foreground="{StaticResource HintText}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="График продаж появится, когда у товара накопятся документы"
                                           Margin="0,10,0,0"
                                           FontSize="12.5"
                                           Foreground="{StaticResource HintText}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Динамика изменений цены (плейсхолдер) + Остатки -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="240" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Динамика изменений цены" Style="{StaticResource SectionTitleStyle}" />
                                    <Button Grid.Column="1" Content="за месяц"
                                            Style="{StaticResource InlineLinkButtonStyle}"
                                            Margin="10,0,0,0"
                                            IsEnabled="False"
                                            ToolTip="Сменить период (появится позже)" />
                                    <Button Grid.Column="3" Style="{StaticResource ToolbarIconButtonStyle}"
                                            Background="Transparent" BorderBrush="Transparent"
                                            IsEnabled="False"
                                            ToolTip="Настройка графика (появится позже)">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="13" />
                                    </Button>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xF1CB;"
                                               FontSize="36"
                                               Foreground="{StaticResource HintText}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="График появится после нескольких изменений цены"
                                               Margin="0,10,0,0"
                                               FontSize="12.5"
                                               Foreground="{StaticResource HintText}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- === Остатки + аккордеоны === -->
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Левая часть — аккордеоны учётных секций. -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18,8">
                        <StackPanel>
                            <Expander Header="Акцизы" Style="{StaticResource CardExpanderStyle}">
                                <TextBlock Text="Сведения об акцизах появятся, когда в системе будут заведены подакцизные группы."
                                           Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"
                                           FontSize="12.5" FontWeight="Normal" />
                            </Expander>
                            <Expander Style="{StaticResource CardExpanderStyle}">
                                <Expander.Header>
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold">
                                        <Run Text="Учётная информация" Foreground="{StaticResource StrongText}" />
                                        <Run Text=" (Основное направление, По средней, 22% (5%, 7% при УСН))"
                                             Foreground="{StaticResource MutedText}" FontWeight="Normal" />
                                    </TextBlock>
                                </Expander.Header>
                                <TextBlock Text="Отдельный редактор настроек учёта появится в одном из следующих релизов."
                                           Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"
                                           FontSize="12.5" FontWeight="Normal" />
                            </Expander>
                            <Expander Style="{StaticResource CardExpanderStyle}">
                                <Expander.Header>
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold">
                                        <Run Text="Закупка и производство" Foreground="{StaticResource StrongText}" />
                                        <Run Text=" (Закупка)" Foreground="{StaticResource MutedText}" FontWeight="Normal" />
                                    </TextBlock>
                                </Expander.Header>
                                <TextBlock Text="Привязка к поставщикам — на основной странице карточки и в разделе «Закупки»."
                                           Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"
                                           FontSize="12.5" FontWeight="Normal" />
                            </Expander>
                            <Expander Style="{StaticResource CardExpanderStyle}">
                                <Expander.Header>
                                    <TextBlock x:Name="StorageSummaryHeader" FontSize="13.5" FontWeight="SemiBold">
                                        <Run Text="Хранение" Foreground="{StaticResource StrongText}" />
                                        <Run x:Name="StorageSummaryRun" Text="" Foreground="{StaticResource MutedText}" FontWeight="Normal" />
                                    </TextBlock>
                                </Expander.Header>
                                <TextBlock Text="Перечень складов и ячеек, где хранится товар, виден в блоке «Остатки» справа."
                                           Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"
                                           FontSize="12.5" FontWeight="Normal" />
                            </Expander>
                            <Expander Header="Прайс-лист" Style="{StaticResource CardExpanderStyle}">
                                <TextBlock Text="Управление прайс-листами — в разделе «Виды цен» и «Установка цен»."
                                           Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8"
                                           FontSize="12.5" FontWeight="Normal" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- Правая часть — Остатки -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Остатки"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0,0,0,10" />
                            <TextBlock x:Name="CellBalancesHintText"
                                       DockPanel.Dock="Top"
                                       Margin="0,0,0,8"
                                       FontSize="12.5"
                                       Foreground="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                            <DataGrid x:Name="CellBalancesGrid"
                                      MaxHeight="220"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource CardSoftOutline}"
                                      BorderThickness="1"
                                      BorderBrush="{StaticResource CardOutline}"
                                      Background="#FFFFFF"
                                      RowHeight="32"
                                      ColumnHeaderHeight="34"
                                      FontSize="12.5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Склад" Binding="{Binding Warehouse}" Width="*" />
                                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Чекбокс «Недействительна» — справа внизу. -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <CheckBox x:Name="IsInactiveCheckBox"
                              Content="Недействительна"
                              Style="{StaticResource CompactCheckBoxStyle}"
                              HorizontalAlignment="Right"
                              ToolTip="Скрыть товар из подбора, не удаляя историю операций" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ===== ROW 4: футер ===== -->
        <Border Grid.Row="4"
                Background="#FFFFFF"
                BorderBrush="{StaticResource CardOutline}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <TextBlock x:Name="ValidationText"
                           Foreground="#D92D20"
                           FontSize="12.5"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Width="120"
                            Margin="0,0,10,0"
                            Click="HandleCancelClick" />
                    <Button Content="Сохранить"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Width="150"
                            Click="HandleSaveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
