<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.StockBalancesWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F7F9FD"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#F7F9FD" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="TextBrush" Color="#17213A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
    </UserControl.Resources>

    <DockPanel LastChildFill="True" Margin="16">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">

                <TextBlock Text="Склад:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox x:Name="WarehouseFilterCombo"
                          MinWidth="220"
                          Height="30"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="WarehouseNodeId"
                          SelectionChanged="OnFilterChanged" />

                <TextBlock Text="Поиск:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="20,0,8,0" />
                <TextBox x:Name="SearchTextBox"
                         Width="240"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         BorderBrush="{StaticResource LineBrush}"
                         BorderThickness="1"
                         TextChanged="OnSearchChanged" />

                <CheckBox x:Name="OnlyPositiveCheck"
                          Content="Только &gt; 0"
                          VerticalAlignment="Center"
                          Margin="20,0,0,0"
                          IsChecked="True"
                          Checked="OnFilterChanged"
                          Unchecked="OnFilterChanged" />

                <Button x:Name="RefreshButton"
                        Content="↻ Обновить из stock_balances"
                        Height="30"
                        Padding="14,0"
                        Margin="20,0,0,0"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnRefreshClicked" />

                <Button x:Name="BootstrapLocationsButton"
                        Content="Старт WMS: UNPLACED"
                        Height="30"
                        Padding="14,0"
                        Margin="10,0,0,0"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Создать системную ячейку UNPLACED и положить туда текущие общие остатки, чтобы потом перемещать их по реальным ячейкам"
                        Click="OnBootstrapLocationsClicked" />

                <Button x:Name="RecognizeInvoiceButton"
                        Content="Распознать накладную"
                        Height="30"
                        Padding="14,0"
                        Margin="10,0,0,0"
                        Background="#4F5BFF"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Click="OnRecognizeInvoiceClicked" />
            </WrapPanel>
        </Border>

        <Border x:Name="ReadinessBanner"
                DockPanel.Dock="Top"
                Background="#FFF8E8"
                BorderBrush="#F0D58A"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock x:Name="ReadinessTitleText"
                               Text="Проверка готовности WMS"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ReadinessSubtitleText"
                               Text="Загрузка состояния..."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Реальные ячейки" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock x:Name="ReadinessCellsText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="В UNPLACED" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock x:Name="ReadinessUnplacedText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="Размещено" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock x:Name="ReadinessPlacedText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,12,0">
                    <TextBlock Text="Расхождения" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock x:Name="ReadinessMismatchText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>

                <Button Grid.Column="5"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        ToolTip="Обновить показатели готовности"
                        Click="OnRefreshReadinessClicked">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,8"
                Margin="0,10,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12" />
        </Border>

        <!-- Grid -->
        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <DataGrid x:Name="StockDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource LineBrush}"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="26"
                      ColumnHeaderHeight="32"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      FontSize="12.5"
                      MouseDoubleClick="OnStockRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Код" Binding="{Binding ItemCode}" Width="120" />
                    <DataGridTextColumn Header="Товар" Binding="{Binding ItemName}" Width="*" />
                    <DataGridTextColumn Header="Склад" Binding="{Binding WarehouseName}" Width="220" />
                    <DataGridTextColumn Header="Кол-во"
                                        Binding="{Binding Quantity, StringFormat=N4}"
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Резерв"
                                        Binding="{Binding ReservedQuantity, StringFormat=N4}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Доступно"
                                        Binding="{Binding AvailableQuantity, StringFormat=N4}"
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Последнее движение"
                                        Binding="{Binding LastMovementAtUtc, StringFormat='dd.MM.yyyy HH:mm'}"
                                        Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
