<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.SalesCustomerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиент"
        Width="1120"
        Height="800"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FC">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogFieldLabelStyle}" />
        <Style x:Key="InputStyle" TargetType="Control" BasedOn="{StaticResource DialogInputStyle}" />
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17213A" />
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#6E7B98" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E7ECF7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>

        <SolidColorBrush x:Key="EventDotSuccessBrush" Color="#1AA65F" />
        <SolidColorBrush x:Key="EventDotErrorBrush" Color="#FF3045" />

        <Style x:Key="TabIconBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#F3F6FF" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="TabIconGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="#4F5BFF" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeroValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17213A" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MonoAccountStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17213A" />
        </Style>

        <Style x:Key="EventCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E7ECF7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="EventDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="0,6,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="EventTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17213A" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="EventDetailStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#6E7B98" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="EventMetaStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#7A86A5" />
        </Style>
        <Style x:Key="StatusPillBaseStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="StatusPillTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ChecklistBulletBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="ChecklistBulletGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChecklistRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="BorderBrush" Value="#EEF1F8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="ChecklistLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#6E7B98" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChecklistValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17213A" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ChecklistValueEmptyStyle" TargetType="TextBlock" BasedOn="{StaticResource ChecklistValueStyle}">
            <Setter Property="Foreground" Value="#A9B7F7" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style TargetType="DataGrid" BasedOn="{StaticResource DialogDataGridStyle}">
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DialogDataGridHeaderStyle}" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="HeaderTitleText"
                       Text="Новый клиент"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#17213A" />
            <TextBlock x:Name="HeaderSubtitleText"
                       Text="Карточка контрагента: реквизиты, контакты, классификация и документы."
                       Margin="0,6,0,0"
                       FontSize="13.5"
                       Foreground="#6E7B98" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource DialogCardStyle}"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Margin="0,0,0,14">
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Мы должны" Style="{StaticResource SectionHintStyle}" />
                            <TextBlock x:Name="CustomerDebtText" Margin="0,7,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#17213A" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Продажи" Style="{StaticResource SectionHintStyle}" />
                            <TextBlock x:Name="CustomerSalesText" Margin="0,7,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#17213A" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Последняя продажа" Style="{StaticResource SectionHintStyle}" />
                            <TextBlock x:Name="CustomerLastSaleText" Margin="0,7,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#17213A" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <TabControl Grid.Row="1">
                    <TabItem Header="Основное">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.08*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DialogCardStyle}" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="О контрагенте" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Тип и роли влияют на набор реквизитов и отчетность." Margin="0,4,0,14" Style="{StaticResource SectionHintStyle}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="Внутренний код" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="CodeTextBox"
                                                         Style="{StaticResource InputStyle}"
                                                         IsReadOnly="True"
                                                         ToolTip="Служебный код карточки контрагента." />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="Тип контрагента" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox x:Name="CounterpartyTypeComboBox" Style="{StaticResource InputStyle}" SelectionChanged="HandleCounterpartyTypeChanged" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                                <TextBlock Text="Название" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="NameTextBox" Style="{StaticResource InputStyle}" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                                <TextBlock Text="Роли" Style="{StaticResource FieldLabelStyle}" />
                                                <WrapPanel Margin="0,4,0,0">
                                                    <CheckBox x:Name="BuyerCheckBox" Content="Покупатель" Margin="0,0,16,8" />
                                                    <CheckBox x:Name="SupplierCheckBox" Content="Поставщик" Margin="0,0,16,8" />
                                                    <CheckBox x:Name="OtherRoleCheckBox" Content="Прочие" Margin="0,0,16,8" />
                                                </WrapPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,4,0,0">
                                                <TextBlock Text="Статус" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox x:Name="StatusComboBox" Style="{StaticResource InputStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,4,0,0">
                                                <TextBlock Text="Валюта" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox x:Name="CurrencyComboBox" Style="{StaticResource InputStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DialogCardStyle}" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Классификация" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Регион и город работают как будущая структура папок покупателей." Margin="0,4,0,14" Style="{StaticResource SectionHintStyle}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="Регион / республика / край" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox x:Name="RegionComboBox" Style="{StaticResource InputStyle}" IsEditable="True" SelectionChanged="HandleRegionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="Город" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox x:Name="CityComboBox" Style="{StaticResource InputStyle}" IsEditable="True" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="Источник" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox x:Name="SourceComboBox" Style="{StaticResource InputStyle}" IsEditable="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="Ответственный" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox x:Name="ResponsibleComboBox" Style="{StaticResource InputStyle}" IsEditable="True" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                                <TextBlock Text="Теги" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="TagsTextBox" Style="{StaticResource InputStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogCardStyle}" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock x:Name="LegalDetailsTitleText" Text="Юридические данные" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Набор полей меняется от типа контрагента." Margin="0,4,0,14" Style="{StaticResource SectionHintStyle}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="ИНН" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="InnTextBox" Style="{StaticResource InputStyle}" />
                                            </StackPanel>
                                            <StackPanel x:Name="KppPanel" Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="КПП" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="KppTextBox" Style="{StaticResource InputStyle}" />
                                            </StackPanel>

                                            <StackPanel x:Name="OgrnPanel" Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock x:Name="OgrnLabelText" Text="ОГРН" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="OgrnTextBox" Style="{StaticResource InputStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                                <TextBlock Text="Договор" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="ContractTextBox" Style="{StaticResource InputStyle}" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                                <TextBlock Text="Юр. адрес" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="LegalAddressTextBox" Style="{StaticResource InputStyle}" Margin="0,0,0,10" />
                                                <TextBlock Text="Факт. адрес" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="ActualAddressTextBox" Style="{StaticResource InputStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DialogCardStyle}" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Контакты" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="Можно вести несколько телефонов, e-mail и контактных лиц." Margin="0,4,0,0" Style="{StaticResource SectionHintStyle}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="+ контакт" Style="{StaticResource DialogSecondaryButtonStyle}" Width="108" Margin="0,0,8,0" Click="HandleAddContactClick" />
                                                <Button Content="Удалить" Style="{StaticResource DialogSecondaryButtonStyle}" Width="98" Click="HandleRemoveContactClick" />
                                            </StackPanel>
                                        </Grid>

                                        <DataGrid x:Name="ContactsGrid"
                                                  Grid.Row="1"
                                                  MinHeight="220"
                                                  IsReadOnly="False"
                                                  CanUserAddRows="False"
                                                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Имя" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
                                                <DataGridTextColumn Header="Роль" Binding="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Width="1*" />
                                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Width="1*" />
                                                <DataGridTextColumn Header="E-mail" Binding="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource DialogCardStyle}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Основные контакты" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="Эти поля остаются для быстрых списков и старой совместимости." Margin="0,4,0,14" Style="{StaticResource SectionHintStyle}" />
                                            <TextBlock Text="Телефон" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="PhoneTextBox" Style="{StaticResource InputStyle}" Margin="0,0,0,10" />
                                            <TextBlock Text="E-mail" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="EmailTextBox" Style="{StaticResource InputStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Заметка о клиенте" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="Источник, теги и заметка помогают быстро понять историю отношений." Margin="0,4,0,14" Style="{StaticResource SectionHintStyle}" />
                                            <TextBox x:Name="NotesTextBox"
                                                     Style="{StaticResource DialogMultilineTextBoxStyle}"
                                                     Height="126"
                                                     VerticalScrollBarVisibility="Hidden" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Документы">
                        <Grid Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="DocumentsSummaryText" Style="{StaticResource SectionHintStyle}" Margin="4,0,0,12" />
                            <DataGrid x:Name="DocumentsGrid" Grid.Row="1" IsReadOnly="True" MinHeight="360">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Раздел" Binding="{Binding Section}" Width="1*" />
                                    <DataGridTextColumn Header="Документ" Binding="{Binding Number}" Width="1.1*" />
                                    <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="0.8*" />
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="1*" />
                                    <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="1*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Договоры">
                        <Grid Margin="0,16,0,0">
                            <Border x:Name="ContractFilledPanel" Style="{StaticResource DialogCardStyle}" Padding="20" HorizontalAlignment="Left" MinWidth="480" MaxWidth="640" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource TabIconBoxStyle}" Margin="0,0,16,0">
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource TabIconGlyphStyle}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Основной договор" Style="{StaticResource SectionHintStyle}" />
                                        <TextBlock x:Name="ContractValueText" Margin="0,4,0,10" Style="{StaticResource HeroValueStyle}" />
                                        <TextBlock Text="Используется в заказах, счетах и отгрузках. Изменить — на вкладке «Основное» (поле «Договор»)." Style="{StaticResource SectionHintStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="ContractEmptyPanel" Style="{StaticResource TableEmptyOverlayStyle}" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40">
                                    <Border Style="{StaticResource TableEmptyIconBoxStyle}">
                                        <TextBlock Text="&#xE7BF;" Style="{StaticResource TableEmptyIconTextStyle}" />
                                    </Border>
                                    <TextBlock Text="Договор не указан" Style="{StaticResource TableEmptyTitleStyle}" />
                                    <TextBlock Text="Заполните поле «Договор» на вкладке Основное — номер появится здесь." Style="{StaticResource TableEmptyHintStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Банковские счета">
                        <StackPanel Margin="0,16,0,0">
                            <Border x:Name="BankAccountFilledPanel" Style="{StaticResource DialogCardStyle}" Padding="20" HorizontalAlignment="Left" MinWidth="480" MaxWidth="640" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource TabIconBoxStyle}" Margin="0,0,16,0">
                                        <TextBlock Text="&#xE8C7;" Style="{StaticResource TabIconGlyphStyle}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Расчётный счёт" Style="{StaticResource SectionHintStyle}" />
                                        <TextBlock x:Name="BankAccountFormattedText" Margin="0,4,0,10" Style="{StaticResource MonoAccountStyle}" />
                                        <TextBlock Text="Используется в платёжных документах. Редактирование — в поле ниже." Style="{StaticResource SectionHintStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="BankAccountEmptyPanel" Style="{StaticResource TableEmptyOverlayStyle}" Visibility="Collapsed" Margin="0,0,0,16">
                                <StackPanel HorizontalAlignment="Center" Margin="0,30,0,30">
                                    <Border Style="{StaticResource TableEmptyIconBoxStyle}">
                                        <TextBlock Text="&#xE8C7;" Style="{StaticResource TableEmptyIconTextStyle}" />
                                    </Border>
                                    <TextBlock Text="Счёт не указан" Style="{StaticResource TableEmptyTitleStyle}" />
                                    <TextBlock Text="Введите номер расчётного счёта в поле ниже — он появится отформатированным." Style="{StaticResource TableEmptyHintStyle}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Номер счёта" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="BankAccountTextBox" Style="{StaticResource InputStyle}" MaxWidth="640" HorizontalAlignment="Left" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="События">
                        <Grid Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Журнал событий" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="EventsSummaryText" Margin="0,4,0,0" Style="{StaticResource SectionHintStyle}" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <ScrollViewer x:Name="EventsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="EventsItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource EventCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0" Style="{StaticResource EventDotStyle}" Fill="{Binding DotBrush}" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource EventTitleStyle}" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource EventDetailStyle}" />
                                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource EventMetaStyle}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2"
                                                                Style="{StaticResource StatusPillBaseStyle}"
                                                                Background="{Binding PillBackground}">
                                                            <TextBlock Text="{Binding Result}"
                                                                       Style="{StaticResource StatusPillTextStyle}"
                                                                       Foreground="{Binding PillForeground}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border x:Name="EventsEmptyPanel" Style="{StaticResource TableEmptyOverlayStyle}" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Style="{StaticResource TableEmptyIconBoxStyle}">
                                            <TextBlock Text="&#xE7C3;" Style="{StaticResource TableEmptyIconTextStyle}" />
                                        </Border>
                                        <TextBlock Text="Журнал пуст" Style="{StaticResource TableEmptyTitleStyle}" />
                                        <TextBlock Text="Здесь появятся записи о создании, изменениях и связанных документах клиента." Style="{StaticResource TableEmptyHintStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Файлы">
                        <Grid Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Файлы" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="FilesSummaryText"
                                               Text="Файлов пока нет."
                                               Margin="0,4,0,0"
                                               Style="{StaticResource SectionHintStyle}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Загрузить"
                                            Style="{StaticResource DialogSecondaryButtonStyle}"
                                            Width="112"
                                            Margin="0,0,8,0"
                                            Click="HandleAddFileClick" />
                                    <Button Content="Открыть"
                                            Style="{StaticResource DialogSecondaryButtonStyle}"
                                            Width="104"
                                            Margin="0,0,8,0"
                                            Click="HandleOpenFileClick" />
                                    <Button Content="Убрать"
                                            Style="{StaticResource DialogSecondaryButtonStyle}"
                                            Width="96"
                                            Click="HandleRemoveFileClick" />
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="FilesGrid" Grid.Row="1" IsReadOnly="True" MinHeight="300" Margin="0,14,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="2*" />
                                    <DataGridTextColumn Header="Тип" Binding="{Binding Description}" Width="1*" />
                                    <DataGridTextColumn Header="Загружен" Binding="{Binding UploadedAtDisplay}" Width="1.1*" />
                                    <DataGridTextColumn Header="Размер" Binding="{Binding SizeDisplay}" Width="0.8*" />
                                    <DataGridTextColumn Header="Кем" Binding="{Binding UploadedBy}" Width="1*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Отчеты">
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="Документы клиента" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="ReportsSummaryText" Margin="0,4,0,14" Style="{StaticResource SectionHintStyle}" />

                            <UniformGrid Columns="5" Margin="0,0,0,12">
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource MetricIconBoxStyle}" Background="#EEF1FF" Margin="0,0,0,12">
                                            <TextBlock Text="&#xE7BF;" Style="{StaticResource MetricIconTextStyle}" Foreground="#4F5BFF" />
                                        </Border>
                                        <TextBlock x:Name="ReportsOrdersCountText" Style="{StaticResource MetricValueStyle}" Text="0" />
                                        <TextBlock Text="Заказы" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock x:Name="ReportsOrdersTotalText" Style="{StaticResource MetricHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource MetricIconBoxStyle}" Background="#FFF4E5" Margin="0,0,0,12">
                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource MetricIconTextStyle}" Foreground="#FF9F1A" />
                                        </Border>
                                        <TextBlock x:Name="ReportsInvoicesCountText" Style="{StaticResource MetricValueStyle}" Text="0" />
                                        <TextBlock Text="Счета" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock x:Name="ReportsInvoicesTotalText" Style="{StaticResource MetricHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource MetricIconBoxStyle}" Background="#E8F8EF" Margin="0,0,0,12">
                                            <TextBlock Text="&#xE8AF;" Style="{StaticResource MetricIconTextStyle}" Foreground="#1AA65F" />
                                        </Border>
                                        <TextBlock x:Name="ReportsShipmentsCountText" Style="{StaticResource MetricValueStyle}" Text="0" />
                                        <TextBlock Text="Отгрузки" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock x:Name="ReportsShipmentsTotalText" Style="{StaticResource MetricHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource MetricIconBoxStyle}" Background="#FFE8EA" Margin="0,0,0,12">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource MetricIconTextStyle}" Foreground="#FF3045" />
                                        </Border>
                                        <TextBlock x:Name="ReportsReturnsCountText" Style="{StaticResource MetricValueStyle}" Text="0" />
                                        <TextBlock Text="Возвраты" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock x:Name="ReportsReturnsTotalText" Style="{StaticResource MetricHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <Border Style="{StaticResource MetricIconBoxStyle}" Background="#F3E8FF" Margin="0,0,0,12">
                                            <TextBlock Text="&#xE8C7;" Style="{StaticResource MetricIconTextStyle}" Foreground="#7C3AED" />
                                        </Border>
                                        <TextBlock x:Name="ReportsCashCountText" Style="{StaticResource MetricValueStyle}" Text="0" />
                                        <TextBlock Text="Касса" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock x:Name="ReportsCashTotalText" Style="{StaticResource MetricHintStyle}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock x:Name="ReportsLastActivityText" Margin="2,8,0,0" Style="{StaticResource SectionHintStyle}" />

                            <Border x:Name="ReportsEmptyPanel" Style="{StaticResource TableEmptyOverlayStyle}" Visibility="Collapsed" Margin="0,16,0,0">
                                <StackPanel HorizontalAlignment="Center" Margin="0,24,0,24">
                                    <Border Style="{StaticResource TableEmptyIconBoxStyle}">
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource TableEmptyIconTextStyle}" />
                                    </Border>
                                    <TextBlock Text="Документов пока нет" Style="{StaticResource TableEmptyTitleStyle}" />
                                    <TextBlock Text="Создайте заказ, счёт или отгрузку — статистика появится здесь." Style="{StaticResource TableEmptyHintStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Персональные данные">
                        <Grid Margin="0,16,0,0">
                            <Border x:Name="PersonalDataAppliesPanel" Style="{StaticResource DialogCardStyle}" Padding="20" MaxWidth="720" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource TabIconBoxStyle}" Margin="0,0,16,0">
                                            <TextBlock Text="&#xE77B;" Style="{StaticResource TabIconGlyphStyle}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Какие данные используются" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="Перечень полей с зелёной отметкой заполнен, серые — пустые." Margin="0,4,0,0" Style="{StaticResource SectionHintStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl x:Name="PersonalDataItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ChecklistRowStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Style="{StaticResource ChecklistBulletBoxStyle}"
                                                                Background="{Binding BulletBackground}">
                                                            <TextBlock Text="{Binding BulletGlyph}"
                                                                       Style="{StaticResource ChecklistBulletGlyphStyle}"
                                                                       Foreground="{Binding BulletForeground}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource ChecklistLabelStyle}" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding DisplayValue}"
                                                                   Style="{StaticResource ChecklistValueStyle}"
                                                                   Foreground="{Binding ValueForeground}"
                                                                   FontWeight="{Binding ValueFontWeight}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border x:Name="PersonalDataNotApplicablePanel" Style="{StaticResource TableEmptyOverlayStyle}" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40">
                                    <Border Style="{StaticResource TableEmptyIconBoxStyle}">
                                        <TextBlock Text="&#xE77B;" Style="{StaticResource TableEmptyIconTextStyle}" />
                                    </Border>
                                    <TextBlock Text="Не применимо для юридических лиц" Style="{StaticResource TableEmptyTitleStyle}" />
                                    <TextBlock Text="Персональные данные хранятся в карточках контактных лиц — раздел «Контакты» на вкладке Основное." Style="{StaticResource TableEmptyHintStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="ValidationText"
                       Foreground="#D92D20"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Width="120"
                        Margin="0,0,10,0"
                        Click="HandleCancelClick" />
                <Button Content="Сохранить"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Width="150"
                        Click="HandleSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
