<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.SalesDocumentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Документ продаж"
        Width="1180"
        Height="820"
        MinWidth="960"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        WindowState="Normal"
        SizeToContent="Manual"
        ResizeMode="CanResize"
        Background="#F6F8FC">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource DialogCardStyle}" />
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogFieldLabelStyle}" />
        <Style x:Key="InputStyle" TargetType="Control" BasedOn="{StaticResource DialogInputStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}" />
        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}" />
        <Style TargetType="DataGrid" BasedOn="{StaticResource DialogDataGridStyle}">
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DialogDataGridHeaderStyle}" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="92" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="HeaderTitleText"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#17213A" />
            <TextBlock x:Name="HeaderSubtitleText"
                       Margin="0,4,0,0"
                       FontSize="12.5"
                       Foreground="#6E7B98" />

            <!-- 1С-стиль toolbar -->
            <WrapPanel Margin="0,12,0,0" Orientation="Horizontal">
                <Button Content="Провести и закрыть"
                        Background="#FFD43B"
                        BorderThickness="0"
                        Foreground="#17213A"
                        FontWeight="SemiBold"
                        Padding="14,7"
                        Height="32"
                        Cursor="Hand"
                        Margin="0,0,8,6"
                        ToolTip="Провести и закрыть — сохранить и закрыть вкладку (Ctrl+Enter)"
                        Click="HandleSaveClick" />
                <Button Content="Записать"
                        Background="Transparent"
                        BorderBrush="#D7DEEC"
                        BorderThickness="1"
                        Foreground="#17213A"
                        Padding="12,6"
                        Height="32"
                        Cursor="Hand"
                        Margin="0,0,6,6"
                        ToolTip="Записать — сохранить документ"
                        Click="HandleRecordClick" />
                <Button Content="Провести"
                        Background="Transparent"
                        BorderBrush="#D7DEEC"
                        BorderThickness="1"
                        Foreground="#17213A"
                        Padding="12,6"
                        Height="32"
                        Cursor="Hand"
                        Margin="0,0,12,6"
                        ToolTip="Провести — сохранить и применить движения"
                        Click="HandlePostClick" />

                <Button x:Name="CreateBasedOnButton"
                        Background="Transparent"
                        BorderBrush="#D7DEEC"
                        BorderThickness="1"
                        Foreground="#17213A"
                        Padding="12,6"
                        Height="32"
                        Cursor="Hand"
                        Margin="0,0,6,6"
                        ToolTip="Создать новый документ на основании текущего заказа"
                        Click="HandleCreateBasedOnClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Создать на основании" VerticalAlignment="Center" />
                        <TextBlock Text=" ▾" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#7A86A5" />
                    </StackPanel>
                </Button>

                <Button x:Name="PrintButton"
                        Background="Transparent"
                        BorderBrush="#D7DEEC"
                        BorderThickness="1"
                        Foreground="#17213A"
                        Padding="10,6"
                        Height="32"
                        Cursor="Hand"
                        Margin="0,0,6,6"
                        ToolTip="Печать"
                        Click="HandlePrintButtonClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE749;" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text=" ▾" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#7A86A5" />
                    </StackPanel>
                </Button>

                <Button x:Name="SetPurchaseMinButton"
                        Content="Установить закуп"
                        Background="Transparent"
                        BorderBrush="#D7DEEC"
                        BorderThickness="1"
                        Foreground="#17213A"
                        Padding="12,6"
                        Height="32"
                        Cursor="Hand"
                        Margin="0,0,6,6"
                        ToolTip="Установить минимальное количество для закупки"
                        Click="HandleSetPurchaseMinClick" />
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="18"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Номер" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="NumberTextBox" Style="{StaticResource InputStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock x:Name="DocumentDateLabelText" Text="Дата" Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker x:Name="DocumentDatePicker" Style="{StaticResource InputStyle}" />
                </StackPanel>
                <StackPanel x:Name="SecondaryDatePanel" Grid.Row="0" Grid.Column="4" Margin="0,0,0,14">
                    <TextBlock x:Name="SecondaryDateLabelText" Text="Срок оплаты" Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker x:Name="SecondaryDatePicker" Style="{StaticResource InputStyle}" />
                </StackPanel>

                <StackPanel x:Name="OrganizationPanel" Grid.Row="0" Grid.Column="4" Margin="0,0,0,14">
                    <TextBlock Text="Организация" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="OrganizationComboBox" Style="{StaticResource InputStyle}" IsEditable="True" SelectionChanged="HandleOrganizationSelectionChanged" />
                    <Button x:Name="OrganizationRequisitesLink"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            Cursor="Hand"
                            Click="HandleOrganizationRequisitesClick">
                        <TextBlock x:Name="OrganizationRequisitesText"
                                   Text="Банковский счёт, подписи и другие реквизиты"
                                   FontSize="11.5"
                                   Foreground="#4F5BFF"
                                   TextDecorations="Underline" />
                    </Button>
                </StackPanel>

                <StackPanel x:Name="CustomerPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                    <TextBlock Text="Клиент" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="CustomerComboBox"
                              Style="{StaticResource InputStyle}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              SelectionChanged="HandleCustomerSelectionChanged"
                              LostFocus="HandleCustomerLookupLostFocus" />
                </StackPanel>
                <StackPanel x:Name="OrderPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                    <TextBlock Text="Основание / заказ" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="OrderComboBox"
                              Style="{StaticResource InputStyle}"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              SelectionChanged="HandleOrderSelectionChanged" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,14">
                    <TextBlock Text="Статус" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="StatusComboBox"
                              Style="{StaticResource InputStyle}"
                              SelectionChanged="HandleStatusSelectionChanged" />
                </StackPanel>

                <StackPanel x:Name="WarehousePanel" Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Склад" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="WarehouseComboBox" Style="{StaticResource InputStyle}" IsEditable="True" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Менеджер" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ManagerComboBox" Style="{StaticResource InputStyle}" IsEditable="True" />
                </StackPanel>
                <StackPanel x:Name="CurrencyPanel" Grid.Row="2" Grid.Column="4" Margin="0,0,0,14">
                    <TextBlock Text="Валюта" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="CurrencyComboBox" Style="{StaticResource InputStyle}" />
                </StackPanel>
                <StackPanel x:Name="CarrierPanel" Grid.Row="2" Grid.Column="4" Margin="0,0,0,14">
                    <TextBlock Text="Способ доставки" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="CarrierTextBox" Style="{StaticResource InputStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5">
                    <TextBlock Text="Комментарий" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="CommentTextBox"
                             Style="{StaticResource DialogMultilineTextBoxStyle}"
                             Height="78"
                             VerticalScrollBarVisibility="Hidden" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Padding="16"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Связанные документы" FontSize="18" FontWeight="SemiBold" Foreground="#17213A" />
                    <TextBlock Text="Цепочка по заказу: счет, расходка, касса, возвраты."
                               Margin="0,4,18,0"
                               FontSize="12.5"
                               Foreground="#6E7B98"
                               TextWrapping="Wrap" />
                </StackPanel>

                <DataGrid x:Name="RelatedDocumentsGrid"
                          Grid.Column="1"
                          Height="112"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="HandleRelatedDocumentsGridDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="34">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Width="18"
                                          Height="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ToolTip="{Binding IndicatorText}">
                                        <Ellipse Stroke="{Binding IndicatorBrush}"
                                                 StrokeThickness="2"
                                                 Fill="Transparent" />
                                        <Ellipse Margin="4"
                                                 Fill="{Binding IndicatorBrush}"
                                                 Visibility="{Binding IndicatorFillVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Документ" Binding="{Binding Document}" Width="1.5*" />
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="0.75*" />
                        <DataGridTextColumn Header="Сумма" Binding="{Binding AmountDisplay}" Width="0.9*" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="0.9*" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                    <TextBlock x:Name="RelatedDocumentsSummaryText"
                               FontSize="12.5"
                               Foreground="#6E7B98"
                               TextWrapping="Wrap" />
                    <Button Content="Открыть"
                            Width="116"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="HandleOpenRelatedDocumentClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Позиции" FontSize="18" FontWeight="SemiBold" Foreground="#17213A" />
                        <TextBlock x:Name="LinesHintText" Margin="0,4,0,0" FontSize="12.5" Foreground="#6E7B98" />
                    </StackPanel>
                    <StackPanel x:Name="LinesActionsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Добавить позицию" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0" Click="HandleAddLineClick" />
                        <Button Content="Изменить" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0" Click="HandleEditLineClick" />
                        <Button Content="Удалить" Style="{StaticResource GhostButtonStyle}" Click="HandleRemoveLineClick" />
                        <Button x:Name="CreateReturnButton"
                                Content="Возврат"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="10,0,0,0"
                                ToolTip="Создать возврат по выбранным позициям заказа"
                                Click="HandleCreateReturnClick" />
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="LinesGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          SelectionMode="Extended"
                          MinHeight="118"
                          MaxHeight="220"
                          MinRowHeight="44"
                          CellEditEnding="HandleLinesGridCellEditEnding"
                          CurrentCellChanged="HandleLinesGridCurrentCellChanged"
                          MouseDoubleClick="HandleLinesGridDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding ItemCode}" Width="1*" />
                        <DataGridTemplateColumn Header="Товар" Width="3.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemName}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ItemName}"
                                               Padding="0,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="0.6*" />
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding QuantityDisplay}" Width="0.9*" />
                        <DataGridTextColumn Header="Цена" Binding="{Binding PriceDisplay}" Width="1*" />
                        <DataGridTextColumn Header="Сумма" Binding="{Binding AmountDisplay}" Width="1*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,18,0,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                <TextBlock x:Name="TotalText" FontSize="14" FontWeight="SemiBold" Foreground="#17213A" />
                <TextBlock x:Name="ValidationText" Margin="0,5,0,0" Foreground="#D92D20" />
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" MaxWidth="500">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="138" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="126" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Скидка руч., %" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="#6E7B98" />
                <TextBox x:Name="DiscountPercentTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="32"
                         TextAlignment="Right"
                         TextChanged="HandleDiscountPercentChanged" />
                <TextBlock Text="НДС" Grid.Row="0" Grid.Column="2" Margin="12,0,6,0" VerticalAlignment="Center" Foreground="#6E7B98" />
                <TextBox x:Name="VatAmountTextBox"
                         Grid.Row="0"
                         Grid.Column="3"
                         Height="32"
                         TextAlignment="Right"
                         IsReadOnly="True" />

                <TextBlock Text="Скидка руч., Σ" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="#6E7B98" />
                <TextBox x:Name="DiscountAmountTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Height="32"
                         TextAlignment="Right"
                         TextChanged="HandleDiscountAmountChanged" />
                <TextBlock Text="Всего" Grid.Row="2" Grid.Column="2" Margin="12,0,6,0" VerticalAlignment="Center" Foreground="#17213A" FontWeight="SemiBold" />
                <TextBox x:Name="GrandTotalTextBox"
                         Grid.Row="2"
                         Grid.Column="3"
                         Height="32"
                         TextAlignment="Right"
                         FontWeight="SemiBold"
                         IsReadOnly="True" />
            </Grid>

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18,0,0,0">
                <!-- Кнопки сохранения и печати перенесены в верхний toolbar (в стиле 1С УНФ).
                     Здесь оставлена только «Отмена» — закрыть без сохранения. -->
                <Button Content="Отмена"
                        Width="120"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="HandleCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
