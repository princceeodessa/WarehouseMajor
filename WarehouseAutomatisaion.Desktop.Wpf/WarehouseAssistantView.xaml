<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.WarehouseAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F7F9FD"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#17213A" />
        <SolidColorBrush x:Key="UserBubbleBrush" Color="#EEF2FF" />
        <SolidColorBrush x:Key="AssistantBubbleBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToolBubbleBrush" Color="#F4F7FF" />
    </UserControl.Resources>

    <DockPanel LastChildFill="True" Margin="16">

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="12"
                Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🤖 Спроси склад"
                               Foreground="{StaticResource HeadingBrush}"
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="HintText"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="Спрашивай по-русски: «сколько у нас лопат?», «где лежит товар X?», «куда положить Y?», «что в ячейке Z?»" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="ClearButton"
                        Content="🗑 Очистить"
                        Height="30" Padding="14,0"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnClearClicked" />
            </Grid>
        </Border>

        <!-- Input footer -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="12"
                Padding="14,10" Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Top"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11.5"
                           Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox"
                             Grid.Column="0"
                             Height="42" Padding="12,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                             FontSize="13"
                             AcceptsReturn="False"
                             KeyDown="OnInputKeyDown" />
                    <Button Grid.Column="1"
                            x:Name="SendButton"
                            Content="Отправить ↵"
                            Height="42" Padding="20,0" Margin="8,0,0,0"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            IsDefault="True"
                            Click="OnSendClicked" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Messages -->
        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="12">
            <ScrollViewer x:Name="MessagesScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="14">
                <ItemsControl x:Name="MessagesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Border Background="{Binding BubbleBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,8"
                                        HorizontalAlignment="{Binding Alignment}"
                                        MaxWidth="700">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RoleLabel}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,0,0,3" />
                                        <TextBlock Text="{Binding Body}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource HeadingBrush}" />
                                        <TextBlock Text="{Binding Footer}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding FooterVisibility}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
