<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.WarehouseAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WarehouseAutomatisaion.Desktop.Wpf"
             mc:Ignorable="d"
             Background="#F7F9FD"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#17213A" />

        <Style x:Key="TypingDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SuggestionChipStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,4,8,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#F4F7FF" />
            <Setter Property="BorderBrush" Value="#C8D1FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#2F3F74" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8EEFF" />
                    <Setter Property="BorderBrush" Value="#A0AFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True" Margin="16">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,13"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34"
                                Height="34"
                                Background="#EEF2FF"
                                BorderBrush="#C8D1FF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Margin="0,0,10,0">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE8BD;"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Чат помощник"
                                       Foreground="{StaticResource HeadingBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border x:Name="StatusBadge"
                                        Padding="8,2"
                                        Background="#E7F7EC"
                                        BorderBrush="#A6E0B6"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="StatusBadgeText"
                                               Text="Подключено"
                                               Foreground="#2E7D3F"
                                               FontSize="10.5"
                                               FontWeight="SemiBold" />
                                </Border>
                                <TextBlock x:Name="HintText"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11.5"
                                           Margin="8,1,0,0"
                                           TextWrapping="Wrap"
                                           Text="Локальная LLM через 1C/Ollama API + точные WMS-инструменты по остаткам, ячейкам и размещению." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenConfigButton"
                            Height="32"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            ToolTip="Открыть папку локальных настроек Major"
                            Click="OnOpenConfigClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE713;"
                                       FontSize="13"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Настройки" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearButton"
                            Height="32"
                            Padding="14,0"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="OnClearClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE74D;"
                                       FontSize="13"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Очистить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12"
                Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Top"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11.5"
                           Margin="0,0,0,6"
                           Text="Готов к вопросу." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox"
                             Grid.Column="0"
                             Height="44"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource LineBrush}"
                             BorderThickness="1"
                             FontSize="13"
                             AcceptsReturn="False"
                             KeyDown="OnInputKeyDown" />
                    <Button Grid.Column="1"
                            x:Name="SendButton"
                            Height="44"
                            Padding="20,0"
                            Margin="8,0,0,0"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            IsDefault="True"
                            Click="OnSendClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Отправить" VerticalAlignment="Center" />
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE724;"
                                       FontSize="12"
                                       Margin="8,1,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </DockPanel>
        </Border>

        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid x:Name="EmptyStatePanel" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="680"
                                Margin="40">
                        <Border Width="66"
                                Height="66"
                                Background="#EEF2FF"
                                BorderBrush="#C8D1FF"
                                BorderThickness="1"
                                CornerRadius="20"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE8BD;"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="32"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Спроси склад нормальным языком"
                                   Foreground="{StaticResource HeadingBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Помощник отвечает по двум источникам: точные WMS-данные берёт из Major, а аналитику по 1C отправляет в локальную модель на сервере."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,18" />
                        <TextBlock Text="Быстрые вопросы:"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Style="{StaticResource SuggestionChipStyle}"
                                    Content="Какие товары залежались?"
                                    Tag="Какие товары залежались и что лучше продвигать?"
                                    Click="OnSuggestionClicked" />
                            <Button Style="{StaticResource SuggestionChipStyle}"
                                    Content="Где риск дефицита?"
                                    Tag="Какие позиции могут закончиться быстрее всего?"
                                    Click="OnSuggestionClicked" />
                            <Button Style="{StaticResource SuggestionChipStyle}"
                                    Content="Где лежит крепёж?"
                                    Tag="Где лежит крепёж?"
                                    Click="OnSuggestionClicked" />
                            <Button Style="{StaticResource SuggestionChipStyle}"
                                    Content="Что в ячейке WH02-PCK-01-01-01-01?"
                                    Tag="Что в ячейке WH02-PCK-01-01-01-01?"
                                    Click="OnSuggestionClicked" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="MessagesScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6" HorizontalAlignment="{Binding Alignment}">
                                    <Border Background="{Binding BubbleBrush}"
                                            BorderBrush="{Binding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14,10"
                                            MaxWidth="820">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                    <TextBlock Text="{Binding RoleIcon}"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="12"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding RoleLabel}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding RoleLabelBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="TypingPanel"
                                                        Orientation="Horizontal"
                                                        Visibility="{Binding TypingVisibility}"
                                                        Margin="0,4,0,2">
                                                <Ellipse Style="{StaticResource TypingDotStyle}">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform />
                                                    </Ellipse.RenderTransform>
                                                    <Ellipse.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                     From="0" To="-4" Duration="0:0:0.4"
                                                                                     AutoReverse="True" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <Ellipse Style="{StaticResource TypingDotStyle}">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform />
                                                    </Ellipse.RenderTransform>
                                                    <Ellipse.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.13">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                     From="0" To="-4" Duration="0:0:0.4"
                                                                                     AutoReverse="True" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <Ellipse Style="{StaticResource TypingDotStyle}">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform />
                                                    </Ellipse.RenderTransform>
                                                    <Ellipse.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.26">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                                     From="0" To="-4" Duration="0:0:0.4"
                                                                                     AutoReverse="True" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                            </StackPanel>

                                            <TextBlock x:Name="BodyText"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource HeadingBrush}"
                                                       FontFamily="{Binding BodyFontFamily}"
                                                       Visibility="{Binding BodyVisibility}"
                                                       local:MarkdownInline.Text="{Binding Body}" />

                                            <TextBlock Text="{Binding Footer}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,6,0,0"
                                                       Visibility="{Binding FooterVisibility}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
