<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.WarehouseCellPlacementRuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="780"
        Height="620"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FC">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource DialogCardStyle}" />
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogFieldLabelStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}" />
        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource DialogTextBoxStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource DialogComboBoxStyle}" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="HeaderTitleText" FontSize="28" FontWeight="SemiBold" Foreground="#1B2440" />
            <TextBlock Text="Правило задает основную/резервную ячейку, приоритет зон и запрет смешивания категорий."
                       Margin="0,8,0,0"
                       FontSize="14"
                       Foreground="#6E7B98"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,16">
                    <TextBlock Text="Склад" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="WarehouseComboBox" SelectionChanged="HandleWarehouseChanged" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,16">
                    <TextBlock Text="Номенклатура" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ItemComboBox"
                              DisplayMemberPath="Name"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              SelectionChanged="HandleItemChanged"
                              LostKeyboardFocus="HandleItemLostFocus" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,16">
                    <TextBlock Text="Код товара" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="ItemCodeTextBox" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,16">
                    <TextBlock Text="Категория / тип товара" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="CategoryTextBox" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,16">
                    <TextBlock Text="Основная ячейка" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="PrimaryCellComboBox" IsEditable="True" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,16">
                    <TextBlock Text="Резервная ячейка" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ReserveCellComboBox" IsEditable="True" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,16">
                    <TextBlock Text="Приоритет зон" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="ZonePriorityTextBox" ToolTip="Например: Приемка, Хранение, Резерв" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,16">
                    <CheckBox x:Name="ForbidMixedCategoriesCheckBox"
                              VerticalAlignment="Center"
                              Content="Запретить смешивание разных категорий в одной ячейке"
                              IsChecked="True" />
                    <CheckBox x:Name="IsActiveCheckBox"
                              Margin="24,0,0,0"
                              VerticalAlignment="Center"
                              Content="Правило активно"
                              IsChecked="True" />
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                    <TextBlock Text="Комментарий" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="CommentTextBox"
                             Height="90"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="ValidationText"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="#D92D20"
                       TextWrapping="Wrap" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource GhostButtonStyle}" Width="120" Margin="0,0,10,0" Click="HandleCancelClick" />
                <Button Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}" Width="140" Click="HandleSaveClick" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
