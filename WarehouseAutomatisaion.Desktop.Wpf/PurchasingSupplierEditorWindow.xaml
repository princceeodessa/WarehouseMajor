<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.PurchasingSupplierEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Поставщик"
        Height="620"
        Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="{DynamicResource ApplicationBackgroundColor}" />
        <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardBackgroundFillColorDefault}" />
        <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource CardStrokeColorDefault}" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource AccentFillColorDefault}" />
        <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource TextFillColorSecondary}" />

        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource DialogCardStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogFieldLabelStyle}" />

        <Style x:Key="TextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DialogTextBoxStyle}" />

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DialogComboBoxStyle}" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}" />

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}" />
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,18">
            <TextBlock x:Name="HeaderTitleText" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="HeaderSubtitleText" Margin="0,6,0,0" FontSize="13.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                    <TextBlock Text="Название" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="NameTextBox" Style="{StaticResource TextBoxStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,14">
                    <TextBlock Text="Код" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="CodeTextBox" Style="{StaticResource TextBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,14">
                    <TextBlock Text="Статус" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="StatusComboBox" Style="{StaticResource ComboBoxStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,14">
                    <TextBlock Text="ИНН / КПП" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TaxIdTextBox" Style="{StaticResource TextBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,14">
                    <TextBlock Text="Телефон" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="PhoneTextBox" Style="{StaticResource TextBoxStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,14">
                    <TextBlock Text="E-mail" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="EmailTextBox" Style="{StaticResource TextBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,14">
                    <TextBlock Text="Договор" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="ContractTextBox" Style="{StaticResource TextBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                    <TextBlock Text="Источник" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="SourceTextBox" Style="{StaticResource TextBoxStyle}" />
                    <TextBlock x:Name="ValidationText" Margin="0,12,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12.5" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Отмена" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0" Click="HandleCancelClick" />
            <Button Content="Сохранить поставщика" Style="{StaticResource PrimaryButtonStyle}" Click="HandleSaveClick" />
        </StackPanel>
    </Grid>
</Window>
