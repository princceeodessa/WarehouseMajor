<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.ProductPriceHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История цен товара"
        Width="980"
        Height="640"
        MinWidth="760"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FC">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBorder" Color="#E1E8F4" />
        <SolidColorBrush x:Key="MutedText" Color="#6E7B98" />
        <SolidColorBrush x:Key="PrimaryText" Color="#17213A" />

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F4F9" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Foreground" Value="#3A4868" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2FA" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBE3FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,14,20,12">
            <StackPanel>
                <TextBlock Text="История цен товара" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                <TextBlock x:Name="HeaderSubtitleText" FontSize="12.5" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Toolbar / Filter -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,8,20,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Вид цены:" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="PriceTypeFilter"
                          MinWidth="220"
                          Height="28"
                          FontSize="12.5"
                          VerticalContentAlignment="Center"
                          SelectionChanged="HandlePriceTypeFilterChanged" />
                <Button x:Name="RefreshButton"
                        Style="{StaticResource OneCToolbarIconButtonStyle}"
                        Margin="12,0,0,0"
                        ToolTip="Обновить"
                        Click="HandleRefreshClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="#FFFFFF" Margin="20,12,20,12" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <DataGrid x:Name="HistoryGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeight="28"
                          ColumnHeaderHeight="30"
                          FontSize="12.5"
                          BorderThickness="0"
                          Background="#FFFFFF"
                          EnableRowVirtualization="True"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                          RowStyle="{StaticResource GridRowStyle}"
                          CellStyle="{StaticResource GridCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Период" Binding="{Binding PeriodDisplay}" Width="170" />
                        <DataGridTextColumn Header="Вид цены" Binding="{Binding PriceType}" Width="2.0*" />
                        <DataGridTextColumn Header="Цена" Binding="{Binding PriceDisplay}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Валюта" Binding="{Binding CurrencyCode}" Width="80" />
                        <DataGridTextColumn Header="Ед." Binding="{Binding UnitName}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyStateText"
                           Text="История цен пуста. Запустите ETL-скрипт scripts/Import-UnfPriceHistoryToMySql.ps1, чтобы подтянуть 81 444 записи из 1С УНФ."
                           Visibility="Collapsed"
                           Foreground="{StaticResource MutedText}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           TextAlignment="Center" />
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="12.5" />
            <Button Grid.Column="1" Content="Закрыть" Style="{StaticResource OneCToolbarButtonStyle}" Width="100" Click="HandleCloseClick" />
        </Grid>
    </Grid>
</Window>
