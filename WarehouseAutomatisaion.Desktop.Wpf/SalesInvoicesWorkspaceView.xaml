<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.SalesInvoicesWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F7F9FD">
    <UserControl.Resources>
        <Style x:Key="InvoicesGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <!-- Release 1.0.129: добавили recycling — без него каждый scroll пересоздавал rows. -->
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="InvoicesHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F4F9" />
            <Setter Property="BorderBrush" Value="#D7DEEC" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Foreground" Value="#3A4868" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="InvoicesRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2FA" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="#17213A" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFF" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBE3FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InvoicesCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#17213A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,8,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar (header в глобальном nav toolbar) -->
        <Border Grid.Row="0"
                Background="{StaticResource OneCToolbarBg}"
                BorderBrush="{StaticResource OneCToolbarBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6,5"
                Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="Create" Style="{StaticResource OneCPrimaryToolbarButtonStyle}" Margin="0,0,6,0" Click="HandleCreateClick" />
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,10,0" ToolTip="Быстрое добавление" Click="HandleCreateClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="12" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,4,0" ToolTip="Действия с выделенным" Click="HandleRowActionsClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE712;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,4,0" ToolTip="Фильтр">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71C;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,10,0" ToolTip="Печать" Click="HandlePrintClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE749;" FontSize="13" />
                </Button>
                <Button Content="Generate ▾" Style="{StaticResource OneCToolbarButtonStyle}" Margin="0,0,4,0" ToolTip="Сформировать документ" Click="HandleGenerateClick" />
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,4,0" ToolTip="Структура подчинённости" Click="HandleStructureClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="13" Foreground="#4F5BFF" />
                </Button>
                <Button Content="ЭДО ▾" Style="{StaticResource OneCToolbarButtonStyle}" Margin="0,0,10,0" ToolTip="Электронный документооборот" Click="HandleEdoClick" />
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" ToolTip="Дополнительные действия" Click="HandleMoreClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE712;" FontSize="13" />
                </Button>
            </WrapPanel>
        </Border>

        <!-- Grid + right panel (1С) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E7ECF7" BorderThickness="1" CornerRadius="0" Padding="0" Margin="0,8,12,0">
            <DataGrid x:Name="InvoicesGrid"
                      Style="{StaticResource InvoicesGridStyle}"
                      ColumnHeaderStyle="{StaticResource InvoicesHeaderStyle}"
                      RowStyle="{StaticResource InvoicesRowStyle}"
                      CellStyle="{StaticResource InvoicesCellStyle}"
                      AlternationCount="2"
                      SelectionChanged="HandleSelectionChanged"
                      MouseDoubleClick="HandleGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="32" IsReadOnly="True">
                        <DataGridTemplateColumn.Header>
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C7;" FontSize="13" Foreground="#5F7DA8" ToolTip="Оплата" HorizontalAlignment="Center" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="11" Height="11" Stroke="{Binding PaymentDotBrush}" StrokeThickness="2" Fill="{Binding PaymentDotFill}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding PaymentTooltip}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Дата" Binding="{Binding DateDisplay}" Width="100" IsReadOnly="True" />
                    <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="130" IsReadOnly="True" />
                    <DataGridTextColumn Header="Покупатель" Binding="{Binding CustomerName}" Width="*" MinWidth="240" IsReadOnly="True" />
                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalDisplay}" Width="120" IsReadOnly="True" />
                    <DataGridTemplateColumn Width="44" IsReadOnly="True">
                        <DataGridTemplateColumn.Header>
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7A6;" FontSize="13" Foreground="#5F7DA8" ToolTip="ЭДО" HorizontalAlignment="Center" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7A6;" FontSize="13" Foreground="{Binding EdoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding EdoTooltip}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Состояние оригинала" Width="170" IsReadOnly="True" SortMemberPath="OriginalStatus">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OriginalStatus}" Foreground="{Binding OriginalStatusBrush}" VerticalAlignment="Center" TextDecorations="Underline" Cursor="Hand" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="36" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="HandleRowMenuClick" ToolTip="Действия">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE712;" FontSize="11" Foreground="#5F7DA8" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <!-- Right side panel (1С) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <StackPanel>
                    <Border Height="28" Background="#FFFFFF" BorderBrush="#D7DEEC" BorderThickness="1" CornerRadius="3" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Grid.Column="0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" FontSize="12" TextChanged="HandleSearchChanged" />
                            <TextBlock x:Name="SearchPlaceholderText" Grid.Column="0" Text="Search (Ctrl+F)" IsHitTestVisible="False" Foreground="#9AA4BC" VerticalAlignment="Center" Margin="10,0" />
                            <TextBlock Grid.Column="1" FontFamily="Segoe Fluent Icons" Text="&#xE721;" Foreground="#9AA4BC" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Период: за все время" Foreground="#4F5BFF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" Cursor="Hand" />

                    <TextBlock Text="Покупатель / ИНН / телефон" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                    <ComboBox x:Name="CustomerFilterCombo" Height="28" Margin="0,0,0,8" IsEditable="True" SelectionChanged="HandleFilterChanged" />

                    <TextBlock Text="Оплата" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                    <ComboBox x:Name="PaymentFilterCombo" Height="28" Margin="0,0,0,8" SelectionChanged="HandleFilterChanged">
                        <ComboBoxItem Content="Все" IsSelected="True" />
                        <ComboBoxItem Content="Оплачено" />
                        <ComboBoxItem Content="Не оплачено" />
                        <ComboBoxItem Content="Частично" />
                    </ComboBox>

                    <TextBlock Text="Ответственный" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                    <ComboBox x:Name="ManagerFilterCombo" Height="28" Margin="0,0,0,8" IsEditable="True" SelectionChanged="HandleFilterChanged" />

                    <TextBlock Text="Организация" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                    <ComboBox x:Name="OrganizationFilterCombo" Height="28" Margin="0,0,0,8" IsEditable="True" SelectionChanged="HandleFilterChanged" />

                    <TextBlock Text="Период с" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                    <DatePicker x:Name="DateFromPicker" Height="28" Margin="0,0,0,8" SelectedDateChanged="HandleFilterChanged" />

                    <TextBlock Text="Период по" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                    <DatePicker x:Name="DateToPicker" Height="28" Margin="0,0,0,10" SelectedDateChanged="HandleFilterChanged" />

                    <Button Content="Сбросить фильтры" Style="{StaticResource OneCToolbarButtonStyle}" HorizontalAlignment="Stretch" Click="HandleResetFiltersClick" Margin="0,0,0,10" />

                    <TextBlock Text="+ фильтры" Foreground="#4F5BFF" FontSize="12" Margin="0,0,0,14" Cursor="Hand" HorizontalAlignment="Right" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="InvoicesCountText" Text="Всего: 0" Foreground="#5F6F95" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Border x:Name="SelectedSummary"
                        Background="#EEF2FF"
                        BorderBrush="#C8D1FF"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,4"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C7;" FontSize="11" Foreground="#4F5BFF" VerticalAlignment="Center" />
                        <TextBlock x:Name="SelectedSummaryText" Foreground="#1B2440" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Width="26" Height="24" Margin="0,0,2,0" ToolTip="К началу">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE892;" FontSize="11" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Width="26" Height="24" Margin="0,0,2,0" ToolTip="Предыдущая">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70E;" FontSize="11" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Width="26" Height="24" Margin="0,0,2,0" ToolTip="Следующая">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" FontSize="11" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Width="26" Height="24" ToolTip="В конец">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE893;" FontSize="11" />
                </Button>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="свернуть" Foreground="#4F5BFF" FontSize="12" VerticalAlignment="Center" Cursor="Hand" />
        </Grid>
    </Grid>
</UserControl>
