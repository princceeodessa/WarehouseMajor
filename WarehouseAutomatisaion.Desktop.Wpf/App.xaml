<Application x:Class="WarehouseAutomatisaion.Desktop.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent v2 design tokens (Light theme).
                     Provides DynamicResources used throughout the app:
                       ApplicationBackgroundBrush, CardBackgroundFillColorDefaultBrush,
                       TextFillColorPrimary/Secondary/TertiaryBrush,
                       SystemAccentColorBrush + variants,
                       ControlStrokeColorDefaultBrush, CardStrokeColorDefaultBrush,
                       LayerFillColorAltBrush, SubtleFillColorTertiaryBrush,
                       SolidBackgroundFillColorBaseBrush. -->
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Theme/Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Wpf.Ui.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== Fluent typography ===== -->
            <FontFamily x:Key="FluentFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
            <FontFamily x:Key="FluentIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- ===== Fluent type ramp (Display, TitleLarge, Title, Subtitle, BodyStrong, Body, Caption) =====
                 Mirrors the WinUI 3 type ramp. Use via Style="{StaticResource TitleTextStyle}". -->
            <Style x:Key="DisplayTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="FontSize" Value="40" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="52" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="TitleLargeTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="36" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="TitleTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="28" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="SubtitleTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="BodyStrongTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="BodySecondaryTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyTextStyle}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CaptionTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CaptionStrongTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionTextStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <!-- ===== Spacing scale (Fluent 4/8 grid) =====
                 Use as Padding/Margin via {StaticResource Spacing16} etc. -->
            <Thickness x:Key="Spacing4">4</Thickness>
            <Thickness x:Key="Spacing8">8</Thickness>
            <Thickness x:Key="Spacing12">12</Thickness>
            <Thickness x:Key="Spacing16">16</Thickness>
            <Thickness x:Key="Spacing20">20</Thickness>
            <Thickness x:Key="Spacing24">24</Thickness>
            <Thickness x:Key="Spacing28">28</Thickness>
            <Thickness x:Key="Spacing32">32</Thickness>
            <Thickness x:Key="Spacing48">48</Thickness>

            <!-- Vertical-only spacing (for StackPanel children) -->
            <Thickness x:Key="StackGap8">0,0,0,8</Thickness>
            <Thickness x:Key="StackGap12">0,0,0,12</Thickness>
            <Thickness x:Key="StackGap16">0,0,0,16</Thickness>
            <Thickness x:Key="StackGap20">0,0,0,20</Thickness>
            <Thickness x:Key="StackGap24">0,0,0,24</Thickness>

            <!-- ===== Legacy palette mapped onto Fluent tokens =====
                 Views keep the old keys; this layer redirects them to Fluent. -->
            <SolidColorBrush x:Key="FluentSurfacePrimaryBrush" Color="{DynamicResource SolidBackgroundFillColorBase}" />
            <SolidColorBrush x:Key="FluentSurfaceSecondaryBrush" Color="{DynamicResource SolidBackgroundFillColorSecondary}" />
            <SolidColorBrush x:Key="FluentCardBrush" Color="{DynamicResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="FluentCardStrokeBrush" Color="{DynamicResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="FluentTextPrimaryBrush" Color="{DynamicResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="FluentTextSecondaryBrush" Color="{DynamicResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="FluentTextTertiaryBrush" Color="{DynamicResource TextFillColorTertiary}" />
            <SolidColorBrush x:Key="FluentAccentBrush" Color="{DynamicResource SystemAccentColorSecondary}" />
            <SolidColorBrush x:Key="FluentAccentTextBrush" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
            <SolidColorBrush x:Key="FluentStrokeBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
            <SolidColorBrush x:Key="FluentSubtleBrush" Color="{DynamicResource SubtleFillColorTertiary}" />

            <!-- ===== Implicit base styles ===== -->
            <Style TargetType="{x:Type Button}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
            </Style>

            <!-- ===== Top action button (Fluent Standard Button) ===== -->
            <Style x:Key="TopActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== Primary (Accent) button ===== -->
            <Style x:Key="TopPrimaryActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TopActionButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentControlBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== Search container (Fluent input) ===== -->
            <Style x:Key="TopSearchContainerStyle" TargetType="{x:Type Border}">
                <Setter Property="Height" Value="36" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,0,12,0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="TopSearchTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            </Style>

            <Style x:Key="TopSearchPlaceholderStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="TopSearchIconStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="Text" Value="&#xE721;" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- ===== Table filter row controls ===== -->
            <Style x:Key="TableFilterSearchContainerStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource TopSearchContainerStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
            </Style>

            <Style x:Key="TableFilterSearchTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TopSearchTextBoxStyle}" />
            <Style x:Key="TableFilterSearchPlaceholderStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TopSearchPlaceholderStyle}" />
            <Style x:Key="TableFilterSearchIconStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TopSearchIconStyle}" />

            <Style x:Key="TableFilterComboBoxStyle" TargetType="{x:Type ComboBox}">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="118" />
                <Setter Property="Padding" Value="12,0,8,0" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="TableFilterDatePickerStyle" TargetType="{x:Type DatePicker}">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="128" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="TableFilterActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TopActionButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="14,0" />
            </Style>

            <Style x:Key="TableFilterResetButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TableFilterActionButtonStyle}" />

            <!-- ===== Bulk action bar ===== -->
            <Style x:Key="TableBulkBarStyle" TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="TableBulkTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TableBulkActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TableFilterActionButtonStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="TableBulkCloseButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TopActionButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style x:Key="TableRowActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TopActionButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="TableRowActionIconStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="Text" Value="&#xE712;" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- ===== Context menu (Fluent flyout) ===== -->
            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="Padding" Value="4" />
                <Setter Property="Background" Value="{DynamicResource AcrylicBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorFlyoutBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style TargetType="{x:Type Separator}">
                <Setter Property="Margin" Value="4,4" />
            </Style>

            <!-- ===== Dialog/Card styles ===== -->
            <Style x:Key="DialogCardStyle" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="DialogFieldLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="DialogInputStyle" TargetType="{x:Type Control}">
                <Setter Property="Height" Value="36" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="DialogTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource DialogInputStyle}">
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="DialogMultilineTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource DialogTextBoxStyle}">
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Height" Value="NaN" />
            </Style>

            <Style x:Key="DialogComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource DialogInputStyle}">
                <Setter Property="Padding" Value="12,0,8,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="DialogDatePickerStyle" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource DialogInputStyle}" />

            <Style x:Key="DialogPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TopPrimaryActionButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="DialogSecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TopActionButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="DialogDataGridStyle" TargetType="{x:Type DataGrid}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="RowHeight" Value="44" />
                <Setter Property="ColumnHeaderHeight" Value="40" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="EnableColumnVirtualization" Value="True" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
            </Style>

            <Style x:Key="DialogDataGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,0" />
            </Style>

            <!-- ===== Table footer ===== -->
            <Style x:Key="TableFooterGridStyle" TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="18,0,18,0" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="TableFooterDockPanelStyle" TargetType="{x:Type DockPanel}">
                <Setter Property="Margin" Value="16,12,16,0" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="LastChildFill" Value="True" />
            </Style>

            <Style x:Key="TableFooterTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TablePagerPanelStyle" TargetType="{x:Type StackPanel}">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TablePagerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TopActionButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="TablePagerActiveButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TablePagerButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="TablePagerEllipsisTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="2,0,10,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TablePagerIndicatorStyle" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="TablePagerIndicatorTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TablePageSizeComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource TableFilterComboBoxStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="92" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="10,0,8,0" />
            </Style>

            <!-- ===== Empty state ===== -->
            <Style x:Key="TableEmptyOverlayStyle" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <Style x:Key="TableEmptyIconBoxStyle" TargetType="{x:Type Border}">
                <Setter Property="Width" Value="96" />
                <Setter Property="Height" Value="96" />
                <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                <Setter Property="CornerRadius" Value="48" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,18" />
            </Style>

            <Style x:Key="TableEmptyIconTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="42" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TableEmptyTitleStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <Style x:Key="TableEmptyHintStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- ===== Top header (Fluent Title / Caption) ===== -->
            <Style x:Key="TopHeaderGridStyle" TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="0,0,0,22" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="TopHeaderTextPanelStyle" TargetType="{x:Type StackPanel}">
                <Setter Property="Margin" Value="0,0,24,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TopHeaderTitleStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="TopHeaderSubtitleStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="TopHeaderActionsWrapPanelStyle" TargetType="{x:Type WrapPanel}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TopHeaderActionsGridStyle" TargetType="{x:Type Grid}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!-- ===== Metric card (Fluent CardControl-like) ===== -->
            <Style x:Key="MetricCardStyle" TargetType="{x:Type Border}">
                <Setter Property="MinHeight" Value="104" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <!-- Fluent depth-2 elevation. Subtle so it works on Mica + opaque chrome. -->
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="8"
                                          ShadowDepth="1"
                                          Direction="270"
                                          Opacity="0.06" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MetricIconBoxStyle" TargetType="{x:Type Border}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <Style x:Key="MetricIconTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="MetricValueStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="LineHeight" Value="26" />
            </Style>

            <Style x:Key="MetricValueCompactStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MetricValueStyle}">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="LineHeight" Value="21" />
            </Style>

            <Style x:Key="MetricLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,3,0,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="MetricHintStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="MetricCaptionStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- ===== Implicit base styles ===== -->
            <Style TargetType="{x:Type ScrollViewer}">
                <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            </Style>

            <Style TargetType="{x:Type DataGrid}">
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="EnableColumnVirtualization" Value="True" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
            </Style>

            <Style TargetType="{x:Type TextBox}">
                <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
            </Style>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
            </Style>

            <!-- ===== Page container & section header ===== -->
            <!-- Consistent outer page padding across all workspace views. -->
            <Style x:Key="PageContainerStyle" TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="28,20,28,28" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!-- Section header: title + optional action area, with consistent bottom margin. -->
            <Style x:Key="SectionHeaderTitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TitleTextStyle}">
                <Setter Property="Margin" Value="0,0,0,14" />
            </Style>

            <Style x:Key="SectionHeaderSubtitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodySecondaryTextStyle}">
                <Setter Property="Margin" Value="0,2,0,12" />
            </Style>

            <!-- ===== Form group: label + input + help text =====
                 Compose via StackPanel:
                   <StackPanel Style="{StaticResource FormGroupStyle}">
                       <TextBlock Style="{StaticResource FormLabelStyle}" Text="Имя" />
                       <TextBox Style="{StaticResource FormInputStyle}" />
                       <TextBlock Style="{StaticResource FormHintStyle}" Text="Обязательное поле" />
                   </StackPanel>
            -->
            <Style x:Key="FormGroupStyle" TargetType="{x:Type StackPanel}">
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

            <Style x:Key="FormLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionStrongTextStyle}">
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="FormInputStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource DialogTextBoxStyle}">
                <Setter Property="Height" Value="40" />
            </Style>

            <Style x:Key="FormHintStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CaptionTextStyle}">
                <Setter Property="Margin" Value="0,6,0,0" />
            </Style>

            <!-- ===== InfoBar styles (4 severities) =====
                 Use as <Border Style="{StaticResource InfoBarInfoStyle}">
                 with an inner StackPanel Orientation="Horizontal" containing icon + text. -->
            <Style x:Key="InfoBarBaseStyle" TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="InfoBarInfoStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource InfoBarBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorAttentionBrush}" />
            </Style>

            <Style x:Key="InfoBarSuccessStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource InfoBarBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </Style>

            <Style x:Key="InfoBarWarningStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource InfoBarBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Style>

            <Style x:Key="InfoBarErrorStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource InfoBarBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="InfoBarIconStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FluentIconFontFamily}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>

            <Style x:Key="InfoBarTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BodyTextStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- ===== Tag / Chip / Badge styles =====
                 Use as <Border Style="{StaticResource TagDefaultStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="Активен" />
                        </Border> -->
            <Style x:Key="TagBaseStyle" TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="TagDefaultStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource TagBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            </Style>

            <Style x:Key="TagAccentStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource TagBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentControlBorderBrush}" />
            </Style>

            <Style x:Key="TagSuccessStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource TagBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </Style>

            <Style x:Key="TagWarningStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource TagBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Style>

            <Style x:Key="TagErrorStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource TagBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="TagTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- ===== Interactive / hover cards =====
                 Apply via Style="{StaticResource HoverElevationCardStyle}".
                 Card lifts on mouseover via scale + brighter stroke. -->
            <Style x:Key="HoverElevationCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource MetricCardStyle}">
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.015" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.015" Duration="0:0:0.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== DataGrid row hover + selection styling =====
                 Pulled out as an explicit RowStyle resource that views can apply via
                 RowStyle="{StaticResource FluentDataGridRowStyle}". -->
            <Style x:Key="FluentDataGridRowStyle" TargetType="{x:Type DataGridRow}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FluentDataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
