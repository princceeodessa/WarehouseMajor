<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.WmsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F7F9FD"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#17213A" />

        <Style x:Key="WmsSectionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="146" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F7FAFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#C8D1FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EEF2FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ModeTitleText"
                               Text="Склад"
                               Foreground="{StaticResource HeadingBrush}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ModeSubtitleText"
                               Text="WMS без перегруза: чат, операции, остатки, ячейки и контроль в одном окне."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#EEF2FF"
                        BorderBrush="#C8D1FF"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="WMS"
                               Foreground="#2F3F74"
                               FontSize="11"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,10">
            <WrapPanel>
                <Button x:Name="ModeAssistantButton" Tag="assistant" Style="{StaticResource WmsSectionButtonStyle}" Click="OnModeClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BD;" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Чат помощник" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="ModeWorkButton" Tag="work" Style="{StaticResource WmsSectionButtonStyle}" Click="OnModeClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7C3;" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Работа" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="ModeDataButton" Tag="data" Style="{StaticResource WmsSectionButtonStyle}" Click="OnModeClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8FD;" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Данные" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="ModeControlButton" Tag="control" Style="{StaticResource WmsSectionButtonStyle}" Click="OnModeClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Контроль" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <ContentControl Grid.Row="2" x:Name="ModeContentHost" />
    </Grid>
</UserControl>
