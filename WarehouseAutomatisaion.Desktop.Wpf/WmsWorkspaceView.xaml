<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.WmsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WarehouseAutomatisaion.Desktop.Wpf"
             mc:Ignorable="d"
             Background="#F7F9FD"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#17213A" />

        <Style x:Key="WmsModeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F7FAFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#C8D1FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EEF2FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" LastChildFill="True" Margin="0,0,12,0">
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,12"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Склад"
                                   Foreground="{StaticResource HeadingBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ModeSubtitleText"
                                   Text="Единое рабочее место WMS: сканирование, остатки, ячейки, операции и журнал."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#EEF2FF"
                            BorderBrush="#C8D1FF"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="10,5"
                            VerticalAlignment="Center">
                        <TextBlock Text="Одно окно"
                                   Foreground="#2F3F74"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,10"
                    Margin="0,0,0,10">
                <WrapPanel>
                    <Button x:Name="ModeScanButton" Tag="scan" Style="{StaticResource WmsModeButtonStyle}" Click="OnModeClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B6;" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Скан" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ModeStockButton" Tag="stock" Style="{StaticResource WmsModeButtonStyle}" Click="OnModeClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Остатки" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ModeCellsButton" Tag="cells" Style="{StaticResource WmsModeButtonStyle}" Click="OnModeClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71D;" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Ячейки" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ModeCatalogButton" Tag="catalog" Style="{StaticResource WmsModeButtonStyle}" Click="OnModeClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8FD;" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Номенклатура" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ModeReceiveButton" Tag="receive" Style="{StaticResource WmsModeButtonStyle}" Click="OnModeClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7B8;" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Приёмка" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ModeTransferButton" Tag="transfer" Style="{StaticResource WmsModeButtonStyle}" Click="OnModeClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8AB;" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Перемещение" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ModeStockTakeButton" Tag="stocktake" Style="{StaticResource WmsModeButtonStyle}" Click="OnModeClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xF0E3;" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Инвентаризация" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ModeDraftsButton" Tag="receipt-drafts" Style="{StaticResource WmsModeButtonStyle}" Click="OnModeClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7C3;" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="AI черновики" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ModeLogButton" Tag="operation-log" Style="{StaticResource WmsModeButtonStyle}" Click="OnModeClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Журнал" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>

            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <ContentControl x:Name="ModeContentHost" />
            </Border>
        </DockPanel>

        <Border Grid.Column="1"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top"
                        Background="#111827"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="34"
                                Height="34"
                                Background="#1F2937"
                                BorderBrush="#374151"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE8BD;"
                                       Foreground="#FF5A3D"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="AI помощник"
                                       Foreground="#F9FAFB"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Всегда рядом, не отдельной вкладкой"
                                       Foreground="#9CA3AF"
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
                <local:WarehouseAssistantView />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
