<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WarehouseAutomatisaion.Desktop\WarehouseAutomatisaion.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Release 1.0.111: ребренд MajorWarehause → Major. AssemblyName управляет именем
         итогового .exe (Major.exe), Title/Product — что видно в свойствах файла Windows. -->
    <AssemblyName>Major</AssemblyName>
    <Title>Major</Title>
    <Product>Major</Product>
    <Version>1.0.156</Version>
    <AssemblyVersion>1.0.156.0</AssemblyVersion>
    <FileVersion>1.0.156.0</FileVersion>
    <InformationalVersion>1.0.156</InformationalVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Release 1.0.128: WinForms подключаем ради System.Windows.Forms.NotifyIcon
         (минимизация в системный трей). WPF не умеет нативно работать с иконкой
         трея, проще включить совместимый референс чем тащить NuGet-зависимость. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>major.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Подхватываем major.ico как embedded resource, чтобы .exe носил иконку в свойствах
         даже когда файл скопирован за пределы установочной папки. -->
    <Content Include="major.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Release 1.0.128: UseWindowsForms=true (для NotifyIcon) автоматически добавляет
       System.Windows.Forms / System.Drawing в ImplicitUsings, что ломает все WPF-views
       конфликтом (Brush / ComboBox / UserControl). Убираем эти global usings —
       полные пути System.Windows.Forms.NotifyIcon / System.Drawing.Icon используются
       только в MainWindow явно. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
