<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:WarehouseAutomatisaion.Desktop.Wpf"
        mc:Ignorable="d"
        Title="MajorWarehause"
        Width="1440"
        Height="920"
        MinWidth="1240"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12,12,0,0"
                                Padding="0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ui:NavigationView x:Name="RootNavigation"
                       PaneDisplayMode="Left"
                       OpenPaneLength="260"
                       CompactPaneLength="56"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="True"
                       SelectionChanged="HandleNavigationSelectionChanged">

        <!-- Pane header: brand mark + product name -->
        <ui:NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal" Margin="14,10" VerticalAlignment="Center">
                <Border Width="28"
                        Height="28"
                        CornerRadius="9"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <Rectangle Width="12"
                               Height="12"
                               RadiusX="3"
                               RadiusY="3"
                               Fill="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="ApplicationNameText"
                           Text="MajorWarehause"
                           Margin="12,0,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </ui:NavigationView.PaneHeader>

        <!-- Main navigation -->
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem x:Name="NavDashboardItem" Content="Главная" Tag="dashboard">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="NavSalesItem" Content="Заказы" Tag="sales">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE14C;" FontFamily="Segoe Fluent Icons" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="NavCustomersItem" Content="Клиенты" Tag="customers">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE716;" FontFamily="Segoe Fluent Icons" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="NavShipmentsItem" Content="Отгрузки" Tag="shipments">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xEC47;" FontFamily="Segoe Fluent Icons" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="NavFinanceItem" Content="Возвраты и оплаты" Tag="finance">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE8FB;" FontFamily="Segoe Fluent Icons" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="NavPurchasingItem" Content="Закупки" Tag="purchasing">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE719;" FontFamily="Segoe Fluent Icons" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="NavWarehouseItem" Content="Склад" Tag="warehouse">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE7F8;" FontFamily="Segoe Fluent Icons" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="NavCatalogItem" Content="Товары" Tag="catalog">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xEECA;" FontFamily="Segoe Fluent Icons" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="NavAuditItem" Content="Отчеты" Tag="audit">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE9D2;" FontFamily="Segoe Fluent Icons" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <!-- Footer menu: Settings (admin-only, visibility set in code-behind) -->
        <ui:NavigationView.FooterMenuItems>
            <ui:NavigationViewItem x:Name="NavSettingsItem" Content="Настройки" Tag="settings">
                <ui:NavigationViewItem.Icon>
                    <ui:FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.FooterMenuItems>

        <!-- Pane footer: user profile, db status, update panel -->
        <ui:NavigationView.PaneFooter>
            <StackPanel x:Name="SidebarFooterPanel" Margin="12,0,12,12">
                <Border x:Name="UserProfileCard"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,8"
                        Cursor="Hand"
                        MouseLeftButtonUp="HandleUserProfileCardClick"
                        AutomationProperties.Name="Профиль пользователя">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="26"
                                Height="26"
                                CornerRadius="13"
                                Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                VerticalAlignment="Top">
                            <TextBlock x:Name="UserAvatarText"
                                       Text="MW"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Border>
                        <StackPanel x:Name="UserProfileTextPanel" Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock x:Name="UserDisplayNameText"
                                       Text="MajorWarehause"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="UserRoleText"
                                       Text="Администратор"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="UserProfileChevronText"
                                   Grid.Column="2"
                                   FontFamily="Segoe Fluent Icons"
                                   Text="&#xE70D;"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border x:Name="DatabaseStatusBadge"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,8"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Источник данных">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DatabaseStatusIconText"
                                   FontFamily="Segoe Fluent Icons"
                                   Text="&#xE783;"
                                   FontSize="14"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock x:Name="DatabaseStatusTitleText"
                                       Text="Локальные данные"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="DatabaseStatusText"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="UpdatePanelCard"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Обновление"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="ApplicationVersionText"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ApplicationUpdateStatusText"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="UpdateApplicationButton"
                                Margin="0,10,0,0"
                                Height="32"
                                Padding="10,0"
                                BorderThickness="0"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="HandleUpdateApplicationClick"
                                Content="Проверить обновления" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ui:NavigationView.PaneFooter>

        <!-- Content area: tabs (lazy-loaded sections) -->
        <Grid Margin="18,14,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <TabControl x:Name="WorkspaceTabs"
                        Grid.Row="0"
                        SelectionChanged="HandleWorkspaceTabsSelectionChanged"
                        Background="Transparent"
                        BorderBrush="Transparent" />

            <Grid Grid.Row="1" Visibility="Collapsed">
                <TextBlock x:Name="CurrentSectionTitleText" />
                <TextBlock x:Name="CurrentSectionSubtitleText" />
            </Grid>
        </Grid>
    </ui:NavigationView>
</Window>
