<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Major"
        Width="1440"
        Height="920"
        MinWidth="1240"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FF">
    <Window.Resources>
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#596683" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F6F8FF" />
                    <Setter Property="BorderBrush" Value="#D9E1FF" />
                    <Setter Property="Foreground" Value="#2F3F74" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                    <Setter Property="BorderBrush" Value="#C7D1FF" />
                    <Setter Property="Foreground" Value="#22305B" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#A9B3C7" />
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Opacity" Value="0.62" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 1С-стиль «Панель разделов»: крупный блок раздела -->
        <Style x:Key="MainSectionBlockButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="74" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1B2440" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F5FF" />
                    <Setter Property="BorderBrush" Value="#C8D1FF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E6ECFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MinorIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#5F6F95" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F5FF" />
                    <Setter Property="BorderBrush" Value="#C8D1FF" />
                    <Setter Property="Foreground" Value="#4F5BFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F2A44" />
            <Setter Property="BorderBrush" Value="#E3EAF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12,12,0,0"
                                Padding="0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarChrome"
                Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#E8EDF7"
                BorderThickness="0,0,1,0">
            <Grid x:Name="SidebarRoot" Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="SidebarHeaderPanel" Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28"
                                Height="28"
                                CornerRadius="9"
                                Background="#4F5BFF">
                            <Grid>
                                <Rectangle Width="12"
                                           Height="12"
                                           RadiusX="3"
                                           RadiusY="3"
                                           Fill="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ApplicationNameText"
                                   Text="Major"
                                   Margin="12,0,0,0"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="#1B2440"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SidebarNavigationTitleText"
                               Text="Разделы"
                               Margin="0,0,0,12"
                               FontSize="14"
                               Foreground="#7A86A5" />

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- 1С УНФ-стиль: 3 крупных блока разделов -->
                            <Button x:Name="NavSalesButton"
                                    Tag="section-sales"
                                    AutomationProperties.Name="Продажи"
                                    Style="{StaticResource MainSectionBlockButtonStyle}"
                                    Click="HandleNavButtonClick">
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Segoe Fluent Icons"
                                               Text="&#xE14C;"
                                               FontSize="22"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Продажи"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button x:Name="NavPurchasingButton"
                                    Tag="section-purchasing"
                                    AutomationProperties.Name="Закупки"
                                    Style="{StaticResource MainSectionBlockButtonStyle}"
                                    Click="HandleNavButtonClick">
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Segoe Fluent Icons"
                                               Text="&#xE719;"
                                               FontSize="22"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Закупки"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button x:Name="NavWarehouseButton"
                                    Tag="section-warehouse"
                                    AutomationProperties.Name="Склад"
                                    Style="{StaticResource MainSectionBlockButtonStyle}"
                                    Click="HandleNavButtonClick">
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Segoe Fluent Icons"
                                               Text="&#xE7F8;"
                                               FontSize="22"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Склад"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Sprint 1 (WMS остатки): живые остатки из app_warehouse_stock_balances -->
                            <Button x:Name="NavStockBalancesButton"
                                    Tag="stock"
                                    AutomationProperties.Name="Остатки"
                                    Style="{StaticResource MainSectionBlockButtonStyle}"
                                    Click="HandleNavButtonClick">
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Segoe Fluent Icons"
                                               Text="&#xE73E;"
                                               FontSize="22"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Остатки"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Sprint 3 (WMS ячейки): master-data ячеек склада -->
                            <Button x:Name="NavStorageCellsButton"
                                    Tag="cells"
                                    AutomationProperties.Name="Ячейки"
                                    Style="{StaticResource MainSectionBlockButtonStyle}"
                                    Click="HandleNavButtonClick">
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Segoe Fluent Icons"
                                               Text="&#xE71D;"
                                               FontSize="22"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Ячейки"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Sprint 4 (WMS приёмка): окно записи товара в ячейку -->
                            <Button x:Name="NavReceiveButton"
                                    Tag="receive"
                                    AutomationProperties.Name="Приёмка"
                                    Style="{StaticResource MainSectionBlockButtonStyle}"
                                    Click="HandleNavButtonClick">
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Segoe Fluent Icons"
                                               Text="&#xE7B8;"
                                               FontSize="22"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Приёмка"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Sprint 6 (WMS перемещение): между ячейками внутри склада -->
                            <Button x:Name="NavTransferButton"
                                    Tag="transfer"
                                    AutomationProperties.Name="Перемещение"
                                    Style="{StaticResource MainSectionBlockButtonStyle}"
                                    Click="HandleNavButtonClick">
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Segoe Fluent Icons"
                                               Text="&#xE8AB;"
                                               FontSize="22"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Перемещение"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Sprint 7 (WMS инвентаризация): сверка факт vs система по одной ячейке -->
                            <Button x:Name="NavStockTakeButton"
                                    Tag="stocktake"
                                    AutomationProperties.Name="Инвентаризация"
                                    Style="{StaticResource MainSectionBlockButtonStyle}"
                                    Click="HandleNavButtonClick">
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontFamily="Segoe Fluent Icons"
                                               Text="&#xF0E3;"
                                               FontSize="22"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Инвентаризация"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Разделитель -->
                            <Border Height="1"
                                    Background="#E1E8F4"
                                    Margin="6,14,6,12" />

                            <!-- Сервисные иконки: Главная, Отчёты, Настройки -->
                            <UniformGrid Columns="3" HorizontalAlignment="Center">
                                <Button x:Name="NavDashboardButton"
                                        Tag="dashboard"
                                        AutomationProperties.Name="Главная"
                                        ToolTip="Главная"
                                        Style="{StaticResource MinorIconButtonStyle}"
                                        Click="HandleNavButtonClick">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" FontSize="16" />
                                </Button>
                                <Button x:Name="NavAuditButton"
                                        Tag="audit"
                                        AutomationProperties.Name="Отчёты"
                                        ToolTip="Отчёты"
                                        Style="{StaticResource MinorIconButtonStyle}"
                                        Click="HandleNavButtonClick">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D2;" FontSize="16" />
                                </Button>
                                <Button x:Name="NavSettingsButton"
                                        Tag="settings"
                                        AutomationProperties.Name="Настройки"
                                        ToolTip="Настройки"
                                        Style="{StaticResource MinorIconButtonStyle}"
                                        Click="HandleNavButtonClick">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="16" />
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <StackPanel x:Name="SidebarFooterPanel" Grid.Row="2">
                    <Border x:Name="UserProfileCard"
                            Background="#F7F9FF"
                            BorderBrush="#E6ECF8"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,18,0,0"
                            Cursor="Hand"
                            MouseLeftButtonUp="HandleUserProfileCardClick"
                            AutomationProperties.Name="Профиль пользователя">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26" Height="26" CornerRadius="13" Background="#EEF2FF" VerticalAlignment="Top">
                                <TextBlock x:Name="UserAvatarText"
                                           Text="MW"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#4F5BFF" />
                            </Border>
                            <StackPanel x:Name="UserProfileTextPanel" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock x:Name="UserDisplayNameText"
                                           Text="Major"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#24314F" />
                                <TextBlock x:Name="UserRoleText"
                                           Text="Администратор"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="#7D88A3" />
                            </StackPanel>
                            <TextBlock x:Name="UserProfileChevronText"
                                       Grid.Column="2"
                                       FontFamily="Segoe Fluent Icons"
                                       Text="&#xE70D;"
                                       FontSize="10"
                                       Foreground="#7D88A3"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border x:Name="DatabaseStatusBadge"
                            Background="#FFF4E3"
                            BorderBrush="#FFD9A3"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,12,0,0"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Источник данных">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DatabaseStatusIconText"
                                       FontFamily="Segoe Fluent Icons"
                                       Text="&#xE783;"
                                       FontSize="15"
                                       Foreground="#B76600"
                                       VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock x:Name="DatabaseStatusTitleText"
                                           Text="Локальные данные"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#24314F" />
                                <TextBlock x:Name="DatabaseStatusText"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="#6E7A96" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="UpdatePanelCard"
                            Background="#FFFFFF"
                            BorderBrush="#E6ECF8"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Обновление"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#24314F" />
                            <TextBlock x:Name="ApplicationVersionText"
                                       Margin="0,6,0,0"
                                       FontSize="11"
                                       Foreground="#6E7A96" />
                            <TextBlock x:Name="ApplicationUpdateStatusText"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="#6E7A96" />
                            <Button x:Name="UpdateApplicationButton"
                                    Margin="0,12,0,0"
                                    Height="36"
                                    Padding="12,0"
                                    BorderThickness="0"
                                    Background="#1F2A44"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="HandleUpdateApplicationClick"
                                    Content="Проверить обновления" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="HistoryButton"
                            Margin="0,14,0,0"
                            Height="36"
                            Padding="10,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#6D7892"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand"
                            AutomationProperties.Name="История посещений"
                            ToolTip="История посещений"
                            Click="HandleHistoryButtonClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE81C;"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="HistoryButtonText"
                                       Text="История посещений"
                                       Margin="10,0,0,0"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Popup x:Name="HistoryPopup"
                           PlacementTarget="{Binding ElementName=HistoryButton}"
                           Placement="Right"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="#FFFFFF"
                                BorderBrush="#E4EAF5"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8"
                                MinWidth="280"
                                MaxWidth="380">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Opacity="0.18" ShadowDepth="2" Color="#1B2440" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="История"
                                           Margin="6,4,6,6"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#17213A" />
                                <ItemsControl x:Name="HistoryItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Key}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="6,6"
                                                    Cursor="Hand"
                                                    Click="HandleHistoryItemClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="13"
                                                               Foreground="#4F5BFF"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Caption}"
                                                               FontSize="13"
                                                               Foreground="#17213A"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="HistoryEmptyText"
                                           Margin="6,4,6,6"
                                           FontSize="12"
                                           Foreground="#7A86A5"
                                           Text="История пуста — посетите несколько разделов."
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <!-- 1С-style nav toolbar: Назад / Вперёд / Избранное (звезда) -->
            <Border Grid.Row="0"
                    Margin="18,14,18,0"
                    Padding="6,4"
                    Background="#FFFFFF"
                    BorderBrush="#E4EAF5"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavBackButton"
                            Width="32" Height="28"
                            Margin="2,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Назад"
                            AutomationProperties.Name="Назад"
                            Click="HandleNavBackClick">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   Text="&#xE72B;"
                                   FontSize="14"
                                   Foreground="#4F5BFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="NavForwardButton"
                            Width="32" Height="28"
                            Margin="2,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Вперёд"
                            AutomationProperties.Name="Вперёд"
                            Click="HandleNavForwardClick">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   Text="&#xE72A;"
                                   FontSize="14"
                                   Foreground="#9CADD4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   x:Name="NavForwardIconText" />
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="#E4EAF5" Margin="6,0" />
                    <Button x:Name="FavoriteButton"
                            Width="32" Height="28"
                            Margin="2,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Добавить в избранное"
                            AutomationProperties.Name="Избранное"
                            Click="HandleFavoriteClick">
                        <TextBlock x:Name="FavoriteIconText"
                                   FontFamily="Segoe Fluent Icons"
                                   Text="&#xE734;"
                                   FontSize="14"
                                   Foreground="#9CADD4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                    <TextBlock x:Name="NavCurrentTabText"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#6E7B98" />

                    <!-- Spacer чтобы поиск ушёл вправо -->
                    <StackPanel Width="0" />
                </StackPanel>
            </Border>

            <!-- Поиск по системе — поверх правого края nav toolbar -->
            <Border Grid.Row="0"
                    Margin="0,14,30,0"
                    Height="36"
                    Width="320"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#FFFFFF"
                    BorderBrush="#E4EAF5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               FontFamily="Segoe Fluent Icons"
                               Text="&#xE721;"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="#7A86A5"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="GlobalSearchBox"
                             Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             Foreground="#1B2440"
                             KeyDown="HandleGlobalSearchKeyDown" />
                    <TextBlock Grid.Column="1"
                               x:Name="GlobalSearchPlaceholder"
                               Text="Поиск по системе…"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#A5B0CC"
                               IsHitTestVisible="False"
                               Margin="2,0,0,0" />
                    <Button Grid.Column="2"
                            x:Name="GlobalSearchClearButton"
                            Width="22" Height="22"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="HandleGlobalSearchClearClick"
                            ToolTip="Очистить поиск">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   Text="&#xE711;"
                                   FontSize="11"
                                   Foreground="#A5B0CC"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,8,18,18">
                <TabControl x:Name="WorkspaceTabs"
                            SelectionChanged="HandleWorkspaceTabsSelectionChanged"
                            Background="Transparent"
                            BorderBrush="Transparent">
                    <!-- Tab strip headers скрыты: переключение через nav toolbar / sidebar / историю -->
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                </TabControl>
            </Grid>

            <Grid Grid.Row="2" Visibility="Collapsed">
                <TextBlock x:Name="CurrentSectionTitleText" />
                <TextBlock x:Name="CurrentSectionSubtitleText" />
            </Grid>
        </Grid>
    </Grid>
</Window>
