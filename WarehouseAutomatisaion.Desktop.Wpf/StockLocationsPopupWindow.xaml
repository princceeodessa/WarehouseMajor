<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.StockLocationsPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Размещение по ячейкам"
        Height="560" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FD"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
    </Window.Resources>

    <DockPanel Margin="12" LastChildFill="True">

        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="10"
                Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="HeaderText"
                           FontWeight="SemiBold" FontSize="15" />
                <TextBlock x:Name="SubheaderText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="10"
                Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
                <Button x:Name="CloseButton" Grid.Column="1"
                        Content="Закрыть"
                        Height="34" Padding="20,0"
                        Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Cursor="Hand"
                        IsCancel="True"
                        Click="OnCloseClicked" />
            </Grid>
        </Border>

        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="LocationsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource LineBrush}"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="28"
                      ColumnHeaderHeight="32"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      FontSize="12.5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Склад" Binding="{Binding WarehouseName}" Width="180" />
                    <DataGridTextColumn Header="Ячейка" Binding="{Binding StorageCellCode}" Width="140" />
                    <DataGridTextColumn Header="Код" Binding="{Binding ItemCode}" Width="120" />
                    <DataGridTextColumn Header="Товар" Binding="{Binding ItemName}" Width="*" />
                    <DataGridTextColumn Header="Кол-во"
                                        Binding="{Binding Quantity, StringFormat=N3}"
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Резерв"
                                        Binding="{Binding ReservedQuantity, StringFormat=N3}"
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Последнее движение"
                                        Binding="{Binding LastMovementAtUtc, StringFormat='dd.MM HH:mm'}"
                                        Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter Property="FontSize" Value="11.5" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
