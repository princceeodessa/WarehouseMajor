<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.SalesReturnEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Возврат покупателя"
        Width="1040"
        Height="760"
        MinWidth="920"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F6F8FC">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource DialogCardStyle}" />
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogFieldLabelStyle}" />
        <Style x:Key="InputStyle" TargetType="Control" BasedOn="{StaticResource DialogInputStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}" />
        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}" />
        <Style TargetType="DataGrid" BasedOn="{StaticResource DialogDataGridStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DialogDataGridHeaderStyle}" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="HeaderTitleText"
                       FontSize="27"
                       FontWeight="SemiBold"
                       Foreground="#17213A" />
            <TextBlock x:Name="HeaderSubtitleText"
                       Margin="0,6,0,0"
                       FontSize="13.5"
                       Foreground="#6E7B98"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="18"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Номер" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="NumberTextBox" Style="{StaticResource InputStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Дата возврата" Style="{StaticResource FieldLabelStyle}" />
                    <DatePicker x:Name="ReturnDatePicker" Style="{StaticResource InputStyle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,14">
                    <TextBlock Text="Статус" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="StatusComboBox" Style="{StaticResource InputStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Заказ-основание" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="OrderTextBox" Style="{StaticResource InputStyle}" IsReadOnly="True" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Клиент" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="CustomerTextBox" Style="{StaticResource InputStyle}" IsReadOnly="True" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,14">
                    <TextBlock Text="Склад" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="WarehouseComboBox" Style="{StaticResource InputStyle}" IsEditable="True" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Менеджер" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ManagerComboBox" Style="{StaticResource InputStyle}" IsEditable="True" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3">
                    <TextBlock Text="Причина возврата" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="ReasonTextBox" Style="{StaticResource InputStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="18"
                Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Позиции возврата" FontSize="18" FontWeight="SemiBold" Foreground="#17213A" />
                        <TextBlock Text="Строки подтянуты из заказа или отгрузки; лишние позиции можно удалить, количество изменить."
                                   Margin="0,4,0,0"
                                   FontSize="12.5"
                                   Foreground="#6E7B98"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Вернуть позиции заказа"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,10,0"
                                Click="HandleRestoreOrderLinesClick" />
                        <Button Content="Изменить"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,10,0"
                                Click="HandleEditLineClick" />
                        <Button Content="Удалить"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="HandleRemoveLineClick" />
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="LinesGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          MouseDoubleClick="HandleLinesGridDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding ItemCode}" Width="1*" />
                        <DataGridTextColumn Header="Товар" Binding="{Binding ItemName}" Width="2.8*" />
                        <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="0.55*" />
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding QuantityDisplay}" Width="0.75*" />
                        <DataGridTextColumn Header="Цена" Binding="{Binding PriceDisplay}" Width="0.9*" />
                        <DataGridTextColumn Header="Сумма" Binding="{Binding AmountDisplay}" Width="0.9*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TotalText"
                           Grid.Row="2"
                           Margin="0,12,0,0"
                           FontSize="13.5"
                           Foreground="#34415F"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Padding="18"
                Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Комментарий к возврату" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="CommentTextBox"
                         Style="{StaticResource DialogMultilineTextBoxStyle}"
                         Height="78"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ValidationText"
                       VerticalAlignment="Center"
                       Foreground="#D92D20"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Width="120"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="0,0,10,0"
                        Click="HandleCancelClick" />
                <Button Content="Сохранить возврат"
                        Width="170"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="HandleSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
