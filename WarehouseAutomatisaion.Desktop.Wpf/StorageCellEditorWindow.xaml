<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.StorageCellEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ячейка склада"
        Height="600" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F7F9FD"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,12,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16" LastChildFill="True">

        <!-- Footer buttons -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />

                <Button x:Name="CancelButton" Grid.Column="1"
                        Content="Отмена" Height="34" Padding="18,0"
                        Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Cursor="Hand"
                        Click="OnCancelClicked" />

                <Button x:Name="SaveButton" Grid.Column="2"
                        Content="💾 Сохранить" Height="34" Padding="20,0" Margin="10,0,0,0"
                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        Click="OnSaveClicked" />
            </Grid>
        </Border>

        <!-- Form -->
        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Row 0: Warehouse + Code -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Склад: *" Style="{StaticResource Label}" />
                <TextBox x:Name="WarehouseNameBox" Grid.Row="0" Grid.Column="1" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Код ячейки: *" Style="{StaticResource Label}" Margin="12,4,12,4" />
                <TextBox x:Name="CodeBox" Grid.Row="0" Grid.Column="3" />

                <!-- Row 1: Zone code + name -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Код зоны:" Style="{StaticResource Label}" />
                <TextBox x:Name="ZoneCodeBox" Grid.Row="1" Grid.Column="1" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Имя зоны:" Style="{StaticResource Label}" Margin="12,4,12,4" />
                <TextBox x:Name="ZoneNameBox" Grid.Row="1" Grid.Column="3" />

                <!-- Row 2: Row/Rack/Shelf/Cell -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Адрес:" Style="{StaticResource Label}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <TextBlock Text="Ряд" Style="{StaticResource Label}" Margin="0,4,8,4" />
                    <TextBox x:Name="RowNoBox" Width="60" Text="0" />
                    <TextBlock Text="Стеллаж" Style="{StaticResource Label}" Margin="14,4,8,4" />
                    <TextBox x:Name="RackNoBox" Width="60" Text="0" />
                    <TextBlock Text="Полка" Style="{StaticResource Label}" Margin="14,4,8,4" />
                    <TextBox x:Name="ShelfNoBox" Width="60" Text="0" />
                    <TextBlock Text="Ячейка" Style="{StaticResource Label}" Margin="14,4,8,4" />
                    <TextBox x:Name="CellNoBox" Width="60" Text="0" />
                </StackPanel>

                <!-- Row 3: Type + Status -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Тип:" Style="{StaticResource Label}" />
                <ComboBox x:Name="CellTypeCombo" Grid.Row="3" Grid.Column="1" IsEditable="True" />

                <TextBlock Grid.Row="3" Grid.Column="2" Text="Статус:" Style="{StaticResource Label}" Margin="12,4,12,4" />
                <ComboBox x:Name="StatusCombo" Grid.Row="3" Grid.Column="3" IsEditable="True" />

                <!-- Row 4: Capacity -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Capacity:" Style="{StaticResource Label}" />
                <TextBox x:Name="CapacityBox" Grid.Row="4" Grid.Column="1" Text="0" />

                <TextBlock Grid.Row="4" Grid.Column="2" Text="(ед. объёма/веса)"
                           Grid.ColumnSpan="2" Style="{StaticResource Label}" Margin="12,4,12,4"
                           FontStyle="Italic" />

                <!-- Row 5: Comment -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Комментарий:" Style="{StaticResource Label}" />
                <TextBox x:Name="CommentBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                         VerticalContentAlignment="Top" Padding="8,6" />

                <!-- Row 6: Audit info -->
                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4"
                           x:Name="AuditText" Style="{StaticResource Label}"
                           Margin="0,16,0,0"
                           FontSize="11" FontStyle="Italic" />
            </Grid>
        </Border>

    </DockPanel>
</Window>
