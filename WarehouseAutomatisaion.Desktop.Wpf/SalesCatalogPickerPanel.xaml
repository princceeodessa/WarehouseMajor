<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.SalesCatalogPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFCF0">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PickerSectionBg" Color="#FFFCF0" />
        <SolidColorBrush x:Key="PickerCartBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PickerCartRowAlt" Color="#FFF7D7" />
        <SolidColorBrush x:Key="PickerCartRowSelected" Color="#FFE399" />
        <SolidColorBrush x:Key="PickerCatalogActive" Color="#3E8B33" />
        <SolidColorBrush x:Key="PickerCatalogInactive" Color="#C53030" />
        <SolidColorBrush x:Key="PickerBorder" Color="#D9DEE7" />
        <SolidColorBrush x:Key="PickerSubtleText" Color="#6E7B98" />
        <SolidColorBrush x:Key="PickerSectionHeader" Color="#3E8B33" />
        <SolidColorBrush x:Key="PickerPrimaryYellow" Color="#FFC845" />
        <SolidColorBrush x:Key="PickerPrimaryYellowHover" Color="#F5B82E" />

        <Style x:Key="PickerSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PickerSectionHeader}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PickerYellowButtonStyle" TargetType="Button" BasedOn="{StaticResource OneCToolbarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PickerPrimaryYellow}" />
            <Setter Property="BorderBrush" Value="#E0A828" />
            <Setter Property="Foreground" Value="#17213A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PickerPrimaryYellowHover}" />
                    <Setter Property="BorderBrush" Value="#D49C20" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E5A820" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F4E8C3" />
                    <Setter Property="BorderBrush" Value="#E2D5A8" />
                    <Setter Property="Foreground" Value="#9C8E5C" />
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PickerCartGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{StaticResource PickerCartBg}" />
            <Setter Property="RowHeight" Value="26" />
            <Setter Property="ColumnHeaderHeight" Value="26" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PickerCartHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F6FA" />
            <Setter Property="BorderBrush" Value="{StaticResource PickerBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Foreground" Value="#5A6680" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="PickerCartRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2FA" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7D7" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PickerCartRowSelected}" />
                    <Setter Property="Foreground" Value="#17213A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PickerCartCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerCatalogGridStyle" TargetType="DataGrid" BasedOn="{StaticResource PickerCartGridStyle}">
            <Setter Property="RowHeight" Value="22" />
            <Setter Property="ColumnHeaderHeight" Value="24" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PickerSectionBg}"
            BorderBrush="{StaticResource PickerBorder}"
            BorderThickness="1,0,0,0">
        <Grid Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Заголовок ===== -->
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
                <Button x:Name="CloseButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource OneCToolbarIconButtonStyle}"
                        Width="24" Height="24"
                        Padding="0"
                        ToolTip="Скрыть подбор"
                        Click="HandleCloseClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="11" />
                </Button>
                <TextBlock Text="Подбор номенклатуры"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#17213A"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- ===== Корзина: таблица выбранных позиций ===== -->
            <Border Grid.Row="1"
                    Background="{StaticResource PickerCartBg}"
                    BorderBrush="{StaticResource PickerBorder}"
                    BorderThickness="1"
                    CornerRadius="2"
                    MinHeight="120"
                    MaxHeight="200">
                <DataGrid x:Name="CartGrid"
                          Style="{StaticResource PickerCartGridStyle}"
                          ColumnHeaderStyle="{StaticResource PickerCartHeaderStyle}"
                          RowStyle="{StaticResource PickerCartRowStyle}"
                          CellStyle="{StaticResource PickerCartCellStyle}"
                          SelectionChanged="HandleCartSelectionChanged"
                          MouseDoubleClick="HandleCartGridDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Номенклатура" Width="2.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ItemName}"
                                               Padding="0,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Количество" Binding="{Binding QuantityDisplay}" Width="0.7*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="0.4*" />
                        <DataGridTextColumn Header="Цена" Binding="{Binding PriceDisplay}" Width="0.8*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding AmountDisplay}" Width="0.9*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ===== Кнопки управления корзиной ===== -->
            <DockPanel Grid.Row="2" Margin="0,10,0,10" LastChildFill="True">
                <TextBlock x:Name="CartSummaryText"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PickerSubtleText}"
                           FontSize="12" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TransferButton"
                            Content="Перенести в документ"
                            Style="{StaticResource PickerYellowButtonStyle}"
                            MinWidth="190"
                            Margin="0,0,8,0"
                            Click="HandleTransferClick" />
                    <Button x:Name="ClearButton"
                            Content="Очистить"
                            Style="{StaticResource OneCToolbarButtonStyle}"
                            Height="30"
                            Padding="14,4"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="HandleClearCartClick" />
                </StackPanel>
            </DockPanel>

            <!-- ===== Поиск ===== -->
            <Border Grid.Row="3"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource PickerBorder}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Margin="0,0,0,10">
                <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Номенклатура" Foreground="{StaticResource PickerSubtleText}" FontSize="11.5" Margin="0,0,0,3" />
                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="QuantityLabelText" Text="Количество" Foreground="{StaticResource PickerSubtleText}" FontSize="11.5" Margin="0,0,0,3" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Цена" Foreground="{StaticResource PickerSubtleText}" FontSize="11.5" Margin="0,0,0,3" />

                    <TextBox Grid.Row="1" Grid.Column="0"
                             x:Name="SearchTextBox"
                             Height="26"
                             Padding="6,3"
                             FontSize="12.5"
                             BorderBrush="{StaticResource PickerBorder}"
                             VerticalContentAlignment="Center"
                             TextChanged="HandleSearchTextChanged" />
                    <TextBox Grid.Row="1" Grid.Column="2"
                             x:Name="QuantityTextBox"
                             Height="26"
                             Padding="6,3"
                             FontSize="12.5"
                             BorderBrush="{StaticResource PickerBorder}"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center"
                             Text="1" />
                    <TextBox Grid.Row="1" Grid.Column="4"
                             x:Name="PriceTextBox"
                             Height="26"
                             Padding="6,3"
                             FontSize="12.5"
                             BorderBrush="{StaticResource PickerBorder}"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center"
                             Text="0,00" />
                </Grid>
            </Border>

            <!-- ===== Фильтры (collapsible) ===== -->
            <Border Grid.Row="4"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource PickerBorder}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Margin="0,0,0,8">
                <StackPanel>
                    <ToggleButton x:Name="FiltersToggle"
                                  IsChecked="False"
                                  Checked="HandleFiltersToggleChanged"
                                  Unchecked="HandleFiltersToggleChanged"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="8,6"
                                  HorizontalContentAlignment="Left"
                                  Cursor="Hand"
                                  Foreground="{StaticResource PickerSectionHeader}"
                                  FontSize="12.5"
                                  FontWeight="SemiBold">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ArrowText"
                                                   Text="▸"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource PickerSectionHeader}"
                                                   Margin="0,0,6,0" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="ArrowText" Property="Text" Value="▾" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <TextBlock Text="Фильтры (Запас)" />
                    </ToggleButton>
                    <Border x:Name="FiltersPanel"
                            Visibility="Collapsed"
                            Padding="14,4,14,10"
                            BorderBrush="{StaticResource PickerBorder}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox x:Name="StockFilterCheck" Content="Остатки" IsChecked="True" Style="{StaticResource OneCFilterCheckBoxStyle}" Margin="0,0,8,0" Click="HandleFilterChanged" />
                                <ComboBox x:Name="StockFilterCombo" Style="{StaticResource OneCFilterComboBoxStyle}" Width="150" SelectionChanged="HandleFilterChanged">
                                    <ComboBoxItem Content="Все" IsSelected="True" />
                                    <ComboBoxItem Content="Только в наличии" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox x:Name="StorageKindCheck" Content="Запас" IsChecked="True" Style="{StaticResource OneCFilterCheckBoxStyle}" Margin="0,0,12,0" Click="HandleFilterChanged" />
                                <CheckBox x:Name="ServiceKindCheck" Content="Услуга" IsChecked="True" Style="{StaticResource OneCFilterCheckBoxStyle}" Margin="0,0,12,0" Click="HandleFilterChanged" />
                                <CheckBox x:Name="WorkKindCheck" Content="Работа" IsChecked="True" Style="{StaticResource OneCFilterCheckBoxStyle}" Click="HandleFilterChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Тулбар каталога ===== -->
            <DockPanel Grid.Row="5" Margin="0,0,0,6" LastChildFill="True">
                <TextBlock x:Name="ResultCountText"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PickerSubtleText}"
                           FontSize="11.5"
                           Margin="2,0,0,0" />
                <TextBlock x:Name="SelectedItemText"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="#17213A"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="320" />
            </DockPanel>

            <!-- ===== Каталог ===== -->
            <Border Grid.Row="6"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource PickerBorder}"
                    BorderThickness="1"
                    CornerRadius="2">
                <DataGrid x:Name="CatalogGrid"
                          Style="{StaticResource PickerCatalogGridStyle}"
                          ColumnHeaderStyle="{StaticResource PickerCartHeaderStyle}"
                          RowStyle="{StaticResource PickerCartRowStyle}"
                          CellStyle="{StaticResource PickerCartCellStyle}"
                          SelectionChanged="HandleCatalogSelectionChanged"
                          MouseDoubleClick="HandleCatalogGridDoubleClick"
                          KeyDown="HandleCatalogGridKeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Наименование" Width="2.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{Binding NameBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"
                                               Padding="0,1" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="0.4*" />
                        <DataGridTextColumn Header="Цена" Binding="{Binding PriceDisplay}" Width="0.7*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Артикул" Binding="{Binding Code}" Width="0.7*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Border>
</UserControl>
