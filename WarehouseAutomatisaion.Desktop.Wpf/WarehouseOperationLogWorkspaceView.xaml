<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.WarehouseOperationLogWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1120"
             Loaded="OnLoaded"
             Background="#F7F9FD">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#17213A" />
    </UserControl.Resources>

    <DockPanel Margin="18" LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Журнал операций"
                               Foreground="{StaticResource HeadingBrush}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Сканы, приёмка, перемещения, инвентаризации и служебные WMS-события."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,4,0,0" />
                </StackPanel>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Height="36"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="{StaticResource LineBrush}"
                         ToolTip="Поиск по пользователю, операции, документу или сообщению"
                         TextChanged="OnSearchChanged" />

                <Button Grid.Column="2"
                        Content="Обновить"
                        Height="36"
                        Padding="18,0"
                        Margin="10,0,0,0"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="OnRefreshClicked" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,12,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Загрузка..." />
        </Border>

        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <DataGrid x:Name="LogGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource LineBrush}"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="30"
                      ColumnHeaderHeight="34"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      FontSize="12.5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Время" Binding="{Binding LoggedAtText}" Width="120" />
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding ActorUserName}" Width="130" />
                    <DataGridTextColumn Header="Объект" Binding="{Binding EntityType}" Width="120" />
                    <DataGridTextColumn Header="Номер" Binding="{Binding EntityNumber}" Width="130" />
                    <DataGridTextColumn Header="Операция" Binding="{Binding ActionText}" Width="170" />
                    <DataGridTextColumn Header="Результат" Binding="{Binding ResultText}" Width="120" />
                    <DataGridTextColumn Header="Сообщение" Binding="{Binding MessageText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
