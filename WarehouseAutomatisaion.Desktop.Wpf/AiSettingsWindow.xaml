<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Настройки AI"
        Height="660" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FD"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#17213A" />
    </Window.Resources>

    <DockPanel Margin="16" LastChildFill="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="12"
                Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⚙ Настройки AI"
                           Foreground="{StaticResource HeadingBrush}"
                           FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Введи API-ключи для AI-функций. Ключи хранятся локально в %LOCALAPPDATA%\Major\appsettings.local.json и НЕ передаются никому кроме самих провайдеров."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11.5" Margin="0,5,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="12"
                Padding="14,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0" />
                <Button x:Name="CancelButton" Grid.Column="1"
                        Content="Отмена" Height="34" Padding="18,0"
                        Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Cursor="Hand" IsCancel="True"
                        Click="OnCancelClicked" />
                <Button x:Name="SaveButton" Grid.Column="2"
                        Content="✓ Сохранить и применить"
                        Height="34" Padding="20,0" Margin="10,0,0,0"
                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold" IsDefault="True"
                        Click="OnSaveClicked" />
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Anthropic block -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="16,14" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🤖 Anthropic Claude"
                                       Foreground="{StaticResource HeadingBrush}"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border x:Name="AnthropicStatusBadge"
                                    Margin="10,0,0,0"
                                    Padding="8,2"
                                    Background="#F1F4FA"
                                    BorderBrush="#D7DEEC"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="AnthropicStatusBadgeText"
                                           Text="не задан"
                                           Foreground="#6E7B98"
                                           FontSize="10.5"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Используется для: AI Chat «Спроси склад», распознавание накладных (Claude Vision), фото-инвентаризация полки."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5" Margin="0,0,0,10"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="API ключ (начинается с sk-ant-api03-...)"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="AnthropicKeyBox"
                                         Grid.Column="0"
                                         Height="34" Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                         FontFamily="Cascadia Mono, Consolas"
                                         PasswordChanged="OnAnthropicKeyChanged" />
                            <Button Grid.Column="1"
                                    x:Name="AnthropicShowButton"
                                    Content="👁"
                                    Height="34" Width="40" Margin="6,0,0,0"
                                    Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" Cursor="Hand"
                                    ToolTip="Показать/скрыть ключ"
                                    Click="OnAnthropicShowClicked" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Модель"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11.5" Margin="0,0,0,4" />
                                <ComboBox x:Name="AnthropicModelCombo"
                                          Height="34" Padding="10,0"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="claude-opus-4-7" Tag="claude-opus-4-7" IsSelected="True" />
                                    <ComboBoxItem Content="claude-opus-4-6" Tag="claude-opus-4-6" />
                                    <ComboBoxItem Content="claude-sonnet-4-6" Tag="claude-sonnet-4-6" />
                                    <ComboBoxItem Content="claude-haiku-4-5" Tag="claude-haiku-4-5" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Max tokens"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11.5" Margin="0,0,0,4" />
                                <TextBox x:Name="AnthropicMaxTokensBox"
                                         Height="34" Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                         Text="8192" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OpenAI block -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="16,14" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🌐 OpenAI"
                                       Foreground="{StaticResource HeadingBrush}"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border x:Name="OpenAiStatusBadge"
                                    Margin="10,0,0,0"
                                    Padding="8,2"
                                    Background="#F1F4FA"
                                    BorderBrush="#D7DEEC"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="OpenAiStatusBadgeText"
                                           Text="не задан"
                                           Foreground="#6E7B98"
                                           FontSize="10.5"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Используется для: AI embedding search (text-embedding-3-small) — семантический матчинг каталога. Опционально — GPT-4o vision как альтернатива Claude."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5" Margin="0,0,0,10"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="API ключ (sk-proj-... или sk-...)"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="OpenAiKeyBox"
                                         Grid.Column="0"
                                         Height="34" Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                         FontFamily="Cascadia Mono, Consolas"
                                         PasswordChanged="OnOpenAiKeyChanged" />
                            <Button Grid.Column="1"
                                    x:Name="OpenAiShowButton"
                                    Content="👁"
                                    Height="34" Width="40" Margin="6,0,0,0"
                                    Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" Cursor="Hand"
                                    ToolTip="Показать/скрыть ключ"
                                    Click="OnOpenAiShowClicked" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Default provider -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="16,14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Провайдер по умолчанию"
                                   Foreground="{StaticResource HeadingBrush}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Какой LLM использовать для распознавания накладных по умолчанию."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5" Margin="0,0,0,10"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DefaultAnthropicRadio"
                                         GroupName="DefaultProvider"
                                         Content="Anthropic Claude"
                                         IsChecked="True"
                                         Margin="0,0,20,0" />
                            <RadioButton x:Name="DefaultOpenAiRadio"
                                         GroupName="DefaultProvider"
                                         Content="OpenAI GPT-4o" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Info -->
                <Border Background="#F4F7FF"
                        BorderBrush="#C8D1FF"
                        BorderThickness="1" CornerRadius="10"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="ℹ Где взять ключи"
                                   FontWeight="SemiBold"
                                   Foreground="#2F3F74" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11.5"
                                   Foreground="#2F3F74"
                                   TextWrapping="Wrap">
                            <Run Text="• Anthropic Claude:" FontWeight="SemiBold" />
                            <Run Text=" console.anthropic.com → Settings → API Keys → «Create Key»" />
                            <LineBreak />
                            <Run Text="• OpenAI:" FontWeight="SemiBold" />
                            <Run Text=" platform.openai.com → API keys → «Create new secret key»" />
                            <LineBreak /><LineBreak />
                            <Run Text="Ключи сохраняются на этой машине." FontWeight="SemiBold" />
                            <Run Text=" Не попадают в git, не публикуются. Major НЕ передаёт ключи никому кроме самих провайдеров." />
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
