<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.QuickScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WMS скан"
        Height="680"
        Width="920"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FD"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#17213A" />
    </Window.Resources>

    <DockPanel Margin="14" LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Быстрый WMS-скан"
                           Foreground="{StaticResource HeadingBrush}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="Сканируйте штрихкод товара, код товара или QR ячейки. Enter сразу запускает поиск."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11.5"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ScanTextBox"
                         Grid.Column="0"
                         Height="38"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         FontSize="15"
                         BorderBrush="{StaticResource LineBrush}"
                         ToolTip="Фокус остаётся здесь после каждого поиска, можно сканировать подряд"
                         KeyDown="OnScanKeyDown" />

                <Button x:Name="SearchButton"
                        Grid.Column="1"
                        Content="Найти"
                        Height="38"
                        Padding="20,0"
                        Margin="10,0,0,0"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="OnSearchClicked" />

                <Button Grid.Column="2"
                        Content="Очистить"
                        Height="38"
                        Padding="16,0"
                        Margin="8,0,0,0"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnClearClicked" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Готово к сканированию."
                           TextWrapping="Wrap"
                           Margin="0,0,12,0" />
                <Button x:Name="OpenPopupButton"
                        Grid.Column="1"
                        Content="Открыть список"
                        Height="34"
                        Padding="16,0"
                        Margin="0,0,10,0"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="OnOpenPopupClicked" />
                <Button Grid.Column="2"
                        Content="Закрыть"
                        Height="34"
                        Padding="20,0"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="OnCloseClicked" />
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultKindText"
                               Grid.Column="0"
                               Text="Нет скана"
                               Foreground="{StaticResource MutedBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ResultTitleText"
                                   Text="Отсканируйте товар или ячейку"
                                   Foreground="{StaticResource HeadingBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ResultSubtitleText"
                                   Text="Результат появится здесь."
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <DataGrid x:Name="LocationsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource LineBrush}"
                          IsReadOnly="True"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="28"
                          ColumnHeaderHeight="32"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True"
                          FontSize="12.5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Склад" Binding="{Binding WarehouseName}" Width="170" />
                        <DataGridTextColumn Header="Ячейка" Binding="{Binding StorageCellCode}" Width="130" />
                        <DataGridTextColumn Header="Код" Binding="{Binding ItemCode}" Width="120" />
                        <DataGridTextColumn Header="Товар" Binding="{Binding ItemName}" Width="*" />
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat=N3}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Резерв" Binding="{Binding ReservedQuantity, StringFormat=N3}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="0,0,8,0" />
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
