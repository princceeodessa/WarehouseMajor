<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.ContractorsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F7F9FD">
    <UserControl.Resources>
        <Style x:Key="ContractorsGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="ContractorsHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F4F9" />
            <Setter Property="BorderBrush" Value="#D7DEEC" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Foreground" Value="#3A4868" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="ContractorsRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2FA" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="#17213A" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFF" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBE3FF" />
                    <Setter Property="Foreground" Value="#17213A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ContractorsCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#17213A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeFilterCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#2F6BB8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,22,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,8,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Type filters + search (1С: сразу под глобальным nav toolbar, без своего header) -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <CheckBox x:Name="BuyersCheckBox" Content="Покупатели" IsChecked="True" Style="{StaticResource TypeFilterCheckBoxStyle}" Checked="HandleTypeChanged" Unchecked="HandleTypeChanged" />
                <CheckBox x:Name="SuppliersCheckBox" Content="Поставщики" Style="{StaticResource TypeFilterCheckBoxStyle}" Checked="HandleTypeChanged" Unchecked="HandleTypeChanged" />
                <CheckBox x:Name="OthersCheckBox" Content="Прочие" Style="{StaticResource TypeFilterCheckBoxStyle}" Checked="HandleTypeChanged" Unchecked="HandleTypeChanged" />
            </WrapPanel>
            <Border Grid.Column="1"
                    Width="280"
                    Height="32"
                    Background="#FFFFFF"
                    BorderBrush="#D7DEEC"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="12,0" FontSize="12.5" TextChanged="HandleSearchChanged" />
                    <TextBlock x:Name="SearchPlaceholderText" Grid.Column="0" Text="Search (Ctrl+F)" IsHitTestVisible="False" Foreground="#9AA4BC" VerticalAlignment="Center" Margin="14,0" />
                    <TextBlock Grid.Column="1" FontFamily="Segoe Fluent Icons" Text="&#xE721;" Foreground="#9AA4BC" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" />
                </Grid>
            </Border>
        </Grid>

        <!-- 1С-style toolbar -->
        <Border Grid.Row="1"
                Background="{StaticResource OneCToolbarBg}"
                BorderBrush="{StaticResource OneCToolbarBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6,5"
                Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="Создать" Style="{StaticResource OneCPrimaryToolbarButtonStyle}" Margin="0,0,6,0" Click="HandleCreateClick" />
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,10,0" ToolTip="Быстрое добавление" Click="HandleCreateClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="12" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,4,0" ToolTip="Действия с выделенным" Click="HandleRowActionsClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE712;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,4,0" ToolTip="Фильтр">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71C;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,10,0" ToolTip="Печать">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE749;" FontSize="13" />
                </Button>
                <Button Content="Продать ▾" Style="{StaticResource OneCToolbarButtonStyle}" Margin="0,0,4,0" ToolTip="Создать продажу для выделенного клиента" Click="HandleSellClick" />
                <Button Content="Купить ▾" Style="{StaticResource OneCToolbarButtonStyle}" Margin="0,0,4,0" ToolTip="Создать закупку у выделенного поставщика" Click="HandleBuyClick" />
                <Button Content="События ▾" Style="{StaticResource OneCToolbarButtonStyle}" Margin="0,0,10,0" ToolTip="Журнал событий" Click="HandleEventsClick" />
                <Button Content="Проверка контрагента" Style="{StaticResource OneCToolbarButtonStyle}" Margin="0,0,4,0" ToolTip="Валидация ИНН (в разработке)" Click="HandleExternalServiceClick" Tag="check" />
                <Button Content="1СПАРК Риски" Style="{StaticResource OneCToolbarButtonStyle}" Margin="0,0,10,0" ToolTip="Интеграция СПАРК (в разработке)" Click="HandleExternalServiceClick" Tag="spark" />
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" ToolTip="Дополнительные действия" Click="HandleMoreClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE712;" FontSize="13" />
                </Button>
            </WrapPanel>
        </Border>

        <!-- Main content: grid + right panel (1С) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E7ECF7" BorderThickness="1" CornerRadius="0" Padding="0" Margin="0,0,12,0">
                <DataGrid x:Name="ContractorsGrid"
                          Style="{StaticResource ContractorsGridStyle}"
                          ColumnHeaderStyle="{StaticResource ContractorsHeaderStyle}"
                          RowStyle="{StaticResource ContractorsRowStyle}"
                          CellStyle="{StaticResource ContractorsCellStyle}"
                          AlternationCount="2"
                          SelectionChanged="HandleSelectionChanged"
                          MouseDoubleClick="HandleGridDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="32" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="{Binding KindIcon}" Foreground="{Binding KindIconBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Представление" Width="*" MinWidth="220" IsReadOnly="True" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Основной контакт" Width="220" IsReadOnly="True" SortMemberPath="MainContact">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MainContact}" VerticalAlignment="Center" Foreground="#5F6F95" TextTrimming="CharacterEllipsis" ToolTip="{Binding MainContact}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Долг (+ нам, - мы)" Binding="{Binding DebtDisplay}" Width="140" IsReadOnly="True" />
                        <DataGridTextColumn Header="ЭДО" Binding="{Binding EdoStatus}" Width="100" IsReadOnly="True" />
                        <DataGridTemplateColumn Width="36" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="HandleRowMenuClick" ToolTip="Действия">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE712;" FontSize="11" Foreground="#5F7DA8" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Right side panel (1С): Период, Тег, Сегмент, Источник, Контакт, Ответственный, +фильтры, Иерархия, Контактная информация -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Период: за все время" Foreground="#4F5BFF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" Cursor="Hand" />

                    <TextBlock Text="Тег" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                    <Border Height="28" Background="#FFFFFF" BorderBrush="#D7DEEC" BorderThickness="1" CornerRadius="3" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock x:Name="TagText" VerticalAlignment="Center" Padding="8,0" Foreground="#1B2440" FontSize="12" Text="" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE70D;" FontSize="10" Foreground="#9AA4BC" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Сегмент" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                    <Border Height="28" Background="#FFFFFF" BorderBrush="#D7DEEC" BorderThickness="1" CornerRadius="3" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock x:Name="SegmentText" VerticalAlignment="Center" Padding="8,0" Foreground="#1B2440" FontSize="12" Text="" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE70D;" FontSize="10" Foreground="#9AA4BC" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Источник привлечения" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                    <Border Height="28" Background="#FFFFFF" BorderBrush="#D7DEEC" BorderThickness="1" CornerRadius="3" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock x:Name="SourceText" VerticalAlignment="Center" Padding="8,0" Foreground="#1B2440" FontSize="12" Text="" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE70D;" FontSize="10" Foreground="#9AA4BC" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Контакт" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                    <Border Height="28" Background="#FFFFFF" BorderBrush="#D7DEEC" BorderThickness="1" CornerRadius="3" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock x:Name="ContactText" VerticalAlignment="Center" Padding="8,0" Foreground="#1B2440" FontSize="12" Text="" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE70D;" FontSize="10" Foreground="#9AA4BC" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Ответственный" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                    <Border Height="28" Background="#FFFFFF" BorderBrush="#D7DEEC" BorderThickness="1" CornerRadius="3" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock x:Name="ResponsibleText" VerticalAlignment="Center" Padding="8,0" Foreground="#1B2440" FontSize="12" Text="" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE70D;" FontSize="10" Foreground="#9AA4BC" />
                        </Grid>
                    </Border>

                    <TextBlock Text="+ фильтры" Foreground="#4F5BFF" FontSize="12" Margin="0,0,0,14" Cursor="Hand" HorizontalAlignment="Right" />

                    <TextBlock Margin="0,0,0,4">
                        <Run Text="▸ " Foreground="#1FA45F" FontSize="13" />
                        <Run Text="Иерархия (группы)" Foreground="#1FA45F" FontSize="13" />
                    </TextBlock>

                    <TextBlock x:Name="SelectedContactHeader"
                               Text="Контактная информация"
                               Foreground="#1FA45F"
                               FontSize="13"
                               Margin="0,14,0,6"
                               Visibility="Collapsed" />
                    <Border x:Name="SelectedContactInfo"
                            Background="#FFF8C7"
                            BorderBrush="#F0E2A3"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="8,5"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="DetailPhoneText" Text="—" Foreground="#1B2440" FontSize="12" />
                                <TextBlock x:Name="DetailEmailText" Text="" Foreground="#5F6F95" FontSize="11.5" Margin="0,2,0,0" />
                                <TextBlock x:Name="DetailAddressText" Text="" Foreground="#5F6F95" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" FontFamily="Segoe Fluent Icons" Text="&#xE700;" FontSize="11" Foreground="#9AA4BC" VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer: count + pagination (1С) -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ContractorsCountText" Grid.Column="0" Text="Всего: 0" Foreground="#5F6F95" FontSize="12" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Width="26" Height="24" Margin="0,0,2,0" ToolTip="К началу">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE892;" FontSize="11" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Width="26" Height="24" Margin="0,0,2,0" ToolTip="Предыдущая">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70E;" FontSize="11" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Width="26" Height="24" Margin="0,0,2,0" ToolTip="Следующая">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" FontSize="11" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Width="26" Height="24" ToolTip="В конец">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE893;" FontSize="11" />
                </Button>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="свернуть" Foreground="#4F5BFF" FontSize="12" VerticalAlignment="Center" Cursor="Hand" />
        </Grid>
    </Grid>
</UserControl>
