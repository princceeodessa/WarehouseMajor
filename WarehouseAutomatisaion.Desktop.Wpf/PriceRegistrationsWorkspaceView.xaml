<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.PriceRegistrationsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F7F9FD">
    <UserControl.Resources>
        <Style x:Key="PriceGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="PriceHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F4F9" />
            <Setter Property="BorderBrush" Value="#D7DEEC" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Foreground" Value="#3A4868" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="PriceRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2FA" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="#17213A" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFF" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBE3FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PriceCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#17213A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,18,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE735;" Foreground="#4F5BFF" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="Установка цен" FontSize="22" FontWeight="SemiBold" Foreground="#17213A" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="1" Width="280" Height="32" Background="#FFFFFF" BorderBrush="#D7DEEC" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="12,0" FontSize="12.5" TextChanged="HandleSearchChanged" />
                    <TextBlock x:Name="SearchPlaceholderText" Grid.Column="0" Text="Search (Ctrl+F)" IsHitTestVisible="False" Foreground="#9AA4BC" VerticalAlignment="Center" Margin="14,0" />
                    <TextBlock Grid.Column="1" FontFamily="Segoe Fluent Icons" Text="&#xE721;" Foreground="#9AA4BC" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" />
                </Grid>
            </Border>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="{StaticResource OneCToolbarBg}"
                BorderBrush="{StaticResource OneCToolbarBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6,5"
                Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="Создать" Style="{StaticResource OneCPrimaryToolbarButtonStyle}" Margin="0,0,6,0" Click="HandleCreateClick" />
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,10,0" ToolTip="Быстрое добавление" Click="HandleCreateClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="12" />
                </Button>
                <Button x:Name="FilterToggleButton" Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,4,0" ToolTip="Фильтры" Click="HandleFilterPopupToggle">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71C;" FontSize="13" />
                </Button>
                <Popup x:Name="FilterPopup"
                       PlacementTarget="{Binding ElementName=FilterToggleButton}"
                       Placement="Bottom"
                       VerticalOffset="6"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Width="320" Background="#FFFFFF" BorderBrush="#D7DEEC" BorderThickness="1" CornerRadius="10" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#1B2440" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Фильтры" Foreground="#4F5BFF" FontSize="13" FontWeight="SemiBold" />
                                <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="22" Height="22" Padding="0" Click="HandleFilterPopupClose">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE894;" FontSize="11" Foreground="#9AA4BC" />
                                </Button>
                            </Grid>
                            <TextBlock Text="Вид цены" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                            <ComboBox x:Name="PriceTypeFilterCombo" Height="30" Margin="0,0,0,10" IsEditable="True" SelectionChanged="HandleFilterChanged" />
                            <TextBlock Text="Автор" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                            <ComboBox x:Name="AuthorFilterCombo" Height="30" Margin="0,0,0,10" IsEditable="True" SelectionChanged="HandleFilterChanged" />
                            <TextBlock Text="Период с" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,4" />
                            <DatePicker x:Name="DateFromPicker" Height="30" Margin="0,0,0,10" SelectedDateChanged="HandleFilterChanged" />
                            <TextBlock Text="Период по" Foreground="#7280A0" FontSize="11.5" Margin="0,0,0,14" />
                            <DatePicker x:Name="DateToPicker" Height="30" Margin="0,0,0,14" SelectedDateChanged="HandleFilterChanged" />
                            <Button Content="Сбросить фильтры" Style="{StaticResource OneCToolbarButtonStyle}" HorizontalAlignment="Stretch" Click="HandleResetFiltersClick" />
                        </StackPanel>
                    </Border>
                </Popup>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,10,0" ToolTip="Печать" Click="HandlePrintClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE749;" FontSize="13" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Margin="0,0,4,0" ToolTip="Структура подчинённости" Click="HandleStructureClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="13" Foreground="#4F5BFF" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" ToolTip="Дополнительные действия" Click="HandleMoreClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE712;" FontSize="13" />
                </Button>
            </WrapPanel>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E7ECF7" BorderThickness="1" CornerRadius="12" Padding="0">
            <DataGrid x:Name="PriceGrid"
                      Style="{StaticResource PriceGridStyle}"
                      ColumnHeaderStyle="{StaticResource PriceHeaderStyle}"
                      RowStyle="{StaticResource PriceRowStyle}"
                      CellStyle="{StaticResource PriceCellStyle}"
                      AlternationCount="2"
                      SelectionChanged="HandleSelectionChanged"
                      MouseDoubleClick="HandleGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="140" IsReadOnly="True" />
                    <DataGridTextColumn Header="Виды цен" Binding="{Binding PriceTypes}" Width="*" MinWidth="260" IsReadOnly="True" />
                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="260" IsReadOnly="True" />
                    <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="180" IsReadOnly="True" />
                    <DataGridTemplateColumn Width="36" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="HandleRowMenuClick" ToolTip="Действия">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE712;" FontSize="11" Foreground="#5F7DA8" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="RecordsCountText" Text="Всего: 0" Foreground="#5F6F95" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Border x:Name="SelectedSummary"
                        Background="#EEF2FF"
                        BorderBrush="#C8D1FF"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,4"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8AC;" FontSize="11" Foreground="#4F5BFF" VerticalAlignment="Center" />
                        <TextBlock x:Name="SelectedSummaryText" Foreground="#1B2440" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Width="28" Height="28" Margin="0,0,4,0" ToolTip="К началу">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE892;" FontSize="11" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Width="28" Height="28" Margin="0,0,4,0" ToolTip="Предыдущая">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76B;" FontSize="11" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Width="28" Height="28" Margin="0,0,4,0" ToolTip="Следующая">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76C;" FontSize="11" />
                </Button>
                <Button Style="{StaticResource OneCToolbarIconButtonStyle}" Width="28" Height="28" ToolTip="В конец">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE893;" FontSize="11" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
