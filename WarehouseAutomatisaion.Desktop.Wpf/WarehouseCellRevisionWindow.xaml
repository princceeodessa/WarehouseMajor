<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.WarehouseCellRevisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="920"
        Height="640"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource DialogCardStyle}">
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogFieldLabelStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}" />
        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeaderTitleText"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="HeaderSubtitleText"
                           Margin="0,7,0,0"
                           FontSize="13.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Добавить товар"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="0,0,10,0"
                        Click="HandleAddLineClick" />
                <Button Content="Обнулить строку"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="HandleClearLineClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource AccentControlBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ячейка" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="CellCodeText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Склад" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="WarehouseText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Документ" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="DocumentNumberText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid x:Name="LinesDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                          VerticalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0"
                          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                          RowHeight="44"
                          ColumnHeaderHeight="40"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeaderWidth="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="130" IsReadOnly="True" />
                        <DataGridTextColumn Header="Товар" Binding="{Binding Item}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Учет" Binding="{Binding CurrentDisplay}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="Факт" Binding="{Binding FactText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                        <DataGridTextColumn Header="Разница" Binding="{Binding DifferenceDisplay}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="220" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="ValidationText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource GhostButtonStyle}"
                        Width="120"
                        Margin="0,0,10,0"
                        Click="HandleCancelClick" />
                <Button Content="Провести ревизию"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="170"
                        Click="HandleSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
