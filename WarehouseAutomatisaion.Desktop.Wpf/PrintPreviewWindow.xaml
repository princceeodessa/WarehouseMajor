<ui:FluentWindow x:Class="WarehouseAutomatisaion.Desktop.Wpf.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="1180"
        Height="820"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Title="Предпросмотр печати"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="HeaderTitleText"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Проверьте документ перед отправкой на принтер."
                           Margin="0,6,0,0"
                           FontSize="13.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="18,1,0,0">
                <Button x:Name="PrintButton"
                        Content="Печать"
                        MinWidth="132"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Click="HandlePrintClick" />
                <Button Content="Закрыть"
                        MinWidth="116"
                        Margin="10,0,0,0"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Click="HandleCloseClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <FlowDocumentScrollViewer x:Name="PreviewReader"
                                      IsToolBarVisible="True"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MinZoom="80"
                                      MaxZoom="180"
                                      Zoom="120"
                                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="После нажатия «Печать» откроется стандартный выбор принтера."
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12.5" />

            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="#506080"
                       FontSize="12.5" />
        </Grid>
    </Grid>
</ui:FluentWindow>
