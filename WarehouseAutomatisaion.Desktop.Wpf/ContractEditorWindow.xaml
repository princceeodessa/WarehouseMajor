<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.ContractEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Договор"
        Width="1180"
        Height="780"
        MinWidth="960"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FC">
    <Window.Resources>
        <SolidColorBrush x:Key="LabelText" Color="#5C6A8A" />
        <SolidColorBrush x:Key="StrongText" Color="#17213A" />
        <SolidColorBrush x:Key="MutedText" Color="#7A86A5" />
        <SolidColorBrush x:Key="GreenSection" Color="#1FA45F" />
        <SolidColorBrush x:Key="LinkBlue" Color="#4F5BFF" />
        <SolidColorBrush x:Key="WarningRed" Color="#D92D20" />
        <SolidColorBrush x:Key="FieldBorder" Color="#C7D2E5" />

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource LabelText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource GreenSection}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource StrongText}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FormComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>

        <Style x:Key="FormDateStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="TabHeaderActiveStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="#17213A" />
            <Setter Property="Foreground" Value="#17213A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0,2,0,4" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="TabHeaderInactiveStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource LinkBlue}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0,2,0,4" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>

        <Style x:Key="TopActionPrimaryStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFD93B" />
            <Setter Property="BorderBrush" Value="#E8C016" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#17213A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="TopActionStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#17213A" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="TopIconStyle" TargetType="Button" BasedOn="{StaticResource TopActionStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: header (← → ⭐ title) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4EAF5" BorderThickness="0,0,0,1" Padding="16,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="28" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,2,0" ToolTip="Назад" IsEnabled="False">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72B;" FontSize="14" Foreground="#9CADD4" />
                </Button>
                <Button Width="28" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" ToolTip="Вперёд" IsEnabled="False">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72A;" FontSize="14" Foreground="#9CADD4" />
                </Button>
                <Button Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" ToolTip="В избранное">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE735;" FontSize="14" Foreground="#9CADD4" />
                </Button>
                <TextBlock x:Name="HeaderTitleText"
                           Text="Договор (Договор)"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource StrongText}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ROW 1: tabs -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E4EAF5" BorderThickness="0,0,0,1" Padding="16,0">
            <WrapPanel>
                <Button Content="Main" Style="{StaticResource TabHeaderActiveStyle}" />
                <Button Content="События" Style="{StaticResource TabHeaderInactiveStyle}" />
                <Button Content="Документы" Style="{StaticResource TabHeaderInactiveStyle}" />
                <Button Content="Отчёты" Style="{StaticResource TabHeaderInactiveStyle}" />
                <Button Content="Файлы" Style="{StaticResource TabHeaderInactiveStyle}" />
            </WrapPanel>
        </Border>

        <!-- ROW 2: toolbar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E4EAF5" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0">
                    <Button x:Name="SaveAndCloseButton" Content="Save and close" Style="{StaticResource TopActionPrimaryStyle}" Click="HandleSaveAndCloseClick" />
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource TopActionStyle}" Margin="0,0,10,0" Click="HandleSaveClick" />
                    <Button Style="{StaticResource TopIconStyle}" ToolTip="Скопировать">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource TopIconStyle}" ToolTip="Фильтр">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71C;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource TopIconStyle}" Margin="0,0,10,0" ToolTip="Печать">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE749;" FontSize="13" />
                    </Button>
                    <Button Content="Generate ▾" Style="{StaticResource TopActionStyle}" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="More actions ▾" Style="{StaticResource TopActionStyle}" Margin="0,0,4,0" />
                    <Button Style="{StaticResource TopIconStyle}" ToolTip="Справка" Margin="0,0,0,0">
                        <TextBlock Text="?" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 3: body — две колонки -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="20,16,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Левая колонка -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Основные" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Действует от:" Style="{StaticResource FieldLabelStyle}" />
                        <Grid Grid.Row="0" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="ValidFromPicker" Grid.Column="0" Style="{StaticResource FormDateStyle}" />
                            <TextBlock Grid.Column="1" Text="до:" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Center" />
                            <DatePicker x:Name="ValidToPicker" Grid.Column="2" Style="{StaticResource FormDateStyle}" />
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Контрагент:" Style="{StaticResource FieldLabelStyle}" />
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBox x:Name="CounterpartyTextBox" Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True" />
                            <TextBlock x:Name="CounterpartyKindText" Text="Покупатель" Margin="2,2,0,0" FontSize="11.5" Foreground="{StaticResource MutedText}" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Вид договора:" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ContractKindCombo" Style="{StaticResource FormComboStyle}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Рамочный договор:" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="6" Grid.Column="1" x:Name="FrameworkContractCombo" Style="{StaticResource FormComboStyle}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Категория:" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="8" Grid.Column="1" x:Name="CategoryCombo" Style="{StaticResource FormComboStyle}" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Статья:" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="10" Grid.Column="1" x:Name="ArticleCombo" Style="{StaticResource FormComboStyle}" />

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Док. реализации (УПД):" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="12" Grid.Column="1" x:Name="ImplementationDocCombo" Style="{StaticResource FormComboStyle}">
                            <ComboBoxItem Content="По умолчанию" IsSelected="True" />
                            <ComboBoxItem Content="УПД" />
                            <ComboBoxItem Content="Накладная + СФ" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="+ Свой реквизит" Foreground="{StaticResource LinkBlue}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Right" Cursor="Hand" />

                    <!-- Сворачиваемые секции -->
                    <Grid Margin="0,16,0,0">
                        <TextBlock>
                            <Run Text="› " Foreground="{StaticResource GreenSection}" FontSize="13" FontWeight="SemiBold" />
                            <Run Text="Взаиморасчеты: Разносить оплату Вручную, Зачитывать предоплату Вручную" Foreground="{StaticResource GreenSection}" FontSize="13" FontWeight="SemiBold" />
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <TextBlock>
                            <Run Text="› " Foreground="{StaticResource GreenSection}" FontSize="13" FontWeight="SemiBold" />
                            <Run Text="Ценообразование: Вид цен Оптовая" Foreground="{StaticResource GreenSection}" FontSize="13" FontWeight="SemiBold" />
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <!-- Правая колонка -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Представление" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="№ договора:" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ContractNumberTextBox" Style="{StaticResource FormTextBoxStyle}" Width="80" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DuplicateNumberWarningText" Text="" Foreground="{StaticResource WarningRed}" FontSize="11.5" TextDecorations="Underline" Margin="0,2,0,0" Cursor="Hand" Visibility="Collapsed" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Наименование:" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ContractNameCombo" Style="{StaticResource FormComboStyle}" IsEditable="True" />
                    </Grid>

                    <TextBlock Text="Данные организации" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Организация:" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="OrganizationCombo" Style="{StaticResource FormComboStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Банковский счет:" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="BankAccountCombo" Style="{StaticResource FormComboStyle}" />
                    </Grid>

                    <TextBlock Text="Дата отгрузки в заказе покупателя" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,4" />
                    <TextBlock FontSize="11.5">
                        <Run Text="Заполнение даты отгрузки в новых документах: " Foreground="{StaticResource MutedText}" />
                        <Run Text="&lt;Настройка не выполнена&gt;" Foreground="{StaticResource LinkBlue}" TextDecorations="Underline" />
                        <Run Text=" ?" Foreground="{StaticResource MutedText}" />
                    </TextBlock>

                    <TextBlock Text="Дата оплаты в счете и заказе покупателя" Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,4" />
                    <TextBlock FontSize="11.5">
                        <Run Text="Заполнение даты оплаты в новых документах: " Foreground="{StaticResource MutedText}" />
                        <Run Text="&lt;Настройка не выполнена&gt;" Foreground="{StaticResource LinkBlue}" TextDecorations="Underline" />
                        <Run Text=" ?" Foreground="{StaticResource MutedText}" />
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Договор подписан:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,8,0" />
                        <CheckBox x:Name="ContractSignedCheckBox" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Комментарий" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,8" />
                    <TextBox x:Name="CommentTextBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap" Padding="6,4" FontSize="12.5" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" Background="#FFFFFF" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ROW 4: footer ☐ Недействителен -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E4EAF5" BorderThickness="0,1,0,0" Padding="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="InvalidCheckBox" Content="Недействителен" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="?" Foreground="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
