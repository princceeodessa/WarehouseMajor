<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.ReceiptDraftReceiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Приёмка по черновику"
        Height="700" Width="1020"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FD"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#17213A" />
        <SolidColorBrush x:Key="MatchedBrush" Color="#28A745" />
        <SolidColorBrush x:Key="UnmatchedBrush" Color="#D9534F" />
    </Window.Resources>

    <DockPanel Margin="14" LastChildFill="True">

        <!-- Header card -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="10"
                Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🤖 Приёмка по AI-черновику"
                               Foreground="{StaticResource HeadingBrush}"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSummaryText"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="MatchedCountText"
                               Foreground="{StaticResource MatchedBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="UnmatchedCountText"
                               Foreground="{StaticResource UnmatchedBrush}"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cell picker -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="10"
                Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Принять в ячейку:"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,10,0" />
                <Border Grid.Column="1"
                        Height="34"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Background="#FAFBFD"
                        Padding="10,0">
                    <TextBlock x:Name="SelectedCellText"
                               Text="— не выбрана (рекомендуется приёмочная зона) —"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                </Border>
                <Button Grid.Column="2"
                        x:Name="PickCellButton"
                        Content="🔍 Выбрать ячейку"
                        Height="34" Padding="14,0" Margin="10,0,0,0"
                        Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Cursor="Hand"
                        Click="OnPickCellClicked" />
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="10"
                Padding="14,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0" />
                <Button x:Name="CancelButton" Grid.Column="1"
                        Content="Отмена" Height="34" Padding="18,0"
                        Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Cursor="Hand" IsCancel="True"
                        Click="OnCancelClicked" />
                <Button x:Name="ReceiveAllButton" Grid.Column="2"
                        Content="✓ Принять накладную"
                        Height="34" Padding="20,0" Margin="10,0,0,0"
                        Background="{StaticResource PrimaryBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold" IsDefault="True" IsEnabled="False"
                        Click="OnReceiveAllClicked" />
            </Grid>
        </Border>

        <!-- Lines grid -->
        <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="LinesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource LineBrush}"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeight="28" ColumnHeaderHeight="32"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      FontSize="12.5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№"
                                        Binding="{Binding LineNumber}"
                                        Width="40" />
                    <DataGridTextColumn Header="Распознанный товар"
                                        Binding="{Binding OriginalItemName}"
                                        Width="*" />
                    <DataGridTextColumn Header="Кол-во"
                                        Binding="{Binding Quantity, StringFormat=N3}"
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ед."
                                        Binding="{Binding Unit}"
                                        Width="60" />
                    <DataGridTextColumn Header="Цена"
                                        Binding="{Binding UnitPrice, StringFormat=N2}"
                                        Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Сумма"
                                        Binding="{Binding Total, StringFormat=N2}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Padding" Value="0,0,8,0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding MatchStatus}"
                                        Width="180">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource MatchedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMatched}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource UnmatchedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </DockPanel>
</Window>
