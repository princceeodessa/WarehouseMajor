<UserControl x:Class="WarehouseAutomatisaion.Desktop.Wpf.PurchasingWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F7F9FD">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#F7F9FD" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E7ECF7" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F5BFF" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EEF2FF" />
        <SolidColorBrush x:Key="TextBrush" Color="#17213A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7A86A5" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#98A3BC" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource TopActionButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DDE5F4" />
            <Setter Property="Foreground" Value="#34415F" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TopPrimaryActionButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#F4B7BE" />
            <Setter Property="Foreground" Value="#E14B5A" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF5F6" />
                    <Setter Property="BorderBrush" Value="#EE8E99" />
                    <Setter Property="Foreground" Value="#C83445" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFE9EC" />
                    <Setter Property="BorderBrush" Value="#DF6F7D" />
                    <Setter Property="Foreground" Value="#B52838" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MiniButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="MiniPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SectionTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="#6E7B98" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0,0,0,12" />
            <Setter Property="Margin" Value="0,0,30,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#4F5BFF" />
                    <Setter Property="BorderBrush" Value="#C8D1FF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#A9B3C7" />
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Opacity" Value="0.64" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox" BasedOn="{StaticResource TableFilterComboBoxStyle}">
            <Setter Property="MinWidth" Value="112" />
        </Style>

        <Style x:Key="ToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#4D5A78" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="34" Height="20" CornerRadius="10" Background="#D8DEEC" Margin="0,0,8,0">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,3,0,3" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4F5BFF" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,3,3,3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurchasingGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2FA" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEF2FA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <!-- Release 1.0.113: уплотнены строки и шапка под 1С УНФ. Раньше: 54/42 px
                 (просторно, как в SaaS-таблицах). 1С даёт ~24/26 px — переходим к 28/30,
                 чтобы помещалось столько же строк на экран. -->
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="IsReadOnly" Value="False" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2FA" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="#7B86A0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0,10,0" />
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <!-- 1С УНФ-layout, синяя палитра: белая строка, светлая зебра-альтернация,
                 насыщенный синий для selected, как в Products-вкладке. -->
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2F8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="#1B2440" />
            <Setter Property="FontSize" Value="12.5" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F7F9FD" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FA" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDE4FF" />
                    <Setter Property="BorderBrush" Value="#4F5BFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter Property="Opacity" Value="0.48" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource PageBrush}">
        <Grid Margin="28,24,28,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Style="{StaticResource TopHeaderGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Release 1.0.112: 1С УНФ не показывает крупный заголовок раздела
                     внутри окна — оставляем только компактное «Закупки» без подзаголовка. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HeaderFavoriteButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            ToolTip="Добавить раздел в избранное">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                                   Text="&#xE735;"
                                   FontSize="16"
                                   Foreground="#FFB400" />
                    </Button>
                    <TextBlock Text="Закупки"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#17213A"
                               VerticalAlignment="Center" />
                </StackPanel>

            </Grid>

            <Border x:Name="LockBannerBorder" Grid.Row="1" Style="{StaticResource CardStyle}" BorderBrush="#AFC2FF" Background="#F7FAFF" Padding="16,12" Margin="0,0,0,18" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE946;" FontSize="16" Foreground="#4F5BFF" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Редактирование временно недоступно" FontSize="13.5" FontWeight="SemiBold" Foreground="#3151DB" />
                            <TextBlock x:Name="LockBannerText" Text="Недостаточно прав или документ заблокирован." FontSize="12.5" Foreground="#6B7DAE" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Width="28" Height="28" Background="Transparent" BorderBrush="Transparent" Foreground="#5A6FA8" FontFamily="Segoe Fluent Icons" Content="&#xE711;" AutomationProperties.Name="Закрыть уведомление" Click="HandleDismissLockBannerClick" />
                </Grid>
            </Border>

            <Grid x:Name="WorkspaceLayoutGrid" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="344" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="WorkspaceLeftPanel" Grid.Row="0" Grid.Column="0" Margin="0,0,24,0">
                                        <!-- Release 1.0.112: KPI-блок (Активные поставщики / Открытые заказы / Ожидают счёт /
                                             Ожидают приёмку / Просроченные) скрыт — в 1С УНФ его нет, наш макет должен быть 1в1. -->
                                        <UniformGrid x:Name="MetricsGrid" Columns="5" Margin="-6,0,-6,18" Visibility="Collapsed">
                        <Border Style="{StaticResource MetricCardStyle}" Margin="6,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Активные&#x0a;поставщики" Style="{StaticResource MetricCaptionStyle}" />
                                <TextBlock x:Name="ActiveSuppliersMetricText" Grid.Row="1" VerticalAlignment="Bottom" Foreground="#26A85B" Style="{StaticResource MetricValueStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}" Margin="6,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Открытые&#x0a;заказы" Style="{StaticResource MetricCaptionStyle}" />
                                <TextBlock x:Name="OpenOrdersMetricText" Grid.Row="1" VerticalAlignment="Bottom" Foreground="#4F5BFF" Style="{StaticResource MetricValueStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}" Margin="6,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Ожидают&#x0a;счет" Style="{StaticResource MetricCaptionStyle}" />
                                <TextBlock x:Name="PendingInvoiceMetricText" Grid.Row="1" VerticalAlignment="Bottom" Foreground="#FF9F1A" Style="{StaticResource MetricValueStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}" Margin="6,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Ожидают&#x0a;приемку" Style="{StaticResource MetricCaptionStyle}" />
                                <TextBlock x:Name="PendingReceiptMetricText" Grid.Row="1" VerticalAlignment="Bottom" Foreground="#FF9F1A" Style="{StaticResource MetricValueStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}" Margin="6,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Просроченные&#x0a;поставки" Style="{StaticResource MetricCaptionStyle}" />
                                <TextBlock x:Name="OverdueMetricText" Grid.Row="1" VerticalAlignment="Bottom" Foreground="#FF5B5B" Style="{StaticResource MetricValueStyle}" />
                            </Grid>
                        </Border>
                    </UniformGrid>

                                        <!-- Release 1.0.112: chips «Без счёта / Без приёмки / Просрочено / Частично оплачено /
                                             Есть расхождения» убраны — в 1С УНФ их нет, фильтрация делается через колонки таблицы. -->
                                        <UniformGrid x:Name="IssueChipsGrid" Columns="5" Margin="-6,0,-6,18" Visibility="Collapsed">
                        <Button x:Name="MissingInvoiceChip" AutomationProperties.Name="Фильтр: без счета" Style="{StaticResource GhostButtonStyle}" Height="40" Margin="6,0,6,0" Click="HandleIssuePresetClick" Tag="missing-invoice">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Без счета" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="MissingInvoiceChipText" Grid.Column="1" Margin="14,0,0,0" FontWeight="SemiBold" />
                            </Grid>
                        </Button>
                        <Button x:Name="MissingReceiptChip" AutomationProperties.Name="Фильтр: без приемки" Style="{StaticResource GhostButtonStyle}" Height="40" Margin="6,0,6,0" Click="HandleIssuePresetClick" Tag="missing-receipt">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Без приемки" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MissingReceiptChipText" Grid.Column="1" Margin="14,0,0,0" FontWeight="SemiBold" />
                            </Grid>
                        </Button>
                        <Button x:Name="OverdueChip" AutomationProperties.Name="Фильтр: просрочено" Style="{StaticResource GhostButtonStyle}" Height="40" Margin="6,0,6,0" Click="HandleIssuePresetClick" Tag="overdue">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Просрочено" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OverdueChipText" Grid.Column="1" Margin="14,0,0,0" FontWeight="SemiBold" />
                            </Grid>
                        </Button>
                        <Button x:Name="UnpaidChip" AutomationProperties.Name="Фильтр: частично оплачено" Style="{StaticResource GhostButtonStyle}" Height="40" Margin="6,0,6,0" Click="HandleIssuePresetClick" Tag="unpaid">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Частично оплачено" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="UnpaidChipText" Grid.Column="1" Margin="14,0,0,0" FontWeight="SemiBold" />
                            </Grid>
                        </Button>
                        <Button x:Name="DiscrepancyChip" AutomationProperties.Name="Фильтр: есть расхождения" Style="{StaticResource GhostButtonStyle}" Height="40" Margin="6,0,6,0" Click="HandleIssuePresetClick" Tag="discrepancy">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Есть расхождения" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DiscrepancyChipText" Grid.Column="1" Margin="14,0,0,0" FontWeight="SemiBold" />
                            </Grid>
                        </Button>
                    </UniformGrid>

                    <!-- 1С УНФ sub-tabs внутри секции Заказы.
                         Левая вкладка — текущие заказы поставщикам, правая — заказы покупателей,
                         которые ещё надо оформить как заказ поставщику (с жёлтой Primary-кнопкой). -->
                    <DockPanel x:Name="OrderSubTabsPanel" Margin="0,0,0,10" Visibility="Collapsed">
                        <Button x:Name="OrderCustomerRequestPrimaryButton"
                                DockPanel.Dock="Right"
                                Background="#FFC107"
                                Foreground="#1B2440"
                                BorderBrush="#E0A900"
                                BorderThickness="1"
                                Padding="14,6"
                                Height="32"
                                FontWeight="SemiBold"
                                FontSize="12.5"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                Click="HandleConvertCustomerOrderClick">
                            Оформить заказ поставщику
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OrderSupplierSubTabButton"
                                    Content="Заказы поставщикам"
                                    Style="{StaticResource SectionTabStyle}"
                                    Click="HandleOrdersSubTabClick"
                                    Tag="supplier-orders" />
                            <Button x:Name="OrderCustomerRequestSubTabButton"
                                    Content="Заказы покупателей"
                                    Style="{StaticResource SectionTabStyle}"
                                    Click="HandleOrdersSubTabClick"
                                    Tag="customer-requests"
                                    Margin="18,0,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="BulkBarBorder" Style="{StaticResource TableBulkBarStyle}" Margin="0,0,0,14" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource TableBulkCloseButtonStyle}" FontFamily="Segoe Fluent Icons" Content="&#xE711;" AutomationProperties.Name="Очистить выбор" Click="HandleClearSelectionClick" />
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock x:Name="BulkSelectionText" Margin="0,0,12,0" Style="{StaticResource TableBulkTextStyle}" />
                                <Button Style="{StaticResource TableBulkActionButtonStyle}" Margin="0,0,10,0" Click="HandleExportSelectedClick">Экспорт выбранных</Button>
                                <Button x:Name="BulkStatusButton" Style="{StaticResource TableBulkActionButtonStyle}" Margin="0,0,10,0" Click="HandleBulkStatusClick">Изменить статус</Button>
                                <Button x:Name="BulkWarehouseButton" Style="{StaticResource TableBulkActionButtonStyle}" Margin="0,0,10,0" Click="HandleBulkWarehouseClick">Назначить склад</Button>
                                <Button x:Name="BulkPrintButton" Style="{StaticResource TableBulkActionButtonStyle}" Margin="0,0,10,0" Click="HandleBulkPrintClick">Печать</Button>
                                <Button x:Name="BulkArchiveButton" Style="{StaticResource TableBulkActionButtonStyle}" Click="HandleBulkArchiveClick">Архивировать</Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" MinHeight="520">
                                <DataGrid x:Name="PurchasingGrid"
                                          Style="{StaticResource PurchasingGridStyle}"
                                          AlternationCount="2"
                                          SelectionChanged="HandleGridSelectionChanged"
                                          MouseDoubleClick="HandleGridDoubleClick"
                                          CellEditEnding="HandleGridCellEditEnding"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.RowStyle>
                                        <StaticResource ResourceKey="GridRowStyle" />
                                    </DataGrid.RowStyle>
                                    <DataGrid.CellStyle>
                                        <StaticResource ResourceKey="GridCellStyle" />
                                    </DataGrid.CellStyle>
                                    <DataGrid.ColumnHeaderStyle>
                                        <StaticResource ResourceKey="GridHeaderStyle" />
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <!-- Release 1.0.113: чекбокс множественного выбора скрыт — в 1С УНФ его нет
                                             (выделение строк делается обычным кликом + Shift/Ctrl). Колонка оставлена в
                                             разметке на случай bulk-операций в будущем, но Width=0 убирает её визуально. -->
                                        <DataGridCheckBoxColumn x:Name="SelectionColumn" Binding="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="0" />
                                        <!-- 1С УНФ-style: 2 индикатора-кружка статуса. Левый = доставка/проведение,
                                             правый = оплата. Цвет берётся из StatusDot1Color / StatusDot2Color на строке. -->
                                        <DataGridTemplateColumn x:Name="StatusDotColumn1" Width="32" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Stroke="{Binding StatusDot1Color}" StrokeThickness="2"
                                                             Fill="{Binding StatusDot1Fill}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn x:Name="StatusDotColumn2" Width="32" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Stroke="{Binding StatusDot2Color}" StrokeThickness="2"
