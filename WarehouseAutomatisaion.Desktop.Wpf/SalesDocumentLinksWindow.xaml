<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.SalesDocumentLinksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Связанные документы"
        Width="1100"
        Height="640"
        MinWidth="900"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F7F9FD">
    <Window.Resources>
        <!-- 1С-style stripped: палитра + flat-стили. -->
        <SolidColorBrush x:Key="OneCSectionGreen" Color="#3E8B33" />
        <SolidColorBrush x:Key="OneCLinkBlue" Color="#1C5C9A" />
        <SolidColorBrush x:Key="OneCFieldLabelMuted" Color="#5A6680" />
        <SolidColorBrush x:Key="OneCInputBorderLocal" Color="#C9D5E6" />

        <Style x:Key="OneCSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource OneCSectionGreen}" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>

        <Style x:Key="OneCFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource OneCFieldLabelMuted}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="OneCFieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#17213A" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="OneCFieldLinkValueStyle" TargetType="TextBlock" BasedOn="{StaticResource OneCFieldValueStyle}">
            <Setter Property="Foreground" Value="{StaticResource OneCLinkBlue}" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="OneCLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource OneCLinkBlue}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextDecorations="Underline" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OneCHeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#7280A0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                    <Setter Property="Foreground" Value="#4F5BFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Тулбар: ← → Открыть + иконки + Поиск + More act… ===== -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E1E8F4"
                BorderThickness="0,0,0,1"
                Padding="12,8,12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource OneCHeaderIconButtonStyle}" Content="&#xE76B;" ToolTip="Назад" />
                    <Button Style="{StaticResource OneCHeaderIconButtonStyle}" Content="&#xE76C;" ToolTip="Вперёд" Margin="2,0,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Открыть"
                        Style="{StaticResource OneCToolbarButtonStyle}"
                        Margin="6,0,12,0"
                        Click="HandleOpenClick"
                        ToolTip="Открыть выбранный документ" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OneCHeaderIconButtonStyle}" Content="&#xE752;" ToolTip="Развернуть всё" Margin="0,0,2,0" />
                    <Button Style="{StaticResource OneCHeaderIconButtonStyle}" Content="&#xE753;" ToolTip="Свернуть всё" Margin="0,0,8,0" />
                    <Button Style="{StaticResource OneCHeaderIconButtonStyle}" Content="&#xE72C;" ToolTip="Обновить" Margin="0,0,8,0" />

                    <TextBlock Text="Связанные документы"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#17213A"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0" />
                </StackPanel>

                <!-- Поле поиска -->
                <Border Grid.Column="3"
                        Width="270"
                        Height="26"
                        Background="#FFFFFF"
                        BorderBrush="#D7DEEC"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="10,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="22" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" FontSize="12.5" />
                        <TextBlock Grid.Column="0" x:Name="SearchPlaceholder" Text="Поиск..." IsHitTestVisible="False" Foreground="#9AA4BC" VerticalAlignment="Center" Margin="12,0" FontSize="12.5" />
                        <Button Grid.Column="1" Style="{StaticResource OneCHeaderIconButtonStyle}" Content="&#xE894;" ToolTip="Очистить" />
                        <Button Grid.Column="2" Style="{StaticResource OneCHeaderIconButtonStyle}" Content="&#xE721;" />
                    </Grid>
                </Border>

                <Button Grid.Column="4" Content="More act..." Style="{StaticResource OneCToolbarButtonStyle}" />
            </Grid>
        </Border>

        <!-- ===== Основной контент: слева таблица, справа сайдбар ===== -->
        <Grid Grid.Row="1" Margin="14,12,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Левая таблица «Документ / Сумма / Контрагент / Организация» -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource OneCInputBorderLocal}" BorderThickness="1" CornerRadius="6">
                <DataGrid x:Name="DocumentsGrid"
                          Style="{x:Null}"
                          Background="#FFFFFF"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="26"
                          ColumnHeaderHeight="28"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          AlternationCount="2"
                          FontSize="12.5"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MouseDoubleClick="HandleDocumentsGridDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F0F4F9" />
                            <Setter Property="BorderBrush" Value="#D7DEEC" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="Foreground" Value="#3A4868" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#FFFFFF" />
                            <Setter Property="BorderBrush" Value="#EEF2FA" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Foreground" Value="#17213A" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EEF2FF" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFFCD5" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#17213A" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="24" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" FontSize="11" Foreground="#7280A0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Документ" Width="2.0*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                        <TextBlock Text=" от " Margin="2,0,0,0" Foreground="#7280A0" />
                                        <TextBlock Text="{Binding DateText}" Foreground="#7280A0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding AmountText}" Width="1.0*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Контрагент" Binding="{Binding CustomerName}" Width="2.0*" />
                        <DataGridTextColumn Header="Организация" Binding="{Binding Organization}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Правый сайдбар: Контрагент-фильтр + Контактная информация + Текущая аналитика -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Фильтр Контрагент сверху -->
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource OneCInputBorderLocal}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,0,12">
                        <TextBlock x:Name="CustomerFilterText" Text="Контрагент" Foreground="#9AA4BC" FontSize="12.5" />
                    </Border>

                    <!-- Контактная информация -->
                    <TextBlock Text="Контактная информация" Style="{StaticResource OneCSectionHeaderStyle}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Телефон:" Style="{StaticResource OneCFieldLabelStyle}" />
                        <TextBlock x:Name="ContactPhoneText" Grid.Row="0" Grid.Column="1" Style="{StaticResource OneCFieldLinkValueStyle}" Text="—" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Юр. адрес:" Style="{StaticResource OneCFieldLabelStyle}" />
                        <TextBlock x:Name="ContactLegalAddressText" Grid.Row="1" Grid.Column="1" Style="{StaticResource OneCFieldValueStyle}" Text="—" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Факт. адрес:" Style="{StaticResource OneCFieldLabelStyle}" />
                        <TextBlock x:Name="ContactActualAddressText" Grid.Row="2" Grid.Column="1" Style="{StaticResource OneCFieldValueStyle}" Text="—" />

                        <TextBlock x:Name="ContactExtraAddressText" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource OneCFieldValueStyle}" FontWeight="SemiBold" />
                    </Grid>

                    <!-- Текущая аналитика -->
                    <TextBlock Text="Текущая аналитика" Style="{StaticResource OneCSectionHeaderStyle}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Автор:" Style="{StaticResource OneCFieldLabelStyle}" />
                        <TextBlock x:Name="AnalyticsAuthorText" Grid.Row="0" Grid.Column="1" Style="{StaticResource OneCFieldLinkValueStyle}" Text="—" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ответственный:" Style="{StaticResource OneCFieldLabelStyle}" />
                        <TextBlock x:Name="AnalyticsResponsibleText" Grid.Row="1" Grid.Column="1" Style="{StaticResource OneCFieldLinkValueStyle}" Text="—" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Состояние:" Style="{StaticResource OneCFieldLabelStyle}" />
                        <TextBlock x:Name="AnalyticsStatusText" Grid.Row="2" Grid.Column="1" Style="{StaticResource OneCFieldValueStyle}" Text="—" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Операция:" Style="{StaticResource OneCFieldLabelStyle}" />
                        <TextBlock x:Name="AnalyticsOperationText" Grid.Row="3" Grid.Column="1" Style="{StaticResource OneCFieldValueStyle}" Text="—" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Комментарий:" Style="{StaticResource OneCFieldLabelStyle}" />
                        <TextBlock x:Name="AnalyticsCommentText" Grid.Row="4" Grid.Column="1" Style="{StaticResource OneCFieldValueStyle}" Text="&lt;не заполнено&gt;" Foreground="#9AA4BC" />
                    </Grid>

                    <Button Content="свернуть" Style="{StaticResource OneCLinkButtonStyle}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="HandleCloseClick" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Скрытые элементы — для совместимости с code-behind ===== -->
        <Grid Visibility="Collapsed">
            <TextBlock x:Name="HeaderTitleText" />
            <TextBlock x:Name="HeaderSubtitleText" />
            <TextBlock x:Name="OrderSummaryValueText" />
            <TextBlock x:Name="OrderSummaryHintText" />
            <TextBlock x:Name="CustomerSummaryValueText" />
            <TextBlock x:Name="CustomerSummaryHintText" />
            <TextBlock x:Name="DocumentSummaryValueText" />
            <TextBlock x:Name="DocumentSummaryHintText" />
            <TextBlock x:Name="CashSummaryValueText" />
            <TextBlock x:Name="CashSummaryHintText" />
            <TextBlock x:Name="EmptyLogText" />
            <DataGrid x:Name="OperationLogGrid" />
        </Grid>
    </Grid>
</Window>
