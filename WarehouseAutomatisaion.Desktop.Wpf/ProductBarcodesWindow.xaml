<Window x:Class="WarehouseAutomatisaion.Desktop.Wpf.ProductBarcodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Штрихкоды"
        Width="780"
        Height="560"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FC">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBorder" Color="#E1E8F4" />
        <SolidColorBrush x:Key="MutedText" Color="#6E7B98" />
        <SolidColorBrush x:Key="PrimaryText" Color="#17213A" />

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F4F9" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Foreground" Value="#3A4868" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2FA" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBE3FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,14,20,12">
            <StackPanel>
                <TextBlock Text="Штрихкоды товара" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                <TextBlock x:Name="HeaderSubtitleText" FontSize="12.5" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,8,20,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddButton"
                        Content="Добавить"
                        Style="{StaticResource OneCToolbarButtonStyle}"
                        Margin="0,0,6,0"
                        IsEnabled="False"
                        ToolTip="Ручное добавление штрихкода (появится в следующих релизах). Сейчас источник — выгрузка из 1С УНФ." />
                <Button x:Name="RemoveButton"
                        Content="Удалить"
                        Style="{StaticResource OneCToolbarButtonStyle}"
                        Margin="0,0,12,0"
                        IsEnabled="False"
                        ToolTip="Удаление штрихкода (появится в следующих релизах)." />
                <Button x:Name="RefreshButton"
                        Style="{StaticResource OneCToolbarIconButtonStyle}"
                        ToolTip="Обновить"
                        Click="HandleRefreshClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="#FFFFFF" Margin="20,12,20,12" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <DataGrid x:Name="BarcodesGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeight="30"
                          ColumnHeaderHeight="30"
                          FontSize="12.5"
                          BorderThickness="0"
                          Background="#FFFFFF"
                          ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                          RowStyle="{StaticResource GridRowStyle}"
                          CellStyle="{StaticResource GridCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding LineNo}" Width="40" />
                        <DataGridTextColumn Header="Штрихкод" Binding="{Binding BarcodeValue}" Width="2.0*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontSize" Value="13" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Тип" Binding="{Binding BarcodeKind}" Width="1.0*" />
                        <DataGridTextColumn Header="Источник" Binding="{Binding BarcodeSource}" Width="1.0*" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyStateText"
                           Text="У этого товара пока нет штрихкодов. Запустите ETL-скрипт scripts/Import-UnfBarcodesToMySql.ps1, чтобы подтянуть данные из 1С УНФ."
                           Visibility="Collapsed"
                           Foreground="{StaticResource MutedText}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="460"
                           TextAlignment="Center" />
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" FontSize="12.5" />
            <Button Grid.Column="1" Content="Закрыть" Style="{StaticResource OneCToolbarButtonStyle}" Width="100" Click="HandleCloseClick" />
        </Grid>
    </Grid>
</Window>
